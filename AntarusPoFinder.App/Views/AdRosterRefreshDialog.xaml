<Window x:Class="AntarusPoFinder.App.Views.AdRosterRefreshDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Обновить из домена" Width="420" SizeToContent="Height"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Программа перечислит состав AD-групп, настроенных на вкладке «Подключение», заведёт в списке тех, кого там ещё нет, и приведёт роли к тому, что реально в домене. Никто не удаляется: кого в группах не окажется, останется с прежней ролью и с пометкой, что в домене его не нашли."/>

        <TextBlock Text="Домен" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
        <TextBox x:Name="DomainInput" Height="34" Margin="0,0,0,4"/>
        <!-- Домен спрашивать у человека нельзя: он его не знает (жалоба Ильи дословно). Поэтому
             поле уже заполнено, а под ним написано, в каком домене этот компьютер и откуда это
             известно. Машина вне домена получает слова, а не пустое поле. -->
        <TextBlock x:Name="DetectedDomainText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <Button x:Name="UseDetectedButton" Content="Подставить найденный" HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" Click="UseDetected_Click"
                ToolTip="Вписать в поле домен, определённый по этому компьютеру"/>

        <CheckBox x:Name="UseCurrentSessionCheck" IsChecked="True" Margin="0,0,0,10"
                  Content="Под учётной записью текущего сеанса Windows"
                  ToolTip="Обычный случай. Снимите, если за этим компьютером сидят под общей или локальной учётной записью — тогда понадобится доменный логин и пароль."
                  Checked="UseCurrentSession_Changed" Unchecked="UseCurrentSession_Changed"/>

        <StackPanel x:Name="CredentialsPanel" Visibility="Collapsed">
            <TextBlock Text="Доменный логин" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginInput" Height="34" Margin="0,0,0,10"/>
            <TextBlock Text="Пароль" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput" Margin="0,0,0,10"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource MutedText}" Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Обновить" Width="110" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
