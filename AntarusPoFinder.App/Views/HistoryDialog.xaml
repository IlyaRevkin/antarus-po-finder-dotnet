<Window x:Class="AntarusPoFinder.App.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AntarusPoFinder.App.Views"
        Icon="/Assets/icon.ico"
        Title="История версий" Width="720" Height="520" MinWidth="600" MinHeight="400"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Ровное выравнивание ячеек: у DataGridTextColumn по умолчанию текст жмётся вверх-влево
             без отступа, отчего колонка «Дата» выглядела «не ровно» относительно «Версии»
             (у неё свой Margin="6,0"). Один общий стиль на все текстовые колонки. -->
        <Style x:Key="HistoryCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GridSplitter Grid.Row="0" Height="0"/>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" x:Name="VersionsGrid" AutoGenerateColumns="False"
                      SelectionChanged="VersionsGrid_SelectionChanged" MouseDoubleClick="VersionsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Версия" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="140"
                                        ElementStyle="{StaticResource HistoryCell}"/>
                    <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="150"
                                        ElementStyle="{StaticResource HistoryCell}"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="*"
                                        ElementStyle="{StaticResource HistoryCell}"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRolledBack}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource RolledBackBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                <!-- Путь отдельной кликабельной строкой (открывает папку) — описание уже целиком
                     в поле выше, поэтому одноимённого столбца в таблице больше нет. -->
                <TextBlock Grid.Row="1" x:Name="PathPanel" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed">
                    <Run Text="Путь: "/><Hyperlink x:Name="PathLink" Click="PathLink_Click"><Run x:Name="PathRun"/></Hyperlink>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Слева — работа с локальной копией выбранной версии (#12): «Скачать на этот ПК» тянет её
             с сетевого диска в локальный кэш, чтобы потом загрузить в ПЛК; «Закрепить локально»
             ставит метку .keep, и тогда версия останется на этом компьютере даже после того, как на
             сетевом диске её сделают неактуальной или удалят (не закреплённую разовую копию уберёт
             ближайшая авто-синхронизация). Справа — «Закрыть». -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="LocalStatus" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <Button x:Name="DownloadBtn" Content="Скачать на этот ПК" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Download_Click"/>
                <Button x:Name="PinBtn" Content="Закрепить локально" Style="{StaticResource SecondaryButton}"
                        Click="Pin_Click"/>
            </StackPanel>
            <Button Content="Закрыть" IsCancel="True" Width="100" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
