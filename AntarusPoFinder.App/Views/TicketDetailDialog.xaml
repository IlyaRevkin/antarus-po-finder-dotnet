<Window x:Class="AntarusPoFinder.App.Views.TicketDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Тикет" Width="620" Height="680" MinWidth="420" MinHeight="360"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <!-- Длинный тикет читался плохо не из-за самого скролла, а из-за раскладки: окно было ниже, а
         строка вложений занимала фиксированные 130 пикселей ДАЖЕ когда вложений нет — на текст
         оставалась узкая полоска. Теперь блок вложений целиком в Auto-строке и при их отсутствии
         сжимается в одну подпись, а весь свободный ход отдан тексту. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- Переписка тянется наравне с текстом тикета: у длинного обсуждения своя прокрутка,
                 а у короткого места ровно столько, сколько нужно. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="MetaText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Full text, wrapped and scrollable — the grid row itself only shows a trimmed single
             line (see TicketsView.xaml), this is where the whole thing is actually readable. -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <!-- TextBox вместо TextBlock: текст тикета теперь можно выделить и скопировать (раньше
                 приходилось переписывать руками), а колесо/PageUp/PageDown/Ctrl+End работают без
                 предварительного клика — у TextBox есть свой ScrollViewer и он принимает фокус.
                 IsReadOnly + прозрачный фон, чтобы это по-прежнему читалось как текст, а не поле
                 ввода. Focus ставится в конструкторе окна — см. TicketDetailDialog.xaml.cs. -->
            <TextBox x:Name="BodyText" TextWrapping="Wrap" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     BorderThickness="0" Padding="0" Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     SpellCheck.IsEnabled="False"/>
        </Border>

        <!-- Переписка по тикету. Раньше обсуждать его было негде: правка текста самого тикета
             затирала написанное раньше, и договаривались словами мимо программы. Реплики только
             добавляются — это переписка, а не документ, и переписывать чужое в ней нельзя. -->
        <TextBlock Grid.Row="2" Text="ОБСУЖДЕНИЕ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <Grid>
                <TextBlock x:Name="NoCommentsText" Text="Пока ничего не написано" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ItemsControl x:Name="CommentsList" Visibility="Collapsed">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Head}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Ctrl+Enter отправляет: реплика обычно в одну-две строки, и тянуться мышью к кнопке
                 ради каждой — лишнее движение. Просто Enter оставлен переносом строки, иначе
                 многострочную реплику не написать. -->
            <TextBox Grid.Column="0" x:Name="NewCommentInput" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="52" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0"
                     PreviewKeyDown="NewCommentInput_PreviewKeyDown"/>
            <Button Grid.Column="1" x:Name="AddCommentBtn" Content="Написать" VerticalAlignment="Bottom"
                    Width="110" Click="AddComment_Click"
                    ToolTip="Добавить реплику к тикету (Ctrl+Enter). Она уедет остальным вместе с тикетом."/>
        </Grid>

        <TextBlock Grid.Row="5" Text="ВЛОЖЕНИЯ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Grid.Row="6" Margin="0,0,0,12">
            <TextBlock x:Name="NoAttachmentsText" Text="Нет вложений" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <!-- MaxHeight, а не фиксированная высота: пара вложений занимает две строки, длинный
                 список упирается в потолок и дальше прокручивается сам. -->
            <ListBox x:Name="AttachmentsList" MaxHeight="130" Visibility="Collapsed" MouseDoubleClick="AttachmentsList_MouseDoubleClick"/>
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Открыть файл" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenAttachment_Click"/>
            <Button Content="Открыть папку вложений" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenAttachmentsFolder_Click"/>
            <Button Content="Закрыть" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
