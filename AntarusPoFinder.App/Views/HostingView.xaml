<UserControl x:Class="AntarusPoFinder.App.Views.HostingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Разделы страницы сделаны так же, как вкладки «Настроек»: заголовок страницы, полоса кнопок
         NavButton с Tag="Active" и переключение видимости из кода. Стандартный WPF TabControl,
         стоявший здесь раньше, единственный на всё приложение рисовался системной темой Windows —
         светло-серые ярлычки с рамкой, ни одного цвета из палитры: в тёмной теме это была белёсая
         полоса поверх тёмного фона, а в светлой — чужой по виду блок, не похожий на остальные
         страницы. Своего стиля TabControl в Themes нет и заводить его ради одной страницы незачем,
         раз в приложении уже есть принятый вид вкладок. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Хранилище" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Инструкции дублируются на хостинг, чтобы наклейка с QR открывалась с телефона вне офиса. Здесь видно, что туда уже уехало, что нет и почему."/>

        <!-- Content — отдельным TextBlock со стилем NavButtonContentText, а не строкой в Content:
             см. комментарий к этому стилю в Themes/Styles.xaml (иначе текст активной вкладки в
             светлой теме остаётся тёмным на синем). -->
        <StackPanel Grid.Row="2" x:Name="TabBar" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="TabBtnState" Style="{StaticResource NavButton}" Tag="Active" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Состояние" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <!-- «Реквизиты» переехали сюда со страницы «Сетевые диски» по просьбе Ильи: адрес
                 хранилища и ключи к нему — это и есть хранилище, а на «Сетевых дисках» они лежали
                 рядом с путями к сетевым папкам, к которым отношения не имеют. Теперь настройка и её
                 последствия (что выложено, что нет, почему) видны на одной странице. -->
            <Button x:Name="TabBtnAccess" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Реквизиты" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnLog" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Журнал" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnTranslit" Style="{StaticResource NavButton}" Padding="16,8" Click="Tab_Click">
                <TextBlock Text="Написание в адресах" Style="{StaticResource NavButtonContentText}"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="3">

            <!-- ═══ Что лежит на хостинге ═══════════════════════════════════════ -->
            <Grid x:Name="StateTab">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Состояние самого хранилища: без ключей всё остальное на странице бессмысленно,
                     и человек должен понять это с первого взгляда, а не после нажатия кнопок. -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ХРАНИЛИЩЕ НА ХОСТИНГЕ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="StorageStateText" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="StorageAddressText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <!-- Предел размера — политика хранения, а не свойство машины, поэтому живёт
                             здесь же, где видно его последствия, а не в общих настройках: человек,
                             увидевший в журнале «файл 34 МБ при пределе 20 МБ», должен править
                             предел не уходя со страницы. -->
                        <WrapPanel>
                            <TextBlock Text="Предел размера файла, МБ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="MaxSizeInput" Width="70" Height="28" VerticalContentAlignment="Center"
                                     LostFocus="HostingLimit_Changed" KeyDown="HostingLimit_KeyDown"
                                     ToolTip="Ограничение касается только хостинга: на диск сколь угодно большой проект ПЛК класть можно."/>
                            <ComboBox x:Name="LimitModeCombo" Width="260" Height="28" Margin="10,0,0,0"
                                      SelectionChanged="HostingLimit_Changed">
                                <ComboBoxItem Content="Сверх предела — не выкладывать"/>
                                <ComboBoxItem Content="Сверх предела — выложить с предупреждением"/>
                            </ComboBox>
                            <TextBlock x:Name="LimitSavedText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Кнопки. «Проверить» ходит в сеть по одному объекту на строку — на сотне версий
                     это минуты, поэтому рядом полоса прогресса и «Остановить». -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button x:Name="CheckBtn" Content="Проверить на хостинге" Margin="0,0,8,8" Click="Check_Click"
                            ToolTip="Спросить у хранилища по каждой строке, лежит ли там файл. Это правда, а не наша запись о прошлой выкладке."/>
                    <Button x:Name="PublishMissingBtn" Content="Выложить недостающее" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Click="PublishMissing_Click"
                            ToolTip="Выложить то, чего на хостинге нет. Уже лежащее не трогается."/>
                    <Button x:Name="PublishSelectedBtn" Content="Выложить выбранное" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Click="PublishSelected_Click"/>
                    <Button x:Name="RepublishAllBtn" Content="Перезалить всё" Style="{StaticResource DangerButton}"
                            Margin="0,0,8,8" Click="RepublishAll_Click"
                            ToolTip="Выложить заново ВСЁ, включая уже лежащее — нужно, когда документы правили на диске, а на хостинге осталась прошлая редакция."/>
                    <Button x:Name="StopBtn" Content="Остановить" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Click="Stop_Click" Visibility="Collapsed"/>
                    <CheckBox x:Name="OnlyProblemsCheck" Content="Только те, что не на хостинге" VerticalAlignment="Center"
                              Margin="8,0,8,8" Checked="OnlyProblems_Changed" Unchecked="OnlyProblems_Changed"/>
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" x:Name="Progress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock Grid.Column="1" x:Name="ProgressText" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <DataGrid Grid.Row="3" x:Name="ItemsGrid" Margin="0,0,0,10"
                          Style="{StaticResource RoomyDataGrid}"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionMode="Extended" MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Выложить сейчас" Click="PublishSelected_Click"/>
                            <MenuItem Header="Открыть ссылку в браузере" Click="OpenUrl_Click"/>
                            <MenuItem Header="Скопировать ссылку" Click="CopyUrl_Click"/>
                            <MenuItem Header="Скопировать ключ объекта" Click="CopyKey_Click"/>
                            <MenuItem Header="Показать файл на диске" Click="ShowOnDisk_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Состояние" Binding="{Binding StateLabel}" Width="Auto" MinWidth="130"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Версия" Binding="{Binding VersionRaw}" Width="Auto" MinWidth="170"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Где" Binding="{Binding Where}" Width="Auto" MinWidth="180"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Что" Binding="{Binding Kind}" Width="Auto" MinWidth="150"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Размер" Binding="{Binding SizeLabel}" Width="Auto" MinWidth="80"
                                            ElementStyle="{StaticResource DataGridCellTextCentered}"
                                            HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                        <DataGridTextColumn Header="Адрес на хостинге" Binding="{Binding Url}" Width="*" MinWidth="200"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Ошибка" Binding="{Binding Error}" Width="Auto" MinWidth="200"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" x:Name="SummaryText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </Grid>

            <!-- ═══ Реквизиты ═══════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="AccessTab" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ДОСТУП К ХРАНИЛИЩУ (S3)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                       Text="Копия инструкции уходит сюда — по этому адресу она открывается по QR-коду с наклейки с любого телефона, а не только из офисной сети. Пока не загружен файл с ключами доступа, выкладки не происходит и всё работает как прежде."/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Адрес хранилища:" Margin="0,0,0,4"/>
                                    <TextBox x:Name="S3EndpointInput" Height="34" Margin="0,0,8,0"
                                             LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"
                                             ToolTip="Напр. https://s3.twcstorage.ru. Предустановлен адресом компании; стёртое поле вернёт его обратно."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Бакет:" Margin="0,0,0,4"/>
                                    <TextBox x:Name="S3BucketInput" Height="34" Width="160"
                                             LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Регион:" Margin="0,0,0,4"/>
                                    <TextBox x:Name="S3RegionInput" Height="34"
                                             LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"
                                             ToolTip="У Timeweb — ru-1"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Папка внутри бакета (необязательно):" Margin="0,0,0,4"/>
                            <TextBox x:Name="S3PrefixInput" Height="34" Margin="0,0,0,10"
                                     LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"
                                     ToolTip="Пусто — раскладка в бакете повторяет раскладку диска один в один."/>

                            <!-- Ключи доступа — файлом, а не полями ввода (просьба Ивана Герасимова от
                                 06.08.2026). Ключи приходят от хостинга готовым файлом, и любой ручной ввод
                                 здесь — это перепечатывание сорока случайных символов с шансом на опечатку,
                                 которая проявится не сразу, а первой несостоявшейся выкладкой. Разбор терпим
                                 к формату файла (txt/csv/json/env — см. S3SecretsFile): формат присланного
                                 файла мы не выбираем. -->
                            <TextBlock Text="Ключи доступа:" Margin="0,0,0,4"/>
                            <Border x:Name="S3SecretsDropZone" Style="{StaticResource DropZoneBorder}" Height="92" Cursor="Hand"
                                    AllowDrop="True" Drop="S3Secrets_Drop" DragOver="S3Secrets_DragOver" MouseLeftButtonUp="S3Secrets_Click"
                                    ToolTip="Файл с ключами, который прислал хостинг. Ключи хранятся зашифрованными; секретный ключ — это доступ на запись во весь бакет, поэтому показывается он только в виде «сохранён».">
                                <TextBlock x:Name="S3SecretsLabel" Style="{StaticResource MutedText}" TextAlignment="Center"
                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Выбрать файл..." Style="{StaticResource SecondaryButton}"
                                        Click="S3SecretsBrowse_Click" ToolTip="Выбрать файл с ключами — применится сразу"/>
                                <Button Grid.Column="2" x:Name="S3SecretsClearButton" Content="Убрать ключи" Style="{StaticResource SecondaryButton}"
                                        Click="S3SecretsClear_Click" ToolTip="Стереть ключи с этого компьютера. Выкладка остановится, всё остальное продолжит работать."/>
                            </Grid>

                            <CheckBox x:Name="S3PublishCheck" Content="Выкладывать инструкции на хостинг"
                                      Margin="0,0,0,8" Click="S3Publish_Click"
                                      ToolTip="Снять, чтобы приостановить выкладку, не стирая реквизиты."/>

                            <Button x:Name="S3CheckButton" Content="Проверить доступ" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Click="S3Check_Click"
                                    ToolTip="Спрашивает у бакета список файлов. Право на запись так не проверить — оно проверится первой же выложенной инструкцией."/>
                            <TextBlock x:Name="S3Status" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Веб-адрес диска инструкций стоит и здесь, и в Настройки → Печать — это ОДНА
                         настройка (instruction_base_url) в двух местах, а не две. Она правда нужна
                         обоим: без неё ссылке на хостинг неоткуда взяться (это хранилище), и она же
                         решает, что зашивать в QR на наклейке (это печать). Правка в любом из двух
                         мест меняет то же самое значение. -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ВЕБ-АДРЕС ДИСКА ИНСТРУКЦИЙ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                       Text="По этому адресу выложенная инструкция открывается с телефона — он же уходит в QR на наклейке. Та же настройка есть в Настройки → Печать: правится в любом из двух мест."/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WebUrlInput" Height="34" Margin="0,0,8,0"
                                         LostFocus="WebUrl_LostFocus" KeyDown="WebUrl_KeyDown"
                                         ToolTip="Корень, соответствующий корню диска инструкций — напр. https://fs.elitacompany.ru. Предустановлен адресом компании; стёртое поле вернёт его обратно."/>
                                <Button Grid.Column="1" Content="Открыть в браузере" Style="{StaticResource SecondaryButton}"
                                        Click="OpenWebUrl_Click" ToolTip="Проверить глазами, что по адресу и правда лежит диск инструкций"/>
                            </Grid>
                            <TextBlock x:Name="WebUrlHint" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Журнал ══════════════════════════════════════════════════════ -->
            <Grid x:Name="LogTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Что происходило при последних прогонах — целиком, включая причины отказов. Раньше эти строки уходили в предупреждения загрузки версии и терялись."/>
                <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Margin="0,0,0,10"/>
                <WrapPanel Grid.Row="2">
                    <Button Content="Скопировать журнал" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CopyLog_Click"/>
                    <Button Content="Очистить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ClearLog_Click"/>
                    <Button Content="Проверить доступ к хранилищу" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CheckAccess_Click"
                            ToolTip="Один запрос к бакету текущими ключами — отвечает, рабочие ли реквизиты вообще."/>
                </WrapPanel>
            </Grid>

            <!-- ═══ Транслит ════════════════════════════════════════════════════ -->
            <Grid x:Name="TranslitTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Диск у нас русский, а в адресе на хостинге кириллицы быть не должно — иначе ссылку покорёжит по дороге к телефону. Перевод считается сам; здесь его можно поправить там, где у имени есть принятое английское написание. Таблица общая для всех машин: ссылку печатает одна, а файл выкладывает другая, и перевод у них обязан совпадать."/>

                <!-- IsReadOnly="False" обязателен: общий стиль DataGrid (Themes/Styles.xaml) ставит
                     таблицам приложения режим только для чтения, и без этого колонка «В адресе» не
                     редактировалась вовсе — правка, ради которой таблица и заведена, была недоступна. -->
                <DataGrid Grid.Row="1" x:Name="TranslitGrid" Margin="0,0,0,10"
                          Style="{StaticResource RoomyDataGrid}" IsReadOnly="False"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          CellEditEnding="TranslitGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя на диске" Binding="{Binding Source}" Width="Auto" MinWidth="220"
                                            IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="В адресе" Binding="{Binding Latin, UpdateSourceTrigger=PropertyChanged}"
                                            Width="Auto" MinWidth="220" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Откуда" Binding="{Binding Origin}" Width="Auto" MinWidth="130"
                                            IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Пример адреса" Binding="{Binding Example}" Width="*" MinWidth="180"
                                            IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="2">
                    <Button Content="Собрать имена с диска" Margin="0,0,8,0" Click="CollectNames_Click"
                            ToolTip="Обойти справочник иерархии и папки версий, собрать все имена с кириллицей и показать, как они переведутся."/>
                    <Button Content="Сбросить строку к автопереводу" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetRow_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SaveTranslit_Click"/>
                    <TextBlock x:Name="TranslitHintText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
