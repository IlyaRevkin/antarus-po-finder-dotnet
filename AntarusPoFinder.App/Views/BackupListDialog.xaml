<Window x:Class="AntarusPoFinder.App.Views.BackupListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Резервные копии"
        Width="780" Height="520" MinWidth="620" MinHeight="400"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Здесь нет и не будет кнопки «восстановить». Класть базу поверх работающей программы
             одним нажатием — это способ потерять и то, что ещё оставалось: промах по строке,
             копия не той машины, копия до вчерашней загрузки прошивок — и откатывать уже нечего.
             Поэтому копия только раскладывается РЯДОМ, а дальше человек смотрит и решает сам.
             Порядок восстановления руками лежит в самом архиве (manifest.json) и в docs/backups.md. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Копии базы этого компьютера и общего конфига. Каждая — отдельный архив на свою дату."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="WhereText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="CopiesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource RoomyDataGrid}" CanUserResizeColumns="True"
                  MouseDoubleClick="CopiesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Когда снята" Binding="{Binding TakenLocal}" Width="Auto" MinWidth="130"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="Auto" MinWidth="80"
                                    ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                <DataGridTemplateColumn Header="Где лежит" Width="*" MinWidth="240" SortMemberPath="Location">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}"
                                       Style="{StaticResource DataGridCellText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Пароль" Binding="{Binding LockLabel}" Width="Auto" MinWidth="80"
                                    ElementStyle="{StaticResource DataGridCellTextCentered}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Распаковать рядом" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="Extract_Click"
                        ToolTip="Выбранная копия раскладывается в отдельную папку рядом с собой, и папка открывается. Ничего в программе при этом не меняется."/>
                <Button Content="Открыть папку копий" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="OpenFolder_Click"/>
                <Button Content="Журнал" Style="{StaticResource SecondaryButton}" Click="OpenLog_Click"
                        ToolTip="Что происходило с копиями: когда снимались, куда легли, на чём спотыкались."/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="Закрыть" IsCancel="True" Width="100"
                    Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
