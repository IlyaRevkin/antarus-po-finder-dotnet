<UserControl x:Class="AntarusPoFinder.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AntarusPoFinder.App.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>

        <!-- Content is an explicit TextBlock (not Content="…") with NavButtonContentText, not a bare
             string — see that style's comment in Themes/Styles.xaml: a bare string here left active-
             tab text dark-on-blue in light theme, since the implicit TextBlock style outranks the
             Foreground NavButton's Tag="Active" trigger sets on the Button itself. -->
        <!-- Полоса вкладок ездит по горизонтали: в минимальном размере окна все вкладки в строку не
             влезают, а до крайних («Подключение», «Пользователи») было не добраться вовсе — обрезались
             без единого способа прокрутить. Колесо мыши над полосой крутит её же (см.
             TabBar_PreviewMouseWheel), вертикальный скроллбар отключён — полоса всегда в одну строку. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      x:Name="TabBarScroll" Margin="0,0,0,16" PreviewMouseWheel="TabBar_PreviewMouseWheel">
        <StackPanel x:Name="TabBar" Orientation="Horizontal">
            <Button x:Name="TabBtnGeneral" Style="{StaticResource NavButton}" Tag="Active" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Общие" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnHierarchy" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Иерархия" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnFirmware" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Прошивки" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnModeration" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Модерация" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnReservations" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Резервация номеров" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnTags" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Теги" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnQuickApps" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Быстрый доступ" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <!-- Лоадер и Подключение вынесены отдельными вкладками по прямой просьбе: настроек у
                 каждого набралось на самостоятельный экран, и в «Общих» они тонули. -->
            <Button x:Name="TabBtnLoader" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Лоадер" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnConnection" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Подключение" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <!-- «Печать» — этикетки с QR на инструкцию и папка с шаблонами наклеек: всё, что уходит
                 на принтер, в одном месте и доступно всем ролям (печатает как раз наладчик). -->
            <Button x:Name="TabBtnPrinting" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Печать" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnUsers" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Пользователи" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <!-- «Чистка диска» была отдельным пунктом бокового меню и переехала сюда намеренно:
                 это разовая уборка общего диска, а не рабочий экран. Вкладка последняя в полосе и
                 видна только администратору (ApplyRoleVisibility) — ровно как раньше пункт меню. -->
            <Button x:Name="TabBtnCleanup" Style="{StaticResource NavButton}" Padding="16,8" Click="Tab_Click">
                <TextBlock Text="Чистка диска" Style="{StaticResource NavButtonContentText}"/>
            </Button>
        </StackPanel>
        </ScrollViewer>

        <!-- Раньше все 8 вкладок лежали внутри одного MainScrollViewer — на вкладках с большой
             таблицей (Прошивки/Резервация/Быстрый доступ/Пользователи) это означало, что в
             минимальном размере окна таблица съедала весь видимый экран, а кнопки под ней уезжали
             вниз и были видны только после прокрутки всей страницы. Теперь так устроены только те
             4 вкладки, где контент — «россыпь полей» произвольной длины (Общие/Иерархия/Модерация/
             Теги) — им прокрутка всей страницы удобна и естественна. Прошивки/Резервация/Быстрый
             доступ/Пользователи — прямые соседи ScrollViewer в этом же Grid.Row="2" (высота от окна
             ограничена самим Grid), у них своя раскладка Auto/*/Auto: таблица растягивается на
             оставшееся место и прокручивается сама (у DataGrid есть свой скроллбар), а кнопки —
             в последней Auto-строке, всегда на виду. -->
        <Grid Grid.Row="2">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- ═══════════════════════════ ОБЩИЕ ═══════════════════════════ -->
                <!-- Пути к дискам, разрешение сканирования и интервал синхронизации переехали на
                     страницу "Сетевые диски", доступную всем ролям (см. NetworkSyncView) — здесь
                     остаётся только то, что реально требует прав администратора. -->
                <StackPanel x:Name="GeneralTab">
                    <!-- Тема и цвет теперь здесь, в разделе «Оформление». Раньше переключатель темы жил в
                         сайдбаре, и переносить его сюда опасались из-за второго источника правды.
                         Опасение снято тем, что в сайдбаре его больше нет вовсе: правда одна —
                         сохранённая настройка, текущее значение помнит ThemeManager. -->

                    <!-- ─── Оформление ───
                         Цвет живёт здесь, а не в сайдбаре: там ему было место, пока он был «одной
                         кнопкой», а с палитрой это полноценная настройка. Переключатель светлой и
                         тёмной темы остаётся в сайдбаре — он на виду и нажимается часто, а
                         дублировать его сюда значило бы завести второй источник правды о теме.
                         Цвет же читается и пишется прямо в настройки, минуя MainWindowViewModel,
                         поэтому раздвоения состояния здесь не возникает. -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="DarkThemeCheck" Content="Тёмная тема" Margin="0,0,0,12"
                                      Checked="DarkTheme_Changed" Unchecked="DarkTheme_Changed"/>

                            <TextBlock Text="ЦВЕТ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Цвет кнопок и выделения. Работает и в светлой, и в тёмной теме — при переключении сохраняется."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="AccentSamples" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AccentSwatchButton}" Tag="{Binding Hex}"
                                                Click="AccentSample_Click" ToolTip="{Binding Name}">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Hex}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Свой цвет:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="AccentHexBox" Width="110" VerticalAlignment="Center"
                                         ToolTip="Код цвета, например #1E66F5" KeyDown="AccentHex_KeyDown"/>
                                <Button Content="Применить" Margin="8,0,0,0" Click="AccentHexApply_Click"/>
                                <Border x:Name="AccentPreview" Width="26" Height="26" CornerRadius="13" Margin="10,0,0,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}"/>
                                <TextBlock x:Name="AccentPreviewText" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <Button Content="Вернуть исходный цвет" HorizontalAlignment="Left" Click="AccentReset_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- ─── Запуск и поведение ─── -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ЗАПУСК ПРИЛОЖЕНИЯ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="AutostartCheck" Content="Запускать автоматически при входе в Windows" Margin="0,0,0,8" Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                            <CheckBox x:Name="StartMinimizedCheck" Content="Запускать свёрнутым" Margin="0,0,0,16" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"
                                      ToolTip="Если ниже выбрано «Сворачивать в системный трей» — окно вообще не появится при запуске, сразу свернётся в трей."/>

                            <!-- Категории уведомлений переехали в окно "Уведомления" (см. NotificationHistoryWindow) —
                                 логичнее настраивать их прямо там же, где видна сама история, а не в отдельном
                                 разделе Настроек. -->

                            <TextBlock Text="ПРИ ЗАКРЫТИИ ОКНА (КРЕСТИК)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <RadioButton x:Name="CloseActionCloseRadio" GroupName="CloseAction" Content="Закрывать приложение" Margin="0,0,0,4" Checked="CloseAction_Changed"/>
                            <RadioButton x:Name="CloseActionTrayRadio" GroupName="CloseAction" Content="Сворачивать в системный трей" Margin="0,0,0,0" Checked="CloseAction_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- ─── Доступ: только пароли ролей. Весь вход по AD (домен, группы, способ
                         проверки, URL, требовать вход, срок повторного входа) переехал на вкладку
                         «Подключение» — по прямой просьбе: это и есть настройка подключения к домену,
                         в «Общих» она была не на месте и дублировала тамошний выбор способа входа.
                         Пароли — орг-политика уровня приложения, наладчику/программисту не показываются
                         (см. SettingsView.ApplyRoleVisibility). Смена самой роли — в диалоге в сайдбаре
                         (RoleSwitchDialog), здесь не дублируется. -->
                    <TextBlock Text="ДОСТУП" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="AdminRoleAndPasswordsSection">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ПАРОЛИ ДОСТУПА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Администратор:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="AdminPwdInput" Height="34" Margin="0,0,0,8"
                                                  LostFocus="Password_LostFocus" KeyDown="Password_KeyDown"
                                                  ToolTip="Новый пароль сохраняется, как только вы уйдёте из поля или нажмёте Enter. Пустое поле ничего не меняет."/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Программист:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ProgPwdInput" Height="34" Margin="0,0,0,8"
                                                  LostFocus="Password_LostFocus" KeyDown="Password_KeyDown"
                                                  ToolTip="Новый пароль сохраняется, как только вы уйдёте из поля или нажмёте Enter. Убрать пароль совсем — кнопкой ниже."/>
                                </Grid>
                                <!-- Кнопки «Сохранить пароли» больше нет: набранный пароль сохраняется сам,
                                     по уходу из поля и по Enter (см. SettingsView.SavePassword). Пустое поле
                                     при этом НИЧЕГО не меняет — иначе один проход фокусом по форме молча
                                     снёс бы пароль администратора, единственный аварийный вход при проблемах
                                     с доменом. Поэтому «убрать пароль программиста» — отдельное явное
                                     действие, кнопкой ниже. -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Убрать пароль программиста" Style="{StaticResource SecondaryButton}" Click="ClearProgrammerPassword_Click"
                                            ToolTip="Роль «Программист» перестанет спрашивать пароль. Пароль администратора не трогает."/>
                                </StackPanel>
                                <TextBlock Text="Пароли хранятся хешированными — показать текущий нельзя, можно только задать новый."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ─── Обновление приложения — путь/источник, автообновление и постоянно видимая
                         текущая версия (не только после нажатия "Проверить обновления"). Версия читается
                         из того же источника, что и сравнение при проверке обновлений (AppUpdateService.
                         CurrentVersionText, 3-компонентный вид без сборочной ревизии) — гарантирует, что
                         здесь и в результатах проверки не разъедутся разные числа. -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ОБНОВЛЕНИЕ ПРИЛОЖЕНИЯ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AppVersionText" Text="Текущая версия: —" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Папка не указана — обновления ищутся на GitHub."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       ToolTip="Папка надёжнее: доступ к GitHub с рабочих машин регулярно режется, и тогда обновления перестают доезжать."/>
                            <!-- Поле сохраняется само (при уходе фокуса и после выбора через «…») —
                                 отдельной кнопки «Сохранить» больше нет, о факте сохранения сообщает
                                 нижняя строка состояния. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="AppUpdatePathInput" Height="34" Margin="0,0,8,0"
                                         LostFocus="AppUpdatePathInput_LostFocus" KeyDown="AppUpdatePath_KeyDown"
                                         ToolTip="Папка этой машины с файлами AntarusPoFinder-{версия}.exe. Если пусто — используется общая папка (ниже), а если и её нет — GitHub."/>
                                <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowseAppUpdatePath_Click"
                                        ToolTip="Выбрать папку — сохранится сразу"/>
                            </Grid>
                            <!-- Общая папка — единственная настройка обновлений, которая уезжает на все
                                 машины (см. UpdateFolderResolver и ConfigService.app_update_path_shared).
                                 Только администратору: она пишется в общий конфиг. -->
                            <StackPanel x:Name="SharedUpdatePathSection" Margin="0,0,0,8">
                                <TextBlock Text="Общая папка обновлений (для всех машин):" Margin="0,0,0,4"/>
                                <TextBox x:Name="AppUpdatePathSharedInput" Height="34" Margin="0,0,0,4"
                                         LostFocus="AppUpdatePathSharedInput_LostFocus"
                                         ToolTip="Уезжает на все машины вместе с общим конфигом. Лучше указывать путь ОТНОСИТЕЛЬНО корня рабочего диска (например «Обновления») — тогда он работает независимо от того, какой буквой диск подключён на каждой машине."/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Задаётся один раз администратором и синхронизируется на все машины. Пишите путь относительно корня рабочего диска («Обновления») или в виде \\сервер\шара\… — абсолютный путь с буквой диска на других машинах может не совпасть. Поле выше (папка этой машины) при заполнении перебивает общее."/>
                            </StackPanel>
                            <CheckBox x:Name="AppAutoUpdateCheck" Content="Устанавливать найденные обновления автоматически при запуске" Margin="0,0,0,8"
                                      Checked="AppAutoUpdate_Changed" Unchecked="AppAutoUpdate_Changed"
                                      ToolTip="Без вопросов ставить новую версию, если она нашлась при запуске"/>
                            <TextBlock x:Name="AppUpdateStatusText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Проверить обновления" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CheckAppUpdates_Click"
                                        ToolTip="Опрашивает оба источника сразу: что лежит в папке обновлений, что есть на GitHub, что установлено и что из этого будет использовано."/>
                                <Button x:Name="InstallLatestBtn" Content="Установить последнюю версию" IsEnabled="False" Margin="0,0,8,0" Click="InstallLatestUpdate_Click"
                                        ToolTip="Приложение закроется и перезапустится само. Доступно после проверки обновлений"/>
                                <Button Content="Проверить компьютер" Style="{StaticResource SecondaryButton}" Click="ShowConnectionStatus_Click"
                                        ToolTip="Диск, пути в базе, источник обновлений, обмен, права запуска — что не так, почему и что делать. По найденной проблеме можно сразу составить тикет."/>
                            </StackPanel>
                            <!-- Постоянный журнал «что нового по версиям» — то же, что разовое окно после
                                 обновления, но к нему можно вернуться в любой момент (см. AppChangelogWindow). -->
                            <Button Content="История изменений программы" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,8" Click="ShowAppChangelog_Click"
                                    ToolTip="Журнал «что нового» по всем установленным версиям"/>
                            <TextBlock Text="Откат на другую версию:" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="AppVersionsCombo" Height="34" Margin="0,0,8,0" DisplayMemberPath="Label"/>
                                <Button Grid.Column="1" Content="Установить выбранную" Click="InstallSelectedVersion_Click"
                                        ToolTip="Откатиться на выбранную версию или переустановить её — приложение перезапустится"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ─── Поиск и загрузка: всё, что происходит после нахождения прошивки — синхронизация
                         на локальную копию, что делать с распакованными архивами, куда грузить прошивку в
                         контроллер, подсказка по раскладке клавиатуры в поиске и статистика выборов версии.
                         Редко настраивается день в день — самая нижняя группа вкладки. -->
                    <TextBlock Text="ПОИСК И ЗАГРУЗКА" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ПОИСК" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="SearchAutoSyncCheck" Content="Автоматически подтягивать найденные прошивки в локальную копию" Margin="0,0,0,8"
                                      Checked="SearchAutoSync_Changed" Unchecked="SearchAutoSync_Changed"
                                      ToolTip="Найденные версии, которых ещё нет на этом компьютере, копируются с диска сами — жать «Синхронизировать» на карточке не нужно (пункт остался в «Ещё» на случай ошибки). За одну выдачу тянется не больше 10 версий."/>
                            <!-- Ручной полный обход диска доступен всем, кто дошёл до Настроек (включая
                                 наладчика) — раньше кнопка была только в admin-вкладке «Иерархия», и
                                 наладчик, зайдя синхронизировать прошивки с диска, её не находил. Это
                                 индексация (импорт найденного в локальную базу), а не структурная правка,
                                 поэтому не admin-only. Тот же обработчик, что у кнопки в «Иерархии». -->
                            <Button Content="Синхронизировать прошивки с диска" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16" Click="SyncFwFromDisk_Click"
                                    ToolTip="Обойти рабочий диск и подтянуть в локальную базу все прошивки, которых в ней ещё нет (в т.ч. загруженные коллегами). Структуру дисков/иерархию не меняет."/>

                            <CheckBox x:Name="KeepArchivesCheck" Content="Хранить архивы после извлечения" Margin="0,0,0,16"
                                      Checked="KeepArchives_Changed" Unchecked="KeepArchives_Changed"
                                      ToolTip="Выключено — распакованный архив удаляется, остаётся только его содержимое"/>

                            <!-- Настройки лоадера переехали на свою вкладку «Лоадер» (см. LoaderTab):
                                 к пути к Loader добавились режим подключения, адрес ПЛК, сетевой
                                 адаптер и проверка связи — в «Общих» это уже не помещалось. -->

                            <!-- Единая drag&drop-зона ПЛК+HMI на странице «Загрузка прошивки» — бета,
                                 видна только программисту/администратору (см. ApplyRoleVisibility),
                                 наладчику не показывается, чтобы случайно не поменял поведение формы
                                 себе, не разобравшись, что это экспериментальная функция. -->
                            <StackPanel x:Name="UnifiedZoneSection" Margin="0,16,0,0">
                                <TextBlock Text="ЗАГРУЗКА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="UnifiedPlcHmiZoneCheck" Content="Единая зона для ПЛК и HMI (бета)" Margin="0,0,0,8"
                                          Checked="UnifiedPlcHmiZone_Changed" Unchecked="UnifiedPlcHmiZone_Changed"
                                          ToolTip="Вместо двух отдельных зон (прошивка ПЛК сверху + отдельная HMI-зона под галочкой «Добавить HMI») — одна общая: файл/папку прошивки ПЛК и HMI-проект можно кинуть в неё вместе или по очереди, приложение попробует определить, что есть что, по расширению файла, а если не сможет — спросит."/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}">
                                    <Run Text="Экспериментальная функция — может ошибиться в распознавании ПЛК/HMI на нестандартной структуре проекта."/>
                                    <Run Text=" Действует только на странице «Загрузка прошивки», применяется при следующем её открытии."/>
                                    <Run Text=" Если распознавание сработало неверно — очистите поле в единой зоне и укажите файл заново (приложение переспросит, если не уверено), либо выключите галочку здесь, чтобы вернуться к раздельным зонам."/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="РАСКЛАДКА КЛАВИАТУРЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="LayoutFallbackCheck" Content="Подсказывать, если запрос похож на набранный не в той раскладке клавиатуры" Margin="0,0,0,8" Checked="LayoutFallback_Changed" Unchecked="LayoutFallback_Changed"
                                      ToolTip="Ничего не нашлось как введено, но нашлось после смены раскладки — поиск спросит, это ли имелось в виду. Ответы запоминаются по точному тексту запроса."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Порог одинаковых ответов подряд:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="LayoutFallbackThresholdInput" Width="60" Height="30" TextAlignment="Center" LostFocus="LayoutFallbackThreshold_Changed"/>
                            </StackPanel>
                            <!-- Да/Нет правятся прямо в таблице (двойной клик по ячейке): решение
                                 пересчитывается по тем же числам, что накопил бы обычный ответ. Запрос
                                 и «Решение» — только чтение (менять текст запроса смысла нет, решение —
                                 производное). -->
                            <DataGrid x:Name="LayoutFallbackGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="False" Margin="0,0,0,8"
                                      CanUserAddRows="False" CellEditEnding="LayoutFallbackGrid_CellEditEnding"
                                      PreviewMouseWheel="ScrollableChild_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Запрос" Binding="{Binding QueryKey}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Да" Binding="{Binding YesCount}" Width="60"/>
                                    <DataGridTextColumn Header="Нет" Binding="{Binding NoCount}" Width="60"/>
                                    <DataGridTextColumn Header="Решение" Binding="{Binding DecisionLabel}" Width="140" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сбросить выбранное" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetLayoutFallbackSelected_Click"
                                        ToolTip="Забыть ответы по выбранному запросу — вопрос про раскладку будет задан заново"/>
                                <Button Content="Сбросить всё обучение" Style="{StaticResource SecondaryButton}" Click="ResetLayoutFallbackAll_Click"
                                        ToolTip="Очистить таблицу целиком — программа снова спросит про раскладку по любому запросу"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="СТАТИСТИКА ВЫБОРОВ ПРОШИВКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="«По такому запросу обычно ставят эту версию» — статистика общая для всех машин: свои выборы уезжают на сетевой диск вместе с конфигом, чужие приезжают оттуда."/>
                            <CheckBox x:Name="UsageConfirmCheck" Margin="0,0,0,8"
                                      Content="Спрашивать «та ли это прошивка», прежде чем засчитать выбор"
                                      Checked="UsageConfirm_Changed" Unchecked="UsageConfirm_Changed"
                                      ToolTip="Порог одинаковых ответов подряд — общий с раскладкой клавиатуры (поле в карточке выше): ответив одинаково столько раз, программа перестанет спрашивать."/>
                            <TextBlock x:Name="UsageStatsLabel" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Порог влияния на ранжирование:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="FwUsageThresholdInput" Width="60" Height="30" TextAlignment="Center" LostFocus="FwUsageThreshold_Changed"
                                         ToolTip="Сколько раз версию должны выбрать по одному и тому же запросу, прежде чем частота начнёт поднимать её в выдаче. Выборы ниже порога видны в таблице, но на порядок не влияют — один случайный клик не поднимает версию наравне с той, которую ставят стабильно."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Множитель популярности:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="FwUsageMultiplierInput" Width="60" Height="30" TextAlignment="Center" LostFocus="FwUsageMultiplier_Changed"/>
                            </StackPanel>
                            <!-- Текст с актуальным потолком авто-вклада проставляется из кода
                                 (RefreshUsageStats) — он зависит от текущего множителя. -->
                            <TextBlock x:Name="FwUsageMultiplierHint" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="FwWeightSharedCheck" Margin="0,0,0,8"
                                      Content="Делиться ручным весом выдачи с другими машинами"
                                      Checked="FwWeightShared_Changed" Unchecked="FwWeightShared_Changed"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="Ручной вес (задаётся в модерации прошивки) складывается со счётчиком открытий. Множитель — общая настройка (уезжает на все машины); «делиться весом» — личное решение этой машины: счётчик открытий уезжает всегда, а ручной вес — только с этой галочкой."/>
                            <!-- «Выборов» и «Вес» правятся прямо в таблице (двойной клик): задают вклад
                                 ЭТОЙ машины по паре запрос→версия. Показанное число — сумма своего и
                                 чужого (снимок с других машин); правка меняет только свой вклад, поэтому
                                 ниже чужого значение не опустить. Столбцы-идентификаторы (запрос, подтип,
                                 контроллер, версия) — только чтение. Добавить новый запрос к версии — в
                                 модерации прошивки, там же чистится случайно накликанное. -->
                            <DataGrid x:Name="FwUsageGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="False" Margin="0,0,0,8"
                                      Style="{StaticResource RoomyDataGrid}" CanUserAddRows="False"
                                      CellEditEnding="FwUsageGrid_CellEditEnding"
                                      PreviewMouseWheel="ScrollableChild_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Запрос" Binding="{Binding QueryKey}" Width="*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                    <DataGridTextColumn Header="Контроллер" Binding="{Binding ControllerName}" Width="Auto" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                    <DataGridTemplateColumn Header="Версия" Width="140" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Выборов" Binding="{Binding Uses}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                    <!-- Ручной вес правится и здесь, и адресно в модерации прошивки — обе
                                         правки пишут одну и ту же строку (SetLocalFwWeight). -->
                                    <DataGridTextColumn Header="Вес" Binding="{Binding Weight}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сбросить статистику у всех" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetFwUsage_Click"
                                        ToolTip="Обнулить счётчики выборов и ручные веса — на всех машинах, а не только на этой"/>
                                <Button Content="Снова спрашивать" Style="{StaticResource SecondaryButton}" Click="ResetUsageConfirmLearning_Click"
                                        ToolTip="Забыть накопленные ответы на «та ли это прошивка» — вопрос начнёт задаваться заново"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ ИЕРАРХИЯ ═══════════════════════════ -->
                <StackPanel x:Name="HierarchyTab" Visibility="Collapsed">
                    <TextBlock Text="ТИПЫ ШКАФОВ И ПОДТИПЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Одна строка — один подтип. Двойной клик по ячейке — переименовать или изменить префикс."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                               ToolTip="У типа шкафа без реального деления на подтипы одна строка с подтипом «—». Тип не может существовать без подтипа: удаление последнего подтипа удаляет и сам тип."/>
                    <!-- Короткие поля (префиксы — числа в одну-две цифры) сидят по содержимому, но с
                         MinWidth не уже собственного заголовка — иначе "Префикс типа"/"Префикс подтипа"
                         обрезаются. "Папка" — единственная звёздная колонка, забирает весь остаток. -->
                    <DataGrid x:Name="HierarchyGrid" Height="260" AutoGenerateColumns="False" Margin="0,0,0,4"
                              Style="{StaticResource RoomyDataGrid}"
                              PreviewMouseWheel="ScrollableChild_PreviewMouseWheel" MouseDoubleClick="HierarchyGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип шкафа" Binding="{Binding GroupName}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Префикс типа" Binding="{Binding GroupPrefix}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Префикс подтипа" Binding="{Binding SubtypePrefix}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Папка" Binding="{Binding FolderName}" Width="*" MinWidth="140" ElementStyle="{StaticResource DataGridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Добавить тип" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddGroup_Click"
                                ToolTip="Новый тип шкафа — заводится сразу с первым подтипом"/>
                        <Button Content="Добавить подтип" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddSubtype_Click"
                                ToolTip="Новый подтип внутри выбранного в таблице типа шкафа"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteSubtype_Click"
                                ToolTip="Удалить выбранный подтип. Вместе с последним подтипом удаляется и сам тип шкафа"/>
                    </StackPanel>

                    <TextBlock Text="КОНТРОЛЛЕРЫ И МОДИФИКАЦИИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Одна строка — одна модификация контроллера. hw_version формирует третью группу цифр в номере версии (дополняется нулями до 4 цифр)."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <!-- "Модификация" сидит по содержимому (Auto, узкий столбец — имена модификаций
                         короткие), "Описание" — единственная звёздная колонка, забирает весь остаток. -->
                    <DataGrid x:Name="ControllersGrid" Height="220" AutoGenerateColumns="False" Margin="0,0,0,4"
                              Style="{StaticResource RoomyDataGrid}"
                              PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"
                              MouseDoubleClick="ControllersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип" Binding="{Binding ControllerName}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Модификация" Binding="{Binding DisplayName}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="hw_version" Binding="{Binding HwVersionText}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Добавить контроллер" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddController_Click"/>
                        <Button Content="Добавить модификацию" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddModification_Click"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteControllerRow_Click"/>
                    </StackPanel>

                    <TextBlock Text="ПРОИЗВОДИТЕЛИ ПЧ/УПП" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ManufList" Height="130" Margin="0,0,0,4" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddManufacturer_Click"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteManufacturer_Click"/>
                    </StackPanel>

                    <!-- Группы параметров — те самые «поля в выпадающих списках», которые до сих пор
                         правились только косвенно: справочник засевался миграцией, а завести свою
                         группу можно было лишь вписав её от руки в предпросмотре импорта. Порядок
                         здесь важнее названий: наладчик идёт по таблице сверху вниз, и «Сброс до
                         заводских», оказавшийся в середине, обнулит всё, что он уже выставил, —
                         поэтому «Выше»/«Ниже» стоят прямо в ряду, а не прячутся в отдельное окно. -->
                    <TextBlock Text="ГРУППЫ ПАРАМЕТРОВ ПЧ/УПП" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Разделы, на которые разбита таблица параметров. Порядок в этом списке — порядок разделов в документе; «Сброс до заводских» должен оставаться последним."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <!-- Виртуализация выключена намеренно: групп десяток-другой, а «Сброс до
                         заводских» обязан быть виден последним — ради него список и заведён. С
                         виртуализацией последний пункт не существует, пока к нему не прокрутишь, и
                         проверить «сброс внизу» нельзя ни глазом на снимке, ни живым прогоном. -->
                    <ListBox x:Name="ParamGroupList" Height="220" Margin="0,0,0,4"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"
                             MouseDoubleClick="RenameParamGroup_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="ParamGroupAddBtn" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddParamGroup_Click"/>
                        <Button x:Name="ParamGroupRenameBtn" Content="Переименовать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RenameParamGroup_Click"
                                ToolTip="Подпись поправится и в уже сохранённых редакциях НА ЭТОЙ МАШИНЕ. У коллег в их копиях этих редакций останется прежнее имя — строки редакции это снимок, и по машинам они не переписываются"/>
                        <Button x:Name="ParamGroupUpBtn" Content="Выше" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" Click="MoveParamGroupUp_Click"/>
                        <Button x:Name="ParamGroupDownBtn" Content="Ниже" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" Click="MoveParamGroupDown_Click"/>
                        <Button x:Name="ParamGroupRemoveBtn" Content="Убрать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RemoveParamGroup_Click"
                                ToolTip="Из справочника. У строк, уже помеченных этой группой, подпись останется — группа лежит в них текстом, а не ссылкой"/>
                        <Button x:Name="ParamGroupResetBtn" Content="Заводской порядок" Style="{StaticResource SecondaryButton}" Click="ResetParamGroupOrder_Click"
                                ToolTip="Вернуть порядок, заданный при первой установке. Свои группы останутся, но уедут в конец — перед «Сбросом до заводских»"/>
                    </StackPanel>
                    <TextBlock x:Name="ParamGroupHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- ПЛК, HMI и Схемы — три независимых списка расширений, но каждый занимал бы
                         целую полосу по высоте при списке всего в несколько пунктов. Кладём рядом,
                         в три столбца, экономя вертикальное место вкладки. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Каждая колонка — DockPanel: и поле ввода, и сам список расширений прижаты к
                             низу (Dock="Bottom"). Описания у трёх списков разной длины и переносятся на
                             разное число строк — в обычном StackPanel это сдвигало вниз и список, и поле
                             ввода той колонки, где описание короче/длиннее (список HMI «висел» выше
                             соседних). Колонки Grid имеют одну высоту (по самой высокой), а список+поле
                             фиксированной высоты, поэтому Dock="Bottom" выравнивает и списки, и поля ввода
                             всех трёх колонок по нижнему краю — верхние края списков тоже совпадают. -->
                        <DockPanel Grid.Column="0" LastChildFill="False">
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ExtInput" Height="34" Margin="0,0,8,0" ToolTip="напр. psl"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddExtension_Click"/>
                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteExtension_Click"/>
                            </Grid>
                            <ListBox x:Name="ExtList" DockPanel.Dock="Bottom" Height="100" Margin="0,0,0,6" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="РАЗРЕШЁННЫЕ РАСШИРЕНИЯ ДЛЯ ЗАГРУЗКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Если загружаемый файл не входит в этот список, программа предупредит и попросит подтвердить загрузку."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="2" LastChildFill="False">
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ExtHmiInput" Height="34" Margin="0,0,8,0" ToolTip="напр. fsprj"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddExtensionHmi_Click"/>
                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteExtensionHmi_Click"/>
                            </Grid>
                            <ListBox x:Name="ExtHmiList" DockPanel.Dock="Bottom" Height="100" Margin="0,0,0,6" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="РАЗРЕШЁННЫЕ РАСШИРЕНИЯ HMI-ПРОЕКТОВ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Отдельный список — для HMI-вложения (панель оператора), не для основной прошивки ПЛК слева."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="4" LastChildFill="False">
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ExtSchematicInput" Height="34" Margin="0,0,8,0" ToolTip="напр. xlsx"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddExtensionSchematic_Click"/>
                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteExtensionSchematic_Click"/>
                            </Grid>
                            <ListBox x:Name="ExtSchematicList" DockPanel.Dock="Bottom" Height="100" Margin="0,0,0,6" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="РАСШИРЕНИЯ ПОИСКА СХЕМ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Какие файлы на втором диске (Поиск → «Схемы») считаются схемой шкафа. Кроме чертежей и сканов сюда можно добавить, например, xlsx/xls или doc/docx."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Пересоздать структуру диска" Margin="0,0,8,0" Click="RebuildHierarchy_Click"/>
                        <Button Content="Синхронизировать прошивки с диска" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SyncFwFromDisk_Click"/>
                        <Button Content="Сканировать неизвестные файлы" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ScanUnknown_Click"/>
                        <Button Content="Таблица версий (Excel)" Style="{StaticResource SecondaryButton}" Click="ExportVersionTable_Click"
                                ToolTip="Сформировать таблицу нумерации версий (типы шкафов, подтипы, контроллеры — из текущих данных Иерархии) в отдельный Excel-файл."/>
                    </StackPanel>

                    <!-- Разовая операция «привести уже накопленный диск к текущим правилам»: кнопки
                         выше создают недостающие папки и подбирают новые прошивки, но НИЧЕГО не
                         двигают и не переименовывают из того, что уже лежит. Поэтому смена правил
                         (имя файла = имя папки версии, имена инструкций и заглушки) действовала
                         только для новых загрузок — старое оставалось как было. -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ПЕРЕСТРОИТЬ УЖЕ НАКОПЛЕННОЕ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Приводит давно лежащее на диске к нынешним правилам. Сначала показывает план."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       ToolTip="Имя файла прошивки = имя папки версии; имена инструкций к «инструкция_&lt;версия&gt;» и заглушки «в разработке»."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Перестроить структуру диска…" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="DiskMigration_Click"
                                        ToolTip="Запускать на одной машине и когда коллеги не заливают прошивки. Журнал операций сохраняется в «Конфиг» на диске."/>
                                <!-- Перенос ОПЦ внутрь контроллера — единственная операция, меняющая
                                     путь версии в базе, а путь у совпавшей записи импортом общего
                                     конфига не обновляется никогда. Поэтому на КАЖДОЙ машине, которая
                                     перестройку не запускала, путь чинится вот этой кнопкой. -->
                                <Button Content="Найти переехавшие ОПЦ" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="RepairOpcPaths_Click"
                                        ToolTip="Нажимают на своей машине после того, как кто-то перенёс ОПЦ внутрь контроллера: программа находит новые папки по номеру версии и правит пути. Ничего не двигает и не удаляет."/>
                                <!-- Разбор диска, который жил до Финдера: у него своя раскладка, и
                                     разложить её одной кнопкой нельзя — слишком много исключений.
                                     Поэтому окно только показывает найденное и предположения, а куда
                                     что пойдёт, решает человек построчно. -->
                                <Button Content="Разобрать старый диск…" Style="{StaticResource SecondaryButton}"
                                        Click="LegacyImport_Click"
                                        ToolTip="Выбрать папку со старой раскладкой, найти в ней прошивки и перенести отмеченные в структуру Финдера. Старая папка остаётся нетронутой — файлы копируются."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ МОДЕРАЦИЯ ═══════════════════════════ -->
                <StackPanel x:Name="ModerationTab" Visibility="Collapsed">
                    <TextBlock Text="Версии, ожидающие тегов, описания и подтверждения релиза."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                               ToolTip="То же, что «Модерация прошивок» в боковом меню. Откатанные и уже заменённые более свежей версией сюда не попадают."/>
                    <TextBlock x:Name="ModerationCountText" Text="Версии без тегов"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ModGrid" Height="360" AutoGenerateColumns="False" Margin="0,0,0,10"
                              Style="{StaticResource RoomyDataGrid}"
                              MouseDoubleClick="ModGrid_MouseDoubleClick" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                            <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                            <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                            <DataGridTemplateColumn Header="Версия" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Record.Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить теги" Margin="0,0,8,0" Click="ModerateFirmware_Click"
                                ToolTip="Открыть карточку выбранной версии — теги, описание, вложения. То же, что двойной клик по строке"/>
                        <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshModeration_Click"
                                ToolTip="Перечитать список — новые загрузки коллег приезжают синхронизацией"/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════════════════════ ТЕГИ ═══════════════════════════ -->
                <StackPanel x:Name="TagsTab" Visibility="Collapsed">
                    <TextBlock Text="Двойной клик по тегу — переименовать, «×» — удалить, «+» в конце — добавить."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               ToolTip="Общий список: доступен при загрузке прошивок и правке тегов в Поиске, Модерации и Прошивках. Удаление снимает тег со всех прошивок."/>
                    <TextBox x:Name="TagsFilterInput" Height="34" Margin="0,0,0,10"
                             ToolTip="Фильтр по подстроке в названии тега…" TextChanged="TagsFilter_Changed"/>
                    <WrapPanel x:Name="TagsBubblesPanel"/>
                </StackPanel>

                <!-- ═══════════════════════════ ЛОАДЕР ═══════════════════════════ -->
                <!-- Всё про заливку в ПЛК в одном месте: где лежит Segnetics Loader, чем и куда
                     подключаемся, и надо ли проверять связь до запуска. Доступна всем ролям —
                     заливает как раз наладчик, а это настройки его собственной машины и его шнурка. -->
                <StackPanel x:Name="LoaderTab" Visibility="Collapsed">
                    <TextBlock Text="Загрузка проекта в ПЛК идёт через локальный Automation API Segnetics Loader. Здесь — где он лежит и как эта машина подключается к контроллеру."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ПУТЬ К SEGNETICS LOADER" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Пустой путь выбирает Loader, установленный вместе с приложением. Можно указать папку Loader, SegneticsLoader.exe или SegneticsLoader.Automation.exe."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="LoaderExePathInput" Height="34" Margin="0,0,8,0"
                                         LostFocus="LoaderExePathInput_LostFocus" KeyDown="LoaderExePathInput_KeyDown"
                                         ToolTip="Папка Segnetics Loader, SegneticsLoader.exe или SegneticsLoader.Automation.exe. Пусто — встроенная копия."/>
                                <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseLoaderExe_Click" ToolTip="Выбрать файл — сохранится сразу"/>
                            </Grid>
                            <TextBlock x:Name="LoaderStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ПОДКЛЮЧЕНИЕ К ПЛК" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Выбранное здесь переносится в настройки Loader перед каждой заливкой. «Как в Loader» — не трогать их вовсе."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       ToolTip="Сам Loader принимает параметры подключения только из своих настроек. Правятся только те поля, которые там уже есть; рядом сохраняется резервная копия."/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Способ" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LoaderModeCombo" Height="34" Margin="0,0,0,8"
                                          SelectionChanged="LoaderMode_Changed"
                                          ToolTip="USB — шнурок в контроллер напрямую; Ethernet — по сети, тогда нужен адрес ниже."/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Адрес ПЛК" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="LoaderIpInput" Height="34" Margin="0,0,0,8"
                                         LostFocus="LoaderIp_LostFocus" KeyDown="LoaderIp_KeyDown"
                                         ToolTip="IP контроллера для Ethernet-подключения. Для USB не используется."/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Адаптер" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LoaderAdapterCombo" Height="34"
                                          SelectionChanged="LoaderAdapter_Changed"
                                          ToolTip="Через какую сетевую карту идти к шкафу — обычно это переходник USB-Ethernet, а не рабочая сеть."/>
                            </Grid>
                            <TextBlock x:Name="LoaderAdapterHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <CheckBox x:Name="LoaderCheckLinkCheck" Content="Проверять связь с ПЛК перед заливкой" Margin="0,0,0,8"
                                      Click="LoaderCheckLink_Click"
                                      ToolTip="Быстрая проба порта SSH по адресу выше. Связи нет — программа предупредит сразу, а не через минуту ожидания в самом Loader. Заливку не запрещает: решает наладчик."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Ждать ответа, мс" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="LoaderLinkTimeoutInput" Width="90" Height="30"
                                         LostFocus="LoaderLinkTimeout_LostFocus" KeyDown="LoaderLinkTimeout_KeyDown"
                                         ToolTip="Сколько ждать ответа контроллера при проверке связи. По умолчанию 1500."/>
                                <Button Content="Проверить связь" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                        Click="CheckPlcLink_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="LoaderLinkResultText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ПО УМОЛЧАНИЮ В ОКНЕ ЗАГРУЗКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="LoaderPrepareDefaultCheck" Content="Форматировать проект и обновить ядро ПЛК"
                                      Click="LoaderPrepareDefault_Click"
                                      ToolTip="Каким будет состояние галочки подготовки при каждом открытии окна загрузки. Сама подготовка работает только по USB — так устроен Loader."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ ПОДКЛЮЧЕНИЕ ═══════════════════════════ -->
                <!-- Всё про то, ЧЕМ приложение соединяется с внешним миром: чем подтверждается вход
                     (домен напрямую, веб-проверка, корпоративный SSO) и как ходят общие данные
                     (сетевая папка сегодня, сервер — когда его поднимут). Диагностика («Состояние
                     подключения») открывается отсюда же. -->
                <StackPanel x:Name="ConnectionTab" Visibility="Collapsed">
                    <TextBlock Text="Чем подтверждается вход и как приложение обменивается данными. Разделы независимы: вход можно перевести на корпоративный SSO, оставив данные на сетевой папке."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ВХОД: ЧЕМ ПОДТВЕРЖДАЕМ ЛИЧНОСТЬ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="AuthKindCombo" Height="34" Margin="0,0,0,10" SelectionChanged="AuthKind_Changed"
                                      ToolTip="Домен — прямой запрос к контроллеру домена. Веб-проверка — запрос к веб-адресу компании, работает там, где до домена не достучаться. Оба вместе — сначала домен, при недоступном домене веб-проверка. Корпоративный вход (Keycloak / OpenID Connect) — вход через браузер, пароль приложение не видит вовсе."/>

                            <!-- Домен, группы ролей, адрес веб-проверки и «требовать вход» — переехали
                                 сюда из «Общих»: это настройка подключения к домену, и способ входа
                                 (комбобокс выше) задаётся ровно тут же. Отдельных переключателей
                                 «LDAP / HTTP / Оба» больше нет — они дублировали этот комбобокс
                                 (тот же ключ ad_auth_mode), и два места для одной настройки путали. -->
                            <StackPanel x:Name="AdSection" Margin="0,0,0,10">
                                <TextBlock Text="Способ входа, домен, группы ролей, адрес веб-проверки и параметры Keycloak — общие для всех: задайте их один раз, и они разойдутся на все компьютеры через сетевую папку. «Требовать вход при запуске» остаётся настройкой этого компьютера."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Домен:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="AdDomainInput" Height="34" Margin="0,0,0,8" ToolTip="напр. Elita"
                                             LostFocus="AdSettings_LostFocus" KeyDown="AdSettings_KeyDown"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Группа администратора:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AdGroupAdminInput" Height="34" Margin="0,0,0,8"
                                             ToolTip="Группа AD, дающая роль администратора — напр. AntarusAdmins. Пусто — группа для этой роли не используется, такой вход попадает в список «Пользователи»."
                                             LostFocus="AdSettings_LostFocus" KeyDown="AdSettings_KeyDown"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Группа программиста:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="AdGroupProgInput" Height="34" Margin="0,0,0,8"
                                             LostFocus="AdSettings_LostFocus" KeyDown="AdSettings_KeyDown"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Группа наладчика:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="AdGroupNaladchikInput" Height="34" Margin="0,0,0,8"
                                             LostFocus="AdSettings_LostFocus" KeyDown="AdSettings_KeyDown"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес веб-проверки:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="AdHttpUrlInput" Height="34"
                                             LostFocus="AdSettings_LostFocus" KeyDown="AdSettings_KeyDown"
                                             ToolTip="Напр. https://disk.antarus.su/cloud — нужен способам «веб-проверка» и «домен, при недоступности — веб-проверка». Пусто — веб-проверка не сработает. Логин/пароль уходят как введены, через Negotiate/NTLM."/>
                                </Grid>

                                <CheckBox x:Name="AdRequireLoginCheck" Content="Требовать вход при запуске приложения" Margin="0,0,0,8"
                                          Checked="AdSettings_Changed" Unchecked="AdSettings_Changed"
                                          ToolTip="Выключено — приложение стартует без запроса входа. Пароль администратора остаётся аварийным входом при проблемах с доменом."/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Не переспрашивать, дней:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="AdRequireLoginDaysInput" Width="80" Height="34"
                                             LostFocus="AdRequireLoginDays_LostFocus" KeyDown="AdRequireLoginDays_KeyDown"
                                             ToolTip="Значение по умолчанию для тех, кто в окне входа оставит «как задано администратором»."/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="OidcSection">
                                <TextBlock Text="Параметры выдаёт ИТ, когда поднимет Keycloak (см. docs/keycloak-setup.md). Адрес — это адрес realm; клиент — идентификатор приложения в нём."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Адрес realm" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="OidcAuthorityInput" Height="34" Margin="0,0,0,8"
                                             LostFocus="OidcAuthority_LostFocus" KeyDown="OidcField_KeyDown"
                                             ToolTip="Напр. https://sso.antarus.su/realms/antarus"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Клиент" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="OidcClientIdInput" Height="34" Margin="0,0,0,8"
                                             LostFocus="OidcClientId_LostFocus" KeyDown="OidcField_KeyDown"
                                             ToolTip="client_id, выданный ИТ для этого приложения"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Claim с ролями" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="OidcGroupsClaimInput" Height="34"
                                             LostFocus="OidcGroupsClaim_LostFocus" KeyDown="OidcField_KeyDown"
                                             ToolTip="Из какого поля токена брать группы пользователя — по ним считается роль в приложении. Обычно groups или roles."/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Проверить адрес" Style="{StaticResource SecondaryButton}" Click="CheckOidc_Click"
                                            ToolTip="Запросить у сервера его описание (.well-known/openid-configuration) — сразу видно, тот ли адрес и жив ли сервер."/>
                                </StackPanel>
                                <TextBlock x:Name="OidcCheckResultText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Здесь стоял переключатель «Сетевая папка / Сервер» и поле адреса, которые
                                 не были подключены ни к чему: выбор ничего не менял, а поля ключа не было
                                 вовсе. Осталось только то, что действительно работает со службой
                                 antarus-sync (tools/sync-server): адрес, ключ этой машины и проверка связи
                                 по её же протоколу. -->
                            <TextBlock Text="СЛУЖБА ОБМЕНА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Адрес службы обмена на сервере конторы и ключ ЭТОЙ машины. Ключ у каждой машины свой: по нему служба узнаёт, кто пришёл, и решает, можно ли отправлять справочник. Пока адрес пуст, обмен идёт через сетевую папку, как раньше."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel x:Name="ServerSection">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Адрес службы" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <TextBox Grid.Column="1" x:Name="ServerUrlInput" Height="34"
                                             LostFocus="ServerUrl_LostFocus" KeyDown="ServerUrl_KeyDown"
                                             ToolTip="Напр. https://ant-srv:8443 — порт по умолчанию 8443, его задаёт ИТ при установке службы."/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ключ доступа" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <PasswordBox Grid.Column="1" x:Name="ServerKeyInput" Height="34"
                                                 PasswordChanged="ServerKey_Changed"
                                                 ToolTip="Выдаётся на сервере командой antarus-sync.exe addkey. Хранится зашифрованным и не уезжает на другие машины."/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Проверить связь" Style="{StaticResource SecondaryButton}" Click="CheckServer_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ServerCheckResultText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" x:Name="ConnectionCheckCard">
                        <StackPanel>
                            <TextBlock Text="ПРОВЕРКА ВСЕГО СРАЗУ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Рабочий диск, права запуска, пути к файлам в базе, источник обновлений, обмен, домен и хранилище — одним прогоном. По каждому пункту не «доступно/недоступно», а причина и что делать; отчёт можно скопировать в письмо, а по найденной проблеме — сразу составить заполненный тикет."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Проверить компьютер" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Click="ShowConnectionStatus_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ ПЕЧАТЬ ═══════════════════════════ -->
                <!-- Всё, что уходит на принтер: этикетка с QR на инструкцию и папка с шаблонами
                     наклеек. Доступно всем ролям — печатает наладчик. -->
                <StackPanel x:Name="PrintingTab" Visibility="Collapsed">

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ЭТИКЕТКА С QR НА ИНСТРУКЦИЮ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <!-- Кнопка в карточке называется «QR инструкции» и стоит в самом ряду действий,
                                 а не в меню «Ещё»: подсказка звала в «Ещё» → «QR и этикетка», где этого
                                 пункта нет, и человек по ней ничего бы не нашёл. -->
                            <TextBlock Text="Печатается из карточки прошивки — кнопка «QR инструкции»."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Заглушка живёт по тому же адресу, что и будущая инструкция, и до её
                                 появления именно её открывает напечатанный QR — то есть это часть
                                 того же разговора с заказчиком, что и наклейка, а не служебный файл. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Style="{StaticResource MutedText}"
                                           Text="Страница «Инструкция в разработке» — то, что откроется по QR, пока документа нет."/>
                                <Button Grid.Column="1" Content="Макет заглушки…" Style="{StaticResource SecondaryButton}"
                                        Click="EditStubLayout_Click"/>
                            </Grid>

                            <!-- Адрес диска инструкций и тексты этикетки — общие для предприятия
                                 (уезжают на все машины с конфигом), поэтому только администратору.
                                 Принтер и размер наклейки ниже — наоборот, настройки своей машины:
                                 их правит тот, кто печатает. -->
                            <StackPanel x:Name="PrintingSharedSection">
                                <TextBlock Text="Веб-адрес диска инструкций:" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="InstructionBaseUrlInput" Height="34" Margin="0,0,8,0"
                                             LostFocus="InstructionBaseUrl_LostFocus" KeyDown="PrintingField_KeyDown"
                                             ToolTip="Корень, соответствующий корню диска инструкций — напр. https://fs.elitacompany.ru. Предустановлен адресом компании; стёртое поле вернёт его обратно."/>
                                    <Button Grid.Column="1" Content="Проверить ссылку" Style="{StaticResource SecondaryButton}" Click="CheckInstructionUrl_Click"
                                            ToolTip="Запросить собранный адрес и показать, что ответил сервер"/>
                                </Grid>
                                <!-- Тот же адрес показан на странице «Хранилище»: он и правда нужен
                                     обоим — по нему инструкция открывается с хостинга и он же уходит
                                     в QR. Настройка одна (instruction_base_url), правится в любом из
                                     двух мест. -->
                                <TextBlock Text="Эта же настройка есть на странице «Хранилище» → «Реквизиты»."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InstructionUrlCheckText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Подпись назначения. На шкафу наклеек несколько (паспорт, ОТК,
                                     инструкция), и без строки-пояснения заказчик видит «просто QR,
                                     название установки и непонятные цифры». Текст общий для
                                     предприятия, поэтому здесь, у администратора; разово его можно
                                     поправить и в самом окне «QR инструкции». -->
                                <TextBlock Text="Подпись назначения на этикетке:" Margin="0,0,0,4"/>
                                <TextBox x:Name="LabelHeadlineInput" Height="34" Margin="0,0,0,4" MaxLength="60"
                                         LostFocus="LabelHeadline_LostFocus" KeyDown="PrintingField_KeyDown"
                                         ToolTip="Строка над кодом: «Руководство по эксплуатации — наведите камеру». Пусто — строки не будет."/>
                                <CheckBox x:Name="LabelShowHeadlineCheck" Content="Печатать подпись назначения"
                                          Margin="0,0,0,10" Click="LabelShowHeadline_Click"/>

                                <TextBlock Text="Подпись в центре фирменного кода (до 15 знаков):" Margin="0,0,0,4"/>
                                <TextBox x:Name="LabelHoleTextInput" Width="180" HorizontalAlignment="Left" Height="34"
                                         Margin="0,0,0,4" MaxLength="15"
                                         LostFocus="LabelHoleText_LostFocus" KeyDown="PrintingField_KeyDown"
                                         ToolTip="Например «РЭ». Длиннее четырёх знаков — печатается в две-три строки, так буквы получаются крупнее. Пусто — код печатается сплошным, без окошка."/>

                                <!-- Остальное про вид наклейки (положение кода, его вид, положение и
                                     выравнивание подписи назначения, поля, сдвиг, кегли) правится в
                                     окне «QR инструкции» — там же, где это видно на предпросмотре.
                                     Дублировать полтора десятка ручек ещё и здесь значило бы
                                     настраивать вслепую. -->
                                <TextBlock Text="Положение кода, его вид, положение подписи назначения, поля и кегли — в окне «QR инструкции»: там всё это сразу видно на предпросмотре."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>

                            <!-- Размер наклейки стоит здесь, рядом с принтером, а НЕ в общем разделе
                                 выше: наклейка заправлена в конкретный принтер, и по сети этот размер
                                 больше не разъезжается (ConfigSyncService.SkipSettingsKeys). Правит
                                 его тот, кто печатает, — как и выбор принтера. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Размер наклейки на этом компьютере, мм:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" x:Name="LabelWidthInput" Width="80" Height="34"
                                         LostFocus="LabelSize_LostFocus" KeyDown="PrintingField_KeyDown" ToolTip="Ширина"/>
                                <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="3" x:Name="LabelHeightInput" Width="80" Height="34"
                                         LostFocus="LabelSize_LostFocus" KeyDown="PrintingField_KeyDown" ToolTip="Высота"/>
                            </Grid>

                            <TextBlock Text="Принтер этикеток (на этом компьютере):" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LabelPrinterCombo" Height="34" Margin="0,0,0,10" SelectionChanged="LabelPrinter_Changed"
                                      ToolTip="«Принтер по умолчанию» — печатать на тот, что выбран в Windows. По сети настройка не разъезжается: у соседа принтер называется иначе."/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Пробная печать" Style="{StaticResource SecondaryButton}" Click="TestPrintLabel_Click"
                                        ToolTip="Напечатать образец этикетки выбранного размера — проверить поля и что принтер вообще тот"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="НАКЛЕЙКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Готовые шаблоны на печать («Проверено ОТК», «Проверьте перед подключением»). Открываются кнопкой «Наклейки» в боковом меню."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel x:Name="StickersFolderSection">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="StickersFolderInput" Height="34" Margin="0,0,8,0"
                                             LostFocus="StickersFolder_LostFocus" KeyDown="PrintingField_KeyDown"
                                             ToolTip="Пусто — Конфиг\Наклейки на общем диске. Можно указать путь относительно корня диска или абсолютный."/>
                                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowseStickersFolder_Click"
                                            ToolTip="Выбрать папку — сохранится сразу"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock x:Name="StickersFolderStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Открыть наклейки" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenStickers_Click"/>
                                <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Click="OpenStickersFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ШАБЛОНЫ ПАСПОРТОВ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Шаблоны паспортов — файлы в общей папке на диске (как наклейки). Нажмите «Сформировать паспорт» в боковом меню: название шкафа подставится в копию шаблона вместо метки. Можно держать несколько шаблонов / разные редакции — они просто лежат файлами рядом."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel x:Name="PassportTemplatesSection">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="PassportTemplatesFolderInput" Height="34" Margin="0,0,8,0"
                                             LostFocus="PassportTemplatesFolder_LostFocus" KeyDown="PrintingField_KeyDown"
                                             ToolTip="Пусто — Конфиг\Паспорта на общем диске. Можно указать путь относительно корня диска или абсолютный."/>
                                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowsePassportTemplatesFolder_Click"
                                            ToolTip="Выбрать папку — сохранится сразу"/>
                                </Grid>
                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Метка названия:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="PassportPlaceholderInput" Height="34"
                                             LostFocus="PassportPlaceholder_LostFocus" KeyDown="PrintingField_KeyDown"
                                             ToolTip="Что написано в шаблоне там, куда должно встать название шкафа. Пусто — вернётся значение по умолчанию."/>
                                </Grid>
                                <!-- Двусторонняя печать раньше жила только в конфиге. Паспорт —
                                     разворот на два листа, и переворот делается по КОРОТКОЙ стороне:
                                     по длинной оборот встаёт вверх ногами. Настройка общая (уезжает на
                                     все машины), поэтому и стоит здесь, рядом с папкой шаблонов. -->
                                <CheckBox x:Name="PassportDuplexCheck" Content="Печатать с двух сторон (переворот по короткой стороне)"
                                          Margin="0,6,0,0" Click="PassportDuplex_Click"
                                          ToolTip="Паспорт печатается разворотом на одном листе с двух сторон. Принтер без дуплекса настройку просто не применит — лист выйдет односторонним."/>
                            </StackPanel>
                            <TextBlock x:Name="PassportTemplatesStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Загрузить…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="UploadPassportTemplate_Click"
                                        ToolTip="Положить файл шаблона паспорта в общую папку — он сразу появится у всех машин"/>
                                <Button Content="Сформировать паспорт" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenPassportPrint_Click"/>
                                <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Click="OpenPassportTemplatesFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════ ПРОШИВКИ ═══════════════════════════ -->
        <!-- Grid вместо StackPanel: Auto-строки под фильтрами/чекбоксом, звёздная — под таблицей
             (сама тянется на весь остаток и скроллится своим скроллбаром), Auto — под кнопками, так
             что кнопки внизу гарантированно видны даже в MinHeight-окне (см. MainWindow MinHeight). -->
        <Grid x:Name="FirmwareTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Все загруженные прошивки. Двойной клик по строке — открыть файл прошивки; теги, описание и тип пуска — кнопкой «Редактировать»."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FwFilterInput" Height="36" Margin="0,0,8,0"
                         ToolTip="Фильтр по группе / контроллеру / версии / тегу…" TextChanged="FwFilter_Changed"/>
                <Button Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshFirmware_Click"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="FwGroupFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="1" x:Name="FwSubtypeFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="2" x:Name="FwControllerFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="3" x:Name="FwStatusFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="4" x:Name="FwTagFilterCombo" Height="34" SelectionChanged="FwFilterCombo_Changed"/>
            </Grid>
            <CheckBox Grid.Row="3" x:Name="FwNeedsModerationCheck" Content="Только требующие модерации" Margin="0,0,0,10"
                      Checked="FwModerationFilter_Changed" Unchecked="FwModerationFilter_Changed"/>
            <DataGrid Grid.Row="4" x:Name="FwGrid" AutoGenerateColumns="False" MinHeight="120" Margin="0,0,0,10"
                      Style="{StaticResource RoomyDataGrid}"
                      SelectionChanged="FwGrid_SelectionChanged"
                      MouseDoubleClick="FwGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTemplateColumn Header="Версия" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Теги" Binding="{Binding Tags}" Width="*" MinWidth="120" ElementStyle="{StaticResource DataGridCellText}"/>
                </DataGrid.Columns>
                <!-- BasedOn на общий (немаркерный) стиль DataGridRow из Styles.xaml — иначе этот
                     RowStyle полностью ЗАМЕНЯЕТ собой общий стиль (а не дополняет), и строки FwGrid
                     остались бы без общего hover/selected вида, добавленного централизованно. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRolledBack}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource RolledBackBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <StackPanel Grid.Row="5" Orientation="Horizontal">
                <Button Content="Открыть файл" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFirmwareFile_Click"
                        ToolTip="Открыть сам файл прошивки — то же, что двойной клик по строке. Если файл определить не удалось, откроется папка версии."/>
                <Button Content="Редактировать" Margin="0,0,8,0" Click="EditFirmware_Click"/>
                <Button Content="Дублировать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DuplicateFirmware_Click"/>
                <Button x:Name="SetCurrentFirmwareBtn" Content="Сделать текущей" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SetCurrentFirmware_Click"
                        ToolTip="Отметить эту версию текущей для её шкафа (подтип+контроллер+HW), в обход обычного правила «текущая = версия с максимальным SW». Например, когда более новую версию забраковали и вернулись к этой, не откатывая её формально."/>
                <Button x:Name="RollbackFirmwareBtn" Content="Откатить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RollbackFirmware_Click"
                        ToolTip="Пометить эту версию как откатанную. Следующая загрузка для того же шкафа/подтипа/контроллера получит тот же SW-номер заново. Файлы на диске не удаляются."/>
                <Button x:Name="UnrollbackFirmwareBtn" Content="Вернуть в активные" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="UnrollbackFirmware_Click"
                        ToolTip="Снять отметку «Откатана» — версия снова участвует в вычислении текущей/заменённой. Папку на диске (с маркером «_ОТКАТАНО» в имени) это не переименует обратно."/>
                <Button x:Name="DeleteFirmwareBtn" Content="Удалить прошивку" Style="{StaticResource SecondaryButton}" Click="DeleteFirmware_Click"
                        ToolTip="Безвозвратно удалить запись и файлы на диске (папку версии). В отличие от «Откатить» — не оставляет истории."/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════ РЕЗЕРВЫ НОМЕРОВ ═══════════════════════════ -->
        <Grid x:Name="ReservationsTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Открытые резервы номеров версий — номер зафиксирован для вписывания в прошивку до сборки, но ещё не загружен. Отмена (в том числе автоматическая по истечении срока) не освобождает номер для повторного использования."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Срок резерва по умолчанию:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ReservationTtlInput" Width="64" Height="34" Margin="0,0,8,0"
                         LostFocus="ReservationTtl_LostFocus" KeyDown="ReservationTtl_KeyDown"
                         ToolTip="Целое число часов, 0 — резерв не истекает. Сохраняется по уходу из поля или по Enter."/>
                <TextBlock Text="ч (0 — без ограничения)" VerticalAlignment="Center"/>
            </StackPanel>
            <DataGrid Grid.Row="2" x:Name="ReservationsGrid" AutoGenerateColumns="False" MinHeight="120" Margin="0,0,0,10"
                      Style="{StaticResource RoomyDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTemplateColumn Header="Номер" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:CopyableVersionText Text="{Binding Record.VersionRaw}" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Единственная звёздная (свободного размера) колонка — логин может быть
                         заметно длиннее заголовка "Кем зарезервирован", остальные поля здесь короткие
                         фиксированные коды/даты, как и в других таблицах приложения. -->
                    <DataGridTextColumn Header="Кем зарезервирован" Binding="{Binding Record.ReservedBy}" Width="*" MinWidth="170" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Истекает" Binding="{Binding ExpiresLabel}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Content="Отменить резерв" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelReservation_Click"/>
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshReservations_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════ БЫСТРЫЙ ДОСТУП ═══════════════════════════ -->
        <Grid x:Name="QuickAppsTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ярлыки для быстрого запуска (доступны наладчику в поиске)"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <!-- Кнопки «Сохранить» нет: список сохраняется сразу — после «Добавить», после «Удалить»
                 и по окончании правки строки в таблице (см. SettingsView.SaveApps). -->
            <DataGrid Grid.Row="1" x:Name="AppsGrid" AutoGenerateColumns="False" IsReadOnly="False" MinHeight="100" Margin="0,0,0,10"
                      RowEditEnding="AppsGrid_RowEditEnding"
                      ToolTip="Двойной клик по ячейке — переименовать ярлык или поправить путь. Изменения сохраняются сразу.">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay}" Width="200"/>
                    <DataGridTextColumn Header="Путь" Binding="{Binding Path, Mode=TwoWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddApp_Click"
                        ToolTip="Выбрать программу — появится в списке и сохранится сразу"/>
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteApp_Click"
                        ToolTip="Убрать выбранный ярлык из списка"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="ГДЕ ПОКАЗЫВАТЬ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="4" Text="Личная настройка этого компьютера — не синхронизируется с другими машинами."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <RadioButton Grid.Row="5" x:Name="QuickAppsModeSidebarRadio" GroupName="QuickAppsMode" Content="В боковом меню (список, как сейчас)"
                         Margin="0,0,0,4" Checked="QuickAppsMode_Changed"/>
            <RadioButton Grid.Row="6" x:Name="QuickAppsModeTopRadio" GroupName="QuickAppsMode" Content="Сверху над страницей — только иконки"
                         Margin="0,0,0,4" Checked="QuickAppsMode_Changed"/>
            <RadioButton Grid.Row="7" x:Name="QuickAppsModeTopLabeledRadio" GroupName="QuickAppsMode" Content="Сверху над страницей — иконки с подписями"
                         Margin="0,0,0,4" Checked="QuickAppsMode_Changed"/>
        </Grid>

        <!-- ═══════════════════════════ ПОЛЬЗОВАТЕЛИ (собственный AD-ростер) ═══════════════════════════ -->
        <Grid x:Name="UsersTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Те, кто вошёл по AD, но не входит ни в одну настроенную группу (вкладка «Подключение»). Первый вход получает роль «Наладчик» — здесь её можно изменить."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       ToolTip="Вход по AD-группе и вход по общим паролям ролей в этот список не попадают."/>
            <TextBox Grid.Row="1" x:Name="UsersFilterInput" Height="34" Margin="0,0,0,10"
                     ToolTip="Фильтр по AD-логину или роли…" TextChanged="UsersFilter_Changed"/>
            <DataGrid Grid.Row="2" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120" Margin="0,0,0,10"
                      Style="{StaticResource RoomyDataGrid}" MouseDoubleClick="UsersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="AD-логин" Binding="{Binding AdLogin}" Width="*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleLabel}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Первый вход" Binding="{Binding FirstLoginAt}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLoginAt}" Width="Auto" MinWidth="160" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="UserRoleCombo" Height="34" Margin="0,0,8,0" DisplayMemberPath="Label"
                          ToolTip="Роль, которую получит выбранный в таблице пользователь"/>
                <Button Grid.Column="1" Content="Сменить роль" Click="SetUserRole_Click"
                        ToolTip="Назначить выбранному в таблице пользователю роль из списка слева"/>
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RefreshUsers_Click"/>
                <Button Content="Удалить пользователя" Style="{StaticResource SecondaryButton}" Click="DeleteUser_Click"
                        ToolTip="Убрать из ростера. При следующем входе по AD он заведётся заново с ролью «Наладчик»"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════ ЧИСТКА ДИСКА ═══════════════════════════ -->
        <!-- Содержимое — та же DiskCleanupView, что раньше была отдельной страницей: она собирается
             в коде (её конструктору нужны службы приложения) и кладётся сюда при первом открытии
             вкладки. Прямо в разметке её не создать — конструктора без параметров у неё нет, и
             заводить его ради разметки значило бы дать странице способ существовать без служб. -->
        <ContentControl x:Name="CleanupTab" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
