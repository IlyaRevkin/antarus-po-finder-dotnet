<UserControl x:Class="AntarusPoFinder.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AntarusPoFinder.App.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>

        <!-- Content is an explicit TextBlock (not Content="…") with NavButtonContentText, not a bare
             string — see that style's comment in Themes/Styles.xaml: a bare string here left active-
             tab text dark-on-blue in light theme, since the implicit TextBlock style outranks the
             Foreground NavButton's Tag="Active" trigger sets on the Button itself. -->
        <StackPanel x:Name="TabBar" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="TabBtnGeneral" Style="{StaticResource NavButton}" Tag="Active" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Общие" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnHierarchy" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Иерархия" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnFirmware" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Прошивки" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnModeration" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Модерация" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnReservations" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Резервация номеров" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnTags" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Теги" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnQuickApps" Style="{StaticResource NavButton}" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                <TextBlock Text="Быстрый доступ" Style="{StaticResource NavButtonContentText}"/>
            </Button>
            <Button x:Name="TabBtnUsers" Style="{StaticResource NavButton}" Padding="16,8" Click="Tab_Click">
                <TextBlock Text="Пользователи" Style="{StaticResource NavButtonContentText}"/>
            </Button>
        </StackPanel>

        <!-- Раньше все 8 вкладок лежали внутри одного MainScrollViewer — на вкладках с большой
             таблицей (Прошивки/Резервация/Быстрый доступ/Пользователи) это означало, что в
             минимальном размере окна таблица съедала весь видимый экран, а кнопки под ней уезжали
             вниз и были видны только после прокрутки всей страницы. Теперь так устроены только те
             4 вкладки, где контент — «россыпь полей» произвольной длины (Общие/Иерархия/Модерация/
             Теги) — им прокрутка всей страницы удобна и естественна. Прошивки/Резервация/Быстрый
             доступ/Пользователи — прямые соседи ScrollViewer в этом же Grid.Row="2" (высота от окна
             ограничена самим Grid), у них своя раскладка Auto/*/Auto: таблица растягивается на
             оставшееся место и прокручивается сама (у DataGrid есть свой скроллбар), а кнопки —
             в последней Auto-строке, всегда на виду. -->
        <Grid Grid.Row="2">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- ═══════════════════════════ ОБЩИЕ ═══════════════════════════ -->
                <!-- Пути к дискам, разрешение сканирования и интервал синхронизации переехали на
                     страницу "Сетевые диски", доступную всем ролям (см. NetworkSyncView) — здесь
                     остаётся только то, что реально требует прав администратора. -->
                <StackPanel x:Name="GeneralTab">
                    <!-- Порядок разделов ниже: часто нужное и простое выше, редко-настраиваемое
                         (AD, лоадер) — ниже. Каждый логический раздел — отдельная карточка
                         (CardBorder); там, где раздел состоит из нескольких карточек сразу (Доступ;
                         Поиск и загрузка), над ними стоит общий заголовок группы, чтобы было видно,
                         что карточки ниже — про одно и то же. Настройки темы оформления в этой вкладке
                         нет — переключатель светлая/тёмная живёт в сайдбаре (MainWindow, снизу слева),
                         это отдельный UserControl без доступа к MainWindowViewModel.IsDarkTheme, дублировать
                         его сюда означало бы заводить второй источник правды для одного и того же
                         переключателя. -->

                    <!-- ─── Запуск и поведение ─── -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ЗАПУСК ПРИЛОЖЕНИЯ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="AutostartCheck" Content="Запускать автоматически при входе в Windows" Margin="0,0,0,8" Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                            <CheckBox x:Name="StartMinimizedCheck" Content="Запускать свёрнутым" Margin="0,0,0,16" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"
                                      ToolTip="Если ниже выбрано «Сворачивать в системный трей» — окно вообще не появится при запуске, сразу свернётся в трей."/>

                            <!-- Категории уведомлений переехали в окно "Уведомления" (см. NotificationHistoryWindow) —
                                 логичнее настраивать их прямо там же, где видна сама история, а не в отдельном
                                 разделе Настроек. -->

                            <TextBlock Text="ПРИ ЗАКРЫТИИ ОКНА (КРЕСТИК)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <RadioButton x:Name="CloseActionCloseRadio" GroupName="CloseAction" Content="Закрывать приложение" Margin="0,0,0,4" Checked="CloseAction_Changed"/>
                            <RadioButton x:Name="CloseActionTrayRadio" GroupName="CloseAction" Content="Сворачивать в системный трей" Margin="0,0,0,0" Checked="CloseAction_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- ─── Доступ: пароли ролей + весь вход по AD — обе темы про то, кто и как
                         попадает в приложение, поэтому идут одним блоком. Пароли доступа / полная
                         настройка AD (домен, группы, способ проверки, URL) — орг-политика уровня
                         приложения, а не что-то, что имеет смысл дать наладчику/программисту крутить у
                         себя: скрыто для них целиком (см. SettingsView.ApplyRoleVisibility), виден
                         только TTL повторного входа ниже. Смена самой роли — в диалоге в сайдбаре
                         (RoleSwitchDialog), здесь больше не дублируется. -->
                    <TextBlock Text="ДОСТУП" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="AdminRoleAndPasswordsSection">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ПАРОЛИ ДОСТУПА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Администратор:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="AdminPwdInput" Height="34" Margin="0,0,0,8"
                                                  ToolTip="Пустое поле при сохранении = не менять текущий пароль администратора."/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Программист:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ProgPwdInput" Height="34" Margin="0,0,0,8"
                                                  ToolTip="Пустое поле при сохранении = очистить пароль программиста (роль перестанет требовать пароль)."/>
                                </Grid>
                                <!-- Отдельной кнопки "Очистить пароль программиста" больше нет — пустое поле пароля
                                     программиста при сохранении само означает "очистить" (в отличие от поля
                                     администратора, где пустое = "не менять", см. SavePasswords_Click). -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Сохранить пароли" Margin="0,0,8,0" Click="SavePasswords_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ВХОД ПО ЛОГИНУ/ПАРОЛЮ AD (ОПЦИОНАЛЬНО)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}">
                                        <Run Text="⚠ Весь блок AD ниже (домен, группы ролей, способ проверки, URL) — настройка ЭТОГО компьютера." FontWeight="SemiBold"/>
                                        <Run Text=" Она НЕ синхронизируется по сети с другими машинами (в отличие от иерархии/прошивок/параметров) — администратору нужно один раз задать её на каждом ПК отдельно, «прилетит по сети само» не сработает."/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="В диалоге смены роли можно ввести домен, логин и пароль AD-учётки — приложение проверит их в домене и, если логин входит в одну из указанных ниже групп, войдёт в соответствующую роль без пароля роли. Не требует, чтобы Windows-сессия была именно под этой учёткой. Пусто у группы = для этой роли группа не используется — такой вход попадает в собственный список пользователей приложения (см. вкладку «Пользователи»), а не блокируется."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Домен:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="AdDomainInput" Height="34" Margin="0,0,0,8" ToolTip="напр. Elita"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Администратор:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AdGroupAdminInput" Height="34" Margin="0,0,0,8" ToolTip="напр. AntarusAdmins"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Программист:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="AdGroupProgInput" Height="34" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Наладчик:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="AdGroupNaladchikInput" Height="34" Margin="0,0,0,8"/>
                                </Grid>

                                <TextBlock Text="Способ проверки пароля AD:" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="AdModeLdapRadio" GroupName="AdAuthMode" Content="LDAP (напрямую в домен)" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="AdModeHttpRadio" GroupName="AdAuthMode" Content="HTTP (через веб-сервер)" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="AdModeBothRadio" GroupName="AdAuthMode" Content="Оба (LDAP, затем HTTP если домен недоступен)"/>
                                </StackPanel>
                                <TextBlock Text="URL веб-сервера для проверки пароля (способ HTTP):" Margin="0,0,0,4"/>
                                <TextBox x:Name="AdHttpUrlInput" Height="34" Margin="0,0,0,4"
                                         ToolTip="Например: https://disk.antarus.su/ — точный адрес и формат подтверждает IT компании."/>
                                <TextBlock Text="Пусто = способ HTTP не сможет сработать, даже если выбран выше. Логин/пароль передаются в веб-сервер как введено (без разбиения на домен), через Negotiate/NTLM."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <CheckBox x:Name="AdRequireLoginCheck" Content="Требовать вход по AD при запуске приложения" Margin="0,4,0,4"/>
                                <TextBlock Text="Пока не включено — приложение запускается как обычно, без запроса входа. Включив, при каждом запуске (если нет ещё действующего запомненного входа на этом компьютере) появится окно входа по AD; пароль администратора остаётся аварийным входом, чтобы не оказаться заблокированным при проблеме с доменом или на самой первой настройке системы."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="Сохранить группы и способ" HorizontalAlignment="Left" Click="SaveAdGroups_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Единственная часть AD-блока, видимая наладчику/программисту тоже — их
                         персональный срок "не переспрашивать" (per-machine, никогда не синхронизируется
                         по сети, см. ConfigSyncService.SkipSettingsKeys — то же верно для всего AD-блока
                         выше, так что "прилетает от администратора по сети" НЕ работает, донастраивать
                         обязана каждая машина у себя). Отдельная кнопка сохранения — "Сохранить группы и
                         способ" выше делает то же самое заодно, но она скрыта для этих ролей. -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="СРОК ПОВТОРНОГО ВХОДА ПО AD" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Не переспрашивать по умолчанию, дней:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" x:Name="AdRequireLoginDaysInput" Height="34"
                                         ToolTip="Значение для тех, кто в окне входа оставит «как задано администратором» — каждый может там же выбрать другой срок или «всегда» лично для себя."/>
                            </Grid>
                            <Button x:Name="SaveAdDaysOnlyBtn" Content="Сохранить" HorizontalAlignment="Left" Click="SaveAdRequireLoginDays_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ─── Обновление приложения — путь/источник, автообновление и постоянно видимая
                         текущая версия (не только после нажатия "Проверить обновления"). Версия читается
                         из того же источника, что и сравнение при проверке обновлений (AppUpdateService.
                         CurrentVersionText, 3-компонентный вид без сборочной ревизии) — гарантирует, что
                         здесь и в результатах проверки не разъедутся разные числа. -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ОБНОВЛЕНИЕ ПРИЛОЖЕНИЯ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AppVersionText" Text="Текущая версия: —" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Если папка ниже не указана — обновления ищутся в публичном репозитории GitHub. Папка надёжнее: доступ к GitHub с рабочих машин регулярно режется, и тогда обновления перестают доезжать." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <!-- Поле сохраняется само (при уходе фокуса и после выбора через «…») —
                                 отдельной кнопки «Сохранить» больше нет, о факте сохранения сообщает
                                 нижняя строка состояния. -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="AppUpdatePathInput" Height="34" Margin="0,0,8,0"
                                         LostFocus="AppUpdatePathInput_LostFocus"
                                         ToolTip="Папка этой машины с файлами AntarusPoFinder-{версия}.exe. Если пусто — используется общая папка (ниже), а если и её нет — GitHub."/>
                                <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowseAppUpdatePath_Click"/>
                            </Grid>
                            <!-- Общая папка — единственная настройка обновлений, которая уезжает на все
                                 машины (см. UpdateFolderResolver и ConfigService.app_update_path_shared).
                                 Только администратору: она пишется в общий конфиг. -->
                            <StackPanel x:Name="SharedUpdatePathSection" Margin="0,0,0,8">
                                <TextBlock Text="Общая папка обновлений (для всех машин):" Margin="0,0,0,4"/>
                                <TextBox x:Name="AppUpdatePathSharedInput" Height="34" Margin="0,0,0,4"
                                         LostFocus="AppUpdatePathSharedInput_LostFocus"
                                         ToolTip="Уезжает на все машины вместе с общим конфигом. Лучше указывать путь ОТНОСИТЕЛЬНО корня рабочего диска (например «Обновления») — тогда он работает независимо от того, какой буквой диск подключён на каждой машине."/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Задаётся один раз администратором и синхронизируется на все машины. Пишите путь относительно корня рабочего диска («Обновления») или в виде \\сервер\шара\… — абсолютный путь с буквой диска на других машинах может не совпасть. Поле выше (папка этой машины) при заполнении перебивает общее."/>
                            </StackPanel>
                            <CheckBox x:Name="AppAutoUpdateCheck" Content="Устанавливать найденные обновления автоматически при запуске" Margin="0,0,0,8"
                                      Checked="AppAutoUpdate_Changed" Unchecked="AppAutoUpdate_Changed"/>
                            <TextBlock x:Name="AppUpdateStatusText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Проверить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CheckAppUpdates_Click"
                                        ToolTip="Опрашивает оба источника сразу: что лежит в папке обновлений, что есть на GitHub, что установлено и что из этого будет использовано."/>
                                <Button x:Name="InstallLatestBtn" Content="Установить последнюю версию" IsEnabled="False" Margin="0,0,8,0" Click="InstallLatestUpdate_Click"/>
                                <Button Content="Состояние подключения" Style="{StaticResource SecondaryButton}" Click="ShowConnectionStatus_Click"
                                        ToolTip="Диск, домен/сервер входа и источник обновлений — что доступно прямо сейчас и почему нет."/>
                            </StackPanel>
                            <!-- Постоянный журнал «что нового по версиям» — то же, что разовое окно после
                                 обновления, но к нему можно вернуться в любой момент (см. AppChangelogWindow). -->
                            <Button Content="История изменений программы" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,8" Click="ShowAppChangelog_Click"/>
                            <TextBlock Text="Откат на другую версию:" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="AppVersionsCombo" Height="34" Margin="0,0,8,0" DisplayMemberPath="Label"/>
                                <Button Grid.Column="1" Content="Установить выбранную" Click="InstallSelectedVersion_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ─── Поиск и загрузка: всё, что происходит после нахождения прошивки — синхронизация
                         на локальную копию, что делать с распакованными архивами, куда грузить прошивку в
                         контроллер, подсказка по раскладке клавиатуры в поиске и статистика выборов версии.
                         Редко настраивается день в день — самая нижняя группа вкладки. -->
                    <TextBlock Text="ПОИСК И ЗАГРУЗКА" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ПОИСК" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="SearchAutoSyncCheck" Content="Автоматически подтягивать найденные прошивки в локальную копию" Margin="0,0,0,8"
                                      Checked="SearchAutoSync_Changed" Unchecked="SearchAutoSync_Changed"/>
                            <TextBlock Text="Найденные поиском версии, которых ещё нет на этом компьютере, копируются с диска сами — отдельную кнопку «Синхронизировать» на карточке жать не нужно (она осталась в меню «Ещё» на случай ошибки). За одну выдачу тянется не больше 10 версий, остальные — вручную."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <!-- Ручной полный обход диска доступен всем, кто дошёл до Настроек (включая
                                 наладчика) — раньше кнопка была только в admin-вкладке «Иерархия», и
                                 наладчик, зайдя синхронизировать прошивки с диска, её не находил. Это
                                 индексация (импорт найденного в локальную базу), а не структурная правка,
                                 поэтому не admin-only. Тот же обработчик, что у кнопки в «Иерархии». -->
                            <Button Content="Синхронизировать прошивки с диска" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16" Click="SyncFwFromDisk_Click"
                                    ToolTip="Обойти рабочий диск и подтянуть в локальную базу все прошивки, которых в ней ещё нет (в т.ч. загруженные коллегами). Структуру дисков/иерархию не меняет."/>

                            <CheckBox x:Name="KeepArchivesCheck" Content="Хранить архивы после извлечения" Margin="0,0,0,8"/>
                            <Button Content="Сохранить" HorizontalAlignment="Left" Margin="0,0,0,16" Click="SaveMisc_Click"/>

                            <TextBlock Text="ЛОАДЕР" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Загрузка проекта в ПЛК выполняется через локальный Automation API Segnetics Loader. Пустой путь выбирает Loader, установленный вместе с приложением. Можно указать папку Loader, SegneticsLoader.exe или SegneticsLoader.Automation.exe."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="LoaderExePathInput" Height="34" Margin="0,0,8,0"
                                         LostFocus="LoaderExePathInput_LostFocus"
                                         ToolTip="Папка Segnetics Loader, SegneticsLoader.exe или SegneticsLoader.Automation.exe. Пусто — встроенная копия."/>
                                <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseLoaderExe_Click"/>
                            </Grid>

                            <!-- Единая drag&drop-зона ПЛК+HMI на странице «Загрузка прошивки» — бета,
                                 видна только программисту/администратору (см. ApplyRoleVisibility),
                                 наладчику не показывается, чтобы случайно не поменял поведение формы
                                 себе, не разобравшись, что это экспериментальная функция. -->
                            <StackPanel x:Name="UnifiedZoneSection" Margin="0,16,0,0">
                                <TextBlock Text="ЗАГРУЗКА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="UnifiedPlcHmiZoneCheck" Content="Единая зона для ПЛК и HMI (бета)" Margin="0,0,0,8"
                                          Checked="UnifiedPlcHmiZone_Changed" Unchecked="UnifiedPlcHmiZone_Changed"
                                          ToolTip="Вместо двух отдельных зон (прошивка ПЛК сверху + отдельная HMI-зона под галочкой «Добавить HMI») — одна общая: файл/папку прошивки ПЛК и HMI-проект можно кинуть в неё вместе или по очереди, приложение попробует определить, что есть что, по расширению файла, а если не сможет — спросит."/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}">
                                    <Run Text="Экспериментальная функция — может ошибиться в распознавании ПЛК/HMI на нестандартной структуре проекта."/>
                                    <Run Text=" Действует только на странице «Загрузка прошивки», применяется при следующем её открытии."/>
                                    <Run Text=" Если распознавание сработало неверно — очистите поле в единой зоне и укажите файл заново (приложение переспросит, если не уверено), либо выключите галочку здесь, чтобы вернуться к раздельным зонам."/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="РАСКЛАДКА КЛАВИАТУРЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox x:Name="LayoutFallbackCheck" Content="Подсказывать, если запрос похож на набранный не в той раскладке клавиатуры" Margin="0,0,0,8" Checked="LayoutFallback_Changed" Unchecked="LayoutFallback_Changed"/>
                            <TextBlock Text="Если запрос ничего не находит как введён, но находит после смены раскладки — поиск спросит один раз, это ли имелось в виду. Ответы запоминаются по точному тексту запроса: после нескольких одинаковых ответов подряд вопрос для этого запроса перестаёт появляться (он либо всегда подставляется, либо больше не пробуется)." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Порог одинаковых ответов подряд:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="LayoutFallbackThresholdInput" Width="60" Height="30" TextAlignment="Center" LostFocus="LayoutFallbackThreshold_Changed"/>
                            </StackPanel>
                            <!-- Да/Нет правятся прямо в таблице (двойной клик по ячейке): решение
                                 пересчитывается по тем же числам, что накопил бы обычный ответ. Запрос
                                 и «Решение» — только чтение (менять текст запроса смысла нет, решение —
                                 производное). -->
                            <DataGrid x:Name="LayoutFallbackGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="False" Margin="0,0,0,8"
                                      CanUserAddRows="False" CellEditEnding="LayoutFallbackGrid_CellEditEnding"
                                      PreviewMouseWheel="ScrollableChild_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Запрос" Binding="{Binding QueryKey}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Да" Binding="{Binding YesCount}" Width="60"/>
                                    <DataGridTextColumn Header="Нет" Binding="{Binding NoCount}" Width="60"/>
                                    <DataGridTextColumn Header="Решение" Binding="{Binding DecisionLabel}" Width="140" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сбросить выбранное" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetLayoutFallbackSelected_Click"/>
                                <Button Content="Сбросить всё обучение" Style="{StaticResource SecondaryButton}" Click="ResetLayoutFallbackAll_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="СТАТИСТИКА ВЫБОРОВ ПРОШИВКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="«По такому запросу обычно ставят эту версию» — статистика общая для всех машин: свои выборы уезжают на сетевой диск вместе с конфигом, чужие приезжают оттуда."/>
                            <CheckBox x:Name="UsageConfirmCheck" Margin="0,0,0,8"
                                      Content="Спрашивать «та ли это прошивка», прежде чем засчитать выбор"
                                      Checked="UsageConfirm_Changed" Unchecked="UsageConfirm_Changed"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="Порог одинаковых ответов подряд — общий с раскладкой клавиатуры (поле выше). Ответив одинаково столько раз, программа перестанет спрашивать."/>
                            <TextBlock x:Name="UsageStatsLabel" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Порог влияния на ранжирование:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="FwUsageThresholdInput" Width="60" Height="30" TextAlignment="Center" LostFocus="FwUsageThreshold_Changed"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="Сколько раз версию должны выбрать по одному и тому же запросу, прежде чем эта частота начнёт поднимать её в выдаче. Выборы ниже порога видны в таблице, но на порядок выдачи не влияют — так один случайный клик не поднимает версию наравне с той, которую ставят стабильно."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Множитель популярности:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="FwUsageMultiplierInput" Width="60" Height="30" TextAlignment="Center" LostFocus="FwUsageMultiplier_Changed"/>
                            </StackPanel>
                            <!-- Текст с актуальным потолком авто-вклада проставляется из кода
                                 (RefreshUsageStats) — он зависит от текущего множителя. -->
                            <TextBlock x:Name="FwUsageMultiplierHint" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="FwWeightSharedCheck" Margin="0,0,0,8"
                                      Content="Делиться ручным весом выдачи с другими машинами"
                                      Checked="FwWeightShared_Changed" Unchecked="FwWeightShared_Changed"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="Ручной вес (задаётся в модерации прошивки) складывается со счётчиком открытий. Множитель — общая настройка (уезжает на все машины); «делиться весом» — личное решение этой машины: счётчик открытий уезжает всегда, а ручной вес — только с этой галочкой."/>
                            <!-- «Выборов» и «Вес» правятся прямо в таблице (двойной клик): задают вклад
                                 ЭТОЙ машины по паре запрос→версия. Показанное число — сумма своего и
                                 чужого (снимок с других машин); правка меняет только свой вклад, поэтому
                                 ниже чужого значение не опустить. Столбцы-идентификаторы (запрос, подтип,
                                 контроллер, версия) — только чтение. Добавить новый запрос к версии — в
                                 модерации прошивки, там же чистится случайно накликанное. -->
                            <DataGrid x:Name="FwUsageGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="False" Margin="0,0,0,8"
                                      Style="{StaticResource RoomyDataGrid}" CanUserAddRows="False"
                                      CellEditEnding="FwUsageGrid_CellEditEnding"
                                      PreviewMouseWheel="ScrollableChild_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Запрос" Binding="{Binding QueryKey}" Width="*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                    <DataGridTextColumn Header="Контроллер" Binding="{Binding ControllerName}" Width="Auto" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                    <DataGridTemplateColumn Header="Версия" Width="140" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Выборов" Binding="{Binding Uses}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                    <!-- Ручной вес правится и здесь, и адресно в модерации прошивки — обе
                                         правки пишут одну и ту же строку (SetLocalFwWeight). -->
                                    <DataGridTextColumn Header="Вес" Binding="{Binding Weight}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сбросить статистику у всех" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetFwUsage_Click"/>
                                <Button Content="Снова спрашивать" Style="{StaticResource SecondaryButton}" Click="ResetUsageConfirmLearning_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════ ИЕРАРХИЯ ═══════════════════════════ -->
                <StackPanel x:Name="HierarchyTab" Visibility="Collapsed">
                    <TextBlock Text="ТИПЫ ШКАФОВ И ПОДТИПЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Одна строка — один подтип. У типа шкафа без реального деления на подтипы одна строка с подтипом «—». Тип не может существовать без подтипа: удаление последнего подтипа удаляет и сам тип. Двойной клик по ячейке «Тип шкафа»/«Подтип» — переименовать, по «Префикс типа»/«Префикс подтипа» — изменить префикс."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <!-- Короткие поля (префиксы — числа в одну-две цифры) сидят по содержимому, но с
                         MinWidth не уже собственного заголовка — иначе "Префикс типа"/"Префикс подтипа"
                         обрезаются. "Папка" — единственная звёздная колонка, забирает весь остаток. -->
                    <DataGrid x:Name="HierarchyGrid" Height="260" AutoGenerateColumns="False" Margin="0,0,0,4"
                              Style="{StaticResource RoomyDataGrid}"
                              PreviewMouseWheel="ScrollableChild_PreviewMouseWheel" MouseDoubleClick="HierarchyGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип шкафа" Binding="{Binding GroupName}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Префикс типа" Binding="{Binding GroupPrefix}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Префикс подтипа" Binding="{Binding SubtypePrefix}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Папка" Binding="{Binding FolderName}" Width="*" MinWidth="140" ElementStyle="{StaticResource DataGridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Добавить тип" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddGroup_Click"/>
                        <Button Content="Добавить подтип" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddSubtype_Click"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteSubtype_Click"/>
                    </StackPanel>

                    <TextBlock Text="КОНТРОЛЛЕРЫ И МОДИФИКАЦИИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Одна строка — одна модификация контроллера. hw_version формирует третью группу цифр в номере версии (дополняется нулями до 4 цифр)."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <!-- "Модификация" сидит по содержимому (Auto, узкий столбец — имена модификаций
                         короткие), "Описание" — единственная звёздная колонка, забирает весь остаток. -->
                    <DataGrid x:Name="ControllersGrid" Height="220" AutoGenerateColumns="False" Margin="0,0,0,4"
                              Style="{StaticResource RoomyDataGrid}"
                              PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"
                              MouseDoubleClick="ControllersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип" Binding="{Binding ControllerName}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Модификация" Binding="{Binding DisplayName}" Width="Auto" MinWidth="130" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="hw_version" Binding="{Binding HwVersionText}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}" HeaderStyle="{StaticResource CenteredColumnHeader}"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Добавить контроллер" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddController_Click"/>
                        <Button Content="Добавить модификацию" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddModification_Click"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteControllerRow_Click"/>
                    </StackPanel>

                    <TextBlock Text="ПРОИЗВОДИТЕЛИ ПЧ/УПП" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="ManufList" Height="130" Margin="0,0,0,4" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddManufacturer_Click"/>
                        <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteManufacturer_Click"/>
                    </StackPanel>

                    <!-- ПЛК, HMI и Схемы — три независимых списка расширений, но каждый занимал бы
                         целую полосу по высоте при списке всего в несколько пунктов. Кладём рядом,
                         в три столбца, экономя вертикальное место вкладки. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Каждая колонка — DockPanel: и поле ввода, и сам список расширений прижаты к
                             низу (Dock="Bottom"). Описания у трёх списков разной длины и переносятся на
                             разное число строк — в обычном StackPanel это сдвигало вниз и список, и поле
                             ввода той колонки, где описание короче/длиннее (список HMI «висел» выше
                             соседних). Колонки Grid имеют одну высоту (по самой высокой), а список+поле
                             фиксированной высоты, поэтому Dock="Bottom" выравнивает и списки, и поля ввода
                             всех трёх колонок по нижнему краю — верхние края списков тоже совпадают. -->
                        <DockPanel Grid.Column="0" LastChildFill="False">
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ExtInput" Height="34" Margin="0,0,8,0" ToolTip="напр. psl"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddExtension_Click"/>
                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteExtension_Click"/>
                            </Grid>
                            <ListBox x:Name="ExtList" DockPanel.Dock="Bottom" Height="100" Margin="0,0,0,6" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="РАЗРЕШЁННЫЕ РАСШИРЕНИЯ ДЛЯ ЗАГРУЗКИ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Если загружаемый файл не входит в этот список, программа предупредит и попросит подтвердить загрузку."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="2" LastChildFill="False">
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ExtHmiInput" Height="34" Margin="0,0,8,0" ToolTip="напр. fsprj"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddExtensionHmi_Click"/>
                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteExtensionHmi_Click"/>
                            </Grid>
                            <ListBox x:Name="ExtHmiList" DockPanel.Dock="Bottom" Height="100" Margin="0,0,0,6" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="РАЗРЕШЁННЫЕ РАСШИРЕНИЯ HMI-ПРОЕКТОВ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Отдельный список — для HMI-вложения (панель оператора), не для основной прошивки ПЛК слева."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="4" LastChildFill="False">
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ExtSchematicInput" Height="34" Margin="0,0,8,0" ToolTip="напр. xlsx"/>
                                <Button Grid.Column="1" Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddExtensionSchematic_Click"/>
                                <Button Grid.Column="2" Content="Удалить" Style="{StaticResource SecondaryButton}" Click="DeleteExtensionSchematic_Click"/>
                            </Grid>
                            <ListBox x:Name="ExtSchematicList" DockPanel.Dock="Bottom" Height="100" Margin="0,0,0,6" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel"/>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="РАСШИРЕНИЯ ПОИСКА СХЕМ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Какие файлы на втором диске (Поиск → «Схемы») считаются схемой шкафа. Кроме чертежей и сканов сюда можно добавить, например, xlsx/xls или doc/docx."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Пересоздать структуру диска" Margin="0,0,8,0" Click="RebuildHierarchy_Click"/>
                        <Button Content="Синхронизировать прошивки с диска" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SyncFwFromDisk_Click"/>
                        <Button Content="Сканировать неизвестные файлы" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ScanUnknown_Click"/>
                        <Button Content="Таблица версий (Excel)" Style="{StaticResource SecondaryButton}" Click="ExportVersionTable_Click"
                                ToolTip="Сформировать таблицу нумерации версий (типы шкафов, подтипы, контроллеры — из текущих данных Иерархии) в отдельный Excel-файл."/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════════════════════ МОДЕРАЦИЯ ═══════════════════════════ -->
                <StackPanel x:Name="ModerationTab" Visibility="Collapsed">
                    <TextBlock Text="Загруженные версии, ожидающие тегов/описания и подтверждения релиза (см. также «Модерация прошивок» в боковом меню). Откатанные и уже заменённые более свежей версией сюда не попадают."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ModerationCountText" Text="Версии без тегов"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ModGrid" Height="360" AutoGenerateColumns="False" Margin="0,0,0,10"
                              Style="{StaticResource RoomyDataGrid}"
                              MouseDoubleClick="ModGrid_MouseDoubleClick" PreviewMouseWheel="ScrollableChild_PreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                            <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                            <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                            <DataGridTemplateColumn Header="Версия" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Record.Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить теги" Margin="0,0,8,0" Click="ModerateFirmware_Click"/>
                        <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshModeration_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════════════════════ ТЕГИ ═══════════════════════════ -->
                <StackPanel x:Name="TagsTab" Visibility="Collapsed">
                    <TextBlock Text="Общий список тегов — доступен при загрузке прошивок и редактировании тегов в Поиске/Модерации/Прошивках. Двойной клик по тегу — переименовать, «×» — удалить (снимется со всех прошивок), «+» в конце — добавить."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="TagsFilterInput" Height="34" Margin="0,0,0,10"
                             ToolTip="Фильтр по подстроке в названии тега…" TextChanged="TagsFilter_Changed"/>
                    <WrapPanel x:Name="TagsBubblesPanel"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════ ПРОШИВКИ ═══════════════════════════ -->
        <!-- Grid вместо StackPanel: Auto-строки под фильтрами/чекбоксом, звёздная — под таблицей
             (сама тянется на весь остаток и скроллится своим скроллбаром), Auto — под кнопками, так
             что кнопки внизу гарантированно видны даже в MinHeight-окне (см. MainWindow MinHeight). -->
        <Grid x:Name="FirmwareTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Все загруженные прошивки — редактируйте теги, описание и тип пуска"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="FwFilterInput" Height="36" Margin="0,0,8,0"
                         ToolTip="Фильтр по группе / контроллеру / версии / тегу…" TextChanged="FwFilter_Changed"/>
                <Button Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshFirmware_Click"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="FwGroupFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="1" x:Name="FwSubtypeFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="2" x:Name="FwControllerFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="3" x:Name="FwStatusFilterCombo" Height="34" Margin="0,0,6,0" SelectionChanged="FwFilterCombo_Changed"/>
                <ComboBox Grid.Column="4" x:Name="FwTagFilterCombo" Height="34" SelectionChanged="FwFilterCombo_Changed"/>
            </Grid>
            <CheckBox Grid.Row="3" x:Name="FwNeedsModerationCheck" Content="Только требующие модерации" Margin="0,0,0,10"
                      Checked="FwModerationFilter_Changed" Unchecked="FwModerationFilter_Changed"/>
            <DataGrid Grid.Row="4" x:Name="FwGrid" AutoGenerateColumns="False" MinHeight="120" Margin="0,0,0,10"
                      Style="{StaticResource RoomyDataGrid}"
                      SelectionChanged="FwGrid_SelectionChanged"
                      MouseDoubleClick="FwGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTemplateColumn Header="Версия" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Теги" Binding="{Binding Tags}" Width="*" MinWidth="120" ElementStyle="{StaticResource DataGridCellText}"/>
                </DataGrid.Columns>
                <!-- BasedOn на общий (немаркерный) стиль DataGridRow из Styles.xaml — иначе этот
                     RowStyle полностью ЗАМЕНЯЕТ собой общий стиль (а не дополняет), и строки FwGrid
                     остались бы без общего hover/selected вида, добавленного централизованно. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRolledBack}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource RolledBackBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <StackPanel Grid.Row="5" Orientation="Horizontal">
                <Button Content="Редактировать" Margin="0,0,8,0" Click="EditFirmware_Click"/>
                <Button Content="Дублировать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DuplicateFirmware_Click"/>
                <Button x:Name="SetCurrentFirmwareBtn" Content="Сделать текущей" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SetCurrentFirmware_Click"
                        ToolTip="Отметить эту версию текущей для её шкафа (подтип+контроллер+HW), в обход обычного правила «текущая = версия с максимальным SW». Например, когда более новую версию забраковали и вернулись к этой, не откатывая её формально."/>
                <Button x:Name="RollbackFirmwareBtn" Content="Откатить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RollbackFirmware_Click"
                        ToolTip="Пометить эту версию как откатанную. Следующая загрузка для того же шкафа/подтипа/контроллера получит тот же SW-номер заново. Файлы на диске не удаляются."/>
                <Button x:Name="UnrollbackFirmwareBtn" Content="Вернуть в активные" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="UnrollbackFirmware_Click"
                        ToolTip="Снять отметку «Откатана» — версия снова участвует в вычислении текущей/заменённой. Папку на диске (с маркером «_ОТКАТАНО» в имени) это не переименует обратно."/>
                <Button x:Name="DeleteFirmwareBtn" Content="Удалить прошивку" Style="{StaticResource SecondaryButton}" Click="DeleteFirmware_Click"
                        ToolTip="Безвозвратно удалить запись и файлы на диске (папку версии). В отличие от «Откатить» — не оставляет истории."/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════ РЕЗЕРВЫ НОМЕРОВ ═══════════════════════════ -->
        <Grid x:Name="ReservationsTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Открытые резервы номеров версий — номер зафиксирован для вписывания в прошивку до сборки, но ещё не загружен. Отмена (в том числе автоматическая по истечении срока) не освобождает номер для повторного использования."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Срок резерва по умолчанию:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ReservationTtlInput" Width="64" Height="34" Margin="0,0,8,0"/>
                <TextBlock Text="ч (0 — без ограничения)" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Сохранить" Style="{StaticResource SecondaryButton}" Click="SaveReservationTtl_Click"/>
            </StackPanel>
            <DataGrid Grid.Row="2" x:Name="ReservationsGrid" AutoGenerateColumns="False" MinHeight="120" Margin="0,0,0,10"
                      Style="{StaticResource RoomyDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTemplateColumn Header="Номер" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <views:CopyableVersionText Text="{Binding Record.VersionRaw}" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Единственная звёздная (свободного размера) колонка — логин может быть
                         заметно длиннее заголовка "Кем зарезервирован", остальные поля здесь короткие
                         фиксированные коды/даты, как и в других таблицах приложения. -->
                    <DataGridTextColumn Header="Кем зарезервирован" Binding="{Binding Record.ReservedBy}" Width="*" MinWidth="170" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Истекает" Binding="{Binding ExpiresLabel}" Width="Auto" MinWidth="140" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Content="Отменить резерв" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelReservation_Click"/>
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshReservations_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════ БЫСТРЫЙ ДОСТУП ═══════════════════════════ -->
        <Grid x:Name="QuickAppsTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Ярлыки для быстрого запуска (доступны наладчику в поиске)"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DataGrid Grid.Row="1" x:Name="AppsGrid" AutoGenerateColumns="False" IsReadOnly="False" MinHeight="100" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name, Mode=TwoWay}" Width="200"/>
                    <DataGridTextColumn Header="Путь" Binding="{Binding Path, Mode=TwoWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Добавить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddApp_Click"/>
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DeleteApp_Click"/>
                <Button Content="Сохранить" Click="SaveApps_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="ГДЕ ПОКАЗЫВАТЬ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="4" Text="Личная настройка этого компьютера — не синхронизируется с другими машинами."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <RadioButton Grid.Row="5" x:Name="QuickAppsModeSidebarRadio" GroupName="QuickAppsMode" Content="В боковом меню (список, как сейчас)"
                         Margin="0,0,0,4" Checked="QuickAppsMode_Changed"/>
            <RadioButton Grid.Row="6" x:Name="QuickAppsModeTopRadio" GroupName="QuickAppsMode" Content="Сверху над страницей — только иконки"
                         Margin="0,0,0,4" Checked="QuickAppsMode_Changed"/>
            <RadioButton Grid.Row="7" x:Name="QuickAppsModeTopLabeledRadio" GroupName="QuickAppsMode" Content="Сверху над страницей — иконки с подписями"
                         Margin="0,0,0,4" Checked="QuickAppsMode_Changed"/>
        </Grid>

        <!-- ═══════════════════════════ ПОЛЬЗОВАТЕЛИ (собственный AD-ростер) ═══════════════════════════ -->
        <Grid x:Name="UsersTab" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Пользователи, вошедшие через «Войти по AD» в диалоге смены роли, когда логин не входит ни в одну настроенную AD-группу (см. вкладку «Общие» → «Вход по логину/паролю AD»). Первый вход с новым AD-логином автоматически получает роль «Наладчик» — здесь администратор может её изменить. Вход по AD-группе и вход по общим паролям ролей в этот список не попадают."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBox Grid.Row="1" x:Name="UsersFilterInput" Height="34" Margin="0,0,0,10"
                     ToolTip="Фильтр по AD-логину или роли…" TextChanged="UsersFilter_Changed"/>
            <DataGrid Grid.Row="2" x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120" Margin="0,0,0,10"
                      Style="{StaticResource RoomyDataGrid}" MouseDoubleClick="UsersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="AD-логин" Binding="{Binding AdLogin}" Width="*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleLabel}" Width="Auto" MinWidth="120" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Первый вход" Binding="{Binding FirstLoginAt}" Width="Auto" MinWidth="150" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                    <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLoginAt}" Width="Auto" MinWidth="160" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="UserRoleCombo" Height="34" Margin="0,0,8,0" DisplayMemberPath="Label"/>
                <Button Grid.Column="1" Content="Сменить роль" Click="SetUserRole_Click"/>
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RefreshUsers_Click"/>
                <Button Content="Удалить пользователя" Style="{StaticResource SecondaryButton}" Click="DeleteUser_Click"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
