<Window x:Class="AntarusPoFinder.App.Views.ParamTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Таблица параметров"
        Width="1180" Height="720" MinWidth="900" MinHeight="540"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: к какому файлу параметров всё это относится, какой документ показан (у одного
             файла их бывает несколько: «Задание Modbus», «Пуск по месту») и отбор по аппарату —
             главное действие наладчика на объекте. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" x:Name="FileLabel"
                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

            <!-- К каким типам и подтипам шкафов относится документ. Своей привязки у него нет и быть
                 не должно (см. Core/Services/ParamTableBinding.cs): она ВЫВОДИТСЯ из записей файла
                 параметров. Но не показать её было прямой жалобой владельца — «в таблице теряется
                 привязка к типам подтипам»: наладчик, открыв документ, не понимал, к какому шкафу
                 таблица относится вообще. Правится там же, где и у файла, тем же окном. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" x:Name="BindingLabel"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,6"/>
            <Button Grid.Row="1" Grid.Column="6" x:Name="SubtypesBtn" Content="Подтипы…"
                    Style="{StaticResource CompactSecondaryButton}" HorizontalAlignment="Right" Margin="0,0,0,6"
                    Click="Subtypes_Click"
                    ToolTip="К каким подтипам шкафов подходит этот файл параметров. Тот же набор, что на странице «Параметры»: файл и документ описывают один и тот же шкаф"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" x:Name="TagsLabel"
                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,0,12,8"/>
            <Button Grid.Row="2" Grid.Column="6" x:Name="TagsBtn" Content="Теги…"
                    Style="{StaticResource CompactSecondaryButton}" HorizontalAlignment="Right" Margin="0,0,0,8"
                    Click="Tags_Click"
                    ToolTip="Слова, по которым документ находится поиском: «modbus», «пуск по месту», модель ПЧ"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Документ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DocumentCombo" Height="30" DisplayMemberPath="Name"
                      SelectionChanged="Document_Changed"/>

            <TextBlock Grid.Row="3" Grid.Column="3" Text="Показать строки:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Row="3" Grid.Column="4" x:Name="ApplicabilityCombo" Width="220" Height="30"
                      SelectionChanged="Applicability_Changed"
                      ToolTip="Строки без пометки годятся всем аппаратам и показываются всегда"/>

            <Button Grid.Row="3" Grid.Column="6" x:Name="ImportBtn" Content="Новый документ из файла…"
                    Style="{StaticResource SecondaryButton}" Click="Import_Click"
                    ToolTip="Разобрать накопленный txt в таблицу — с предпросмотром и правкой до сохранения"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="150"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список ревизий слева — как в «Истории изменений программы»: свежая сверху, у каждой
                 номер, дата и автор. -->
            <ListBox Grid.Column="0" x:Name="RevisionsList" SelectionChanged="Revision_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subheader}" Style="{StaticResource MutedText}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="1*" MinHeight="60"/>
                </Grid.RowDefinitions>

                <!-- «Зачем» от автора ревизии — короткой строкой над таблицей: это единственное, что
                     пишет человек, и единственное, что объясняет, почему числа ниже такие. -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="ReasonText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AuthorText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserResizeColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                          Style="{StaticResource WrappingDataGrid}">
                    <!-- Разделы таблицы отбиты строкой через всю ширину — как «=========[Настройка
                         ШУ]» в исходном txt. До этого группа была обычным значением первой колонки,
                         повторявшимся из строки в строку: и читалось хуже, и место занимало зря.
                         Поэтому столбца «Группа» здесь больше нет — его заменил этот заголовок.

                         ⚠️ Порядок разделов — ИЗ СПРАВОЧНИКА, а не по алфавиту: строки приходят сюда
                         уже разложенными (ParamTableEditing.Ordered), а группировка порядок
                         источника сохраняет. Своих SortDescriptions здесь нет намеренно — они бы
                         как раз и переставили разделы по алфавиту, уронив «Сброс до заводских» в
                         середину. -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource DataGridGroupHeader}">
                                                        <TextBlock Style="{StaticResource DataGridGroupHeaderText}">
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}"
                                                                 Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <!-- Пометка словом, а не только цветом: цвет не читается ни на печати, ни
                             при дальтонизме, а «что изменилось» — главный вопрос к этой таблице. -->
                        <!-- Ширина задана, а не «по содержимому»: у изменённой строки пометка
                             ЖИРНАЯ, ширину по содержимому столбец меряет обычным начертанием, и
                             запас нужен ровно той строке, ради которой столбец и заведён. -->
                        <DataGridTextColumn Header="Изменение" Binding="{Binding ChangeMark}" Width="110" MinWidth="90"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="Auto" MinWidth="80"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <!-- Название и описание — с переносом: в накопленных файлах это фразы
                             человека, а не короткие поля базы, и «некоторый текст не влазит» была
                             жалоба ровно про них. -->
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" MinWidth="180"
                                            ElementStyle="{StaticResource DataGridCellTextWrap}"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding ValueDisplay}" Width="Auto" MinWidth="120"
                                            ElementStyle="{StaticResource DataGridCellTextWrap}"/>
                        <DataGridTextColumn Header="Заводское" Binding="{Binding Factory}" Width="Auto" MinWidth="90"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="Auto" MinWidth="55"
                                            ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*" MinWidth="180"
                                            ElementStyle="{StaticResource DataGridCellTextWrap}"/>
                        <DataGridTextColumn Header="Только для" Binding="{Binding Applicability}" Width="*" MinWidth="120"
                                            ElementStyle="{StaticResource DataGridCellTextWrap}"/>
                        <DataGridTextColumn Header="Когда нужно" Binding="{Binding AppliesWhen}" Width="*" MinWidth="120"
                                            ElementStyle="{StaticResource DataGridCellTextWrap}"/>
                    </DataGrid.Columns>
                    <!-- Начертание — на СТРОКЕ (оно наследуется ячейками), а цвет — на ЯЧЕЙКЕ, и
                         это не вкусовщина: общий стиль DataGridCell задаёт Foreground сам, а стиль
                         текста внутри ячейки привязан именно к её Foreground (см. Themes/Styles.xaml)
                         — цвет, заданный на строке, до текста просто не доходит. Живой прогон это и
                         показал: строки помечались, но оставались обычного цвета. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Change}" Value="ValueChanged">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="ExtraChanged">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="Edited">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Style.Triggers>
                                <!-- Изменённые относительно ПРЕДЫДУЩЕЙ ревизии строки. -->
                                <DataTrigger Binding="{Binding Change}" Value="ValueChanged">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <!-- Правка в СВОЁМ столбце — тем же цветом, что и правка значения:
                                     это и есть правка значения, просто в столбце, который человек
                                     завёл сам. Различает их слово в столбце «Изменение», а не
                                     оттенок: цвет не читается ни на печати, ни при дальтонизме, и
                                     заводить ради этого третью кисть значило бы уводить взгляд с
                                     того, ради чего таблицу и открыли. -->
                                <DataTrigger Binding="{Binding Change}" Value="ExtraChanged">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="Added">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <!-- Пояснение простым текстом («В ПЛК выставить частоту 55Гц») — не
                                     параметр, и выглядеть как параметр не должно. -->
                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </DataTrigger>
                                <!-- ⚠️ Выделение — ПОСЛЕДНИМ и не просто так: внутри одного стиля
                                     побеждает последний подошедший триггер, а текст на акцентной
                                     заливке обязан быть TextOnAccentBrush. Поставь его выше — и
                                     выделенная изменённая строка стала бы нечитаемой в светлой теме. -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>

                <TextBox Grid.Row="3" x:Name="SummaryText" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="EditBtn" Content="Править…" Width="130" Margin="0,0,8,0" Click="Edit_Click"
                        ToolTip="Правка сохранится новой ревизией: прежняя останется как была"/>
                <Button x:Name="RenameBtn" Content="Поправить «зачем»…" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="EditReason_Click"
                        ToolTip="Единственное, что можно изменить у уже сохранённой ревизии: сами строки — снимок"/>
                <Button x:Name="ColumnsBtn" Content="Свои столбцы…" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Columns_Click"
                        ToolTip="Столбцы сверх обязательных: «Диапазон», «Кем проверено». Заполняются вместе с остальными ячейками"/>
                <Button x:Name="DeleteBtn" Content="Удалить документ" Style="{StaticResource SecondaryButton}"
                        Click="Delete_Click"/>
            </StackPanel>
            <Button Content="Закрыть" Width="110" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
