<Window x:Class="AntarusPoFinder.App.Views.QrPeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="QR на ссылку" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" MaxWidth="420">
        <!-- Белая подложка обязательна: в тёмной теме QR на тёмном фоне телефоном не читается —
             сканеру нужен контраст между модулями и полем вокруг них. -->
        <Border Background="White" Padding="12" CornerRadius="6" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock x:Name="UrlText" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource MutedText}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="Скопировать ссылку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Copy_Click"/>
            <Button Content="Закрыть" Width="100" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
