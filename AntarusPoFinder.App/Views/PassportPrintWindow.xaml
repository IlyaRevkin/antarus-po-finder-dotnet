<Window x:Class="AntarusPoFinder.App.Views.PassportPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Сформировать паспорт"
        Width="620" Height="440" MinWidth="520" MinHeight="380"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <!-- Порядок на экране — порядок действий, ровно как требовалось: «будет окно со строкой ввода
         названия шкафа, программа подставит название в загруженный ранее шаблон, даст проверить
         предпросмотром файла, и кнопки для редактирования или, если всё ок, для печати». Сначала
         шаблон и название, потом одна кнопка «Сформировать», и только после неё появляется блок с
         готовым файлом и кнопками. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                   Text="Шаблон паспорта берётся из общей папки (задаётся в Настройки → Печать). Впишите название шкафа — программа подставит его в копию шаблона и покажет готовый лист."/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Шаблон:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="TemplateCombo" Height="32" DisplayMemberPath="Display"
                      SelectionChanged="Template_Changed"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название шкафа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="NameInput" Height="32" KeyDown="NameInput_KeyDown"
                     TextChanged="NameInput_Changed"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="HintText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>

        <Button Grid.Row="4" x:Name="GenerateButton" Content="Сформировать паспорт" HorizontalAlignment="Left"
                Padding="18,7" Click="Generate_Click"/>

        <!-- Блок готового листа: до первого «Сформировать» его нет вовсе — показывать кнопки
             «Редактировать»/«Печать» раньше, чем есть что редактировать и печатать, значит предлагать
             действие, которое ничего не сделает. -->
        <Border Grid.Row="5" x:Name="ResultPanel" Visibility="Collapsed" Style="{StaticResource CardBorder}"
                Margin="0,14,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Предпросмотр" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Preview_Click"/>
                    <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Edit_Click"/>
                    <Button Content="Печать" Width="110" Click="Print_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
