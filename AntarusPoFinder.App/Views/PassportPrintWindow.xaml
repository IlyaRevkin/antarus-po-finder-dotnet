<Window x:Class="AntarusPoFinder.App.Views.PassportPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Паспорт по шаблону"
        Width="720" Height="540" MinWidth="520" MinHeight="380"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Text="Бланки паспортов, которые не относятся ни к одному типу шкафа — НКУ, Щит СПЛ, ШР. Выберите бланк, впишите название шкафа: оно подставится в документ вместо метки, и лист уйдёт на печать."/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FilterInput" Height="32" Margin="0,0,8,0"
                     TextChanged="Filter_Changed"
                     ToolTip="Отбор по названию бланка, тегу или имени файла"/>
            <TextBlock Grid.Column="1" x:Name="CountLabel" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="TemplatesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource RoomyDataGrid}" MouseDoubleClick="TemplatesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Бланк" Binding="{Binding Name}" Width="*" MinWidth="180"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Теги" Binding="{Binding TagsDisplay}" Width="Auto" MinWidth="120"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Файл" Binding="{Binding FileDisplay}" Width="Auto" MinWidth="120"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Название шкафа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="NameInput" Height="32" KeyDown="NameInput_KeyDown"
                     ToolTip="Что подставить в бланк вместо метки. Enter — напечатать."/>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="HintText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button Content="Печать" Width="110" Margin="0,0,8,0" Click="Print_Click"
                    ToolTip="Подставить название и отправить на печать"/>
            <Button Content="Посмотреть" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Preview_Click"
                    ToolTip="Собрать документ с подставленным названием и открыть его, не печатая"/>
            <Button Content="Открыть бланк" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenTemplate_Click"
                    ToolTip="Открыть сам шаблон — например, чтобы поправить его"/>
            <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFolder_Click"
                    ToolTip="Общая папка бланков — новые появятся у всех машин"/>
            <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
