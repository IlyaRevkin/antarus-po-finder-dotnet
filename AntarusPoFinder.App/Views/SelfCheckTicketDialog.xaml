<Window x:Class="AntarusPoFinder.App.Views.SelfCheckTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Тикет по результатам проверки" Width="760" Height="640" MinWidth="520" MinHeight="400"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Текст уже заполнен" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Здесь всё, что программа выяснила про этот компьютер: версия, роль, как подключён диск, какое правило обновлений сработало, сколько записей в базе ссылается на чужой диск. Можно дописать своими словами — например, что именно не получалось. Пока вы не нажмёте «Создать тикет», ничего не отправляется."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Тип" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="TicketTypeCombo" Width="200" Height="34" DisplayMemberPath="Label"/>
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="BodyInput" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 VerticalContentAlignment="Top" Padding="8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Создать тикет" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
