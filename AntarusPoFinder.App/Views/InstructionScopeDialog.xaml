<Window x:Class="AntarusPoFinder.App.Views.InstructionScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/AntarusPoFinder.App;component/Assets/icon.ico"
        Title="Кому положить эту инструкцию"
        Width="620" Height="560" MinWidth="520" MinHeight="420"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLabel" Grid.Row="0" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- Инструкция описывает ШКАФ, а не конкретную сборку программы: нашли в ней ошибку —
             исправленная нужна всем версиям сразу. Документ кладётся каждой отмеченной версии
             отдельно, в её папку и под её именем: адрес у версии постоянный, и уже наклеенный на
             шкаф QR после замены откроет новый документ по тому же адресу. -->
        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Документ ляжет каждой отмеченной версии отдельно — в её папку и под её именем. Ссылка с наклейки не меняется: по ней откроется новая редакция. Прежняя инструкция версии не пропадёт, она уедет в «Прежние редакции» рядом."/>

        <!-- Галочка СНЯТА по умолчанию намеренно: тихо переписать инструкцию у десятка версий одним
             кликом опаснее, чем лишний раз щёлкнуть. -->
        <CheckBox x:Name="EarlierCheck" Grid.Row="2" Margin="0,0,0,8"
                  Content="Применить ко всем более ранним версиям этого шкафа"
                  ToolTip="Отметит все версии старше выбранной. По умолчанию снята: замена идёт по общему диску, и переписать десяток версий одним кликом должно быть осознанным действием."
                  Checked="Earlier_Changed" Unchecked="Earlier_Changed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Только эта" Style="{StaticResource SecondaryButton}" Width="120" Margin="0,0,8,0" Click="OnlyThis_Click"/>
            <Button Content="Все версии шкафа" Style="{StaticResource SecondaryButton}" Width="150" Click="AllVersions_Click"/>
        </StackPanel>

        <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChecksPanel"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Left" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="ApplyBtn" Content="Положить" Width="110" Click="Apply_Click" IsDefault="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
