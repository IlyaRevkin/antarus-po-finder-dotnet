<UserControl x:Class="AntarusPoFinder.App.Views.NetworkSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Сетевые диски и синхронизация" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
            <!-- Пояснения здесь нарочно короткие: подробности — в ToolTip у самого поля, а не
                 абзацем над ним. Страница настроек не должна читаться как инструкция. -->
            <TextBlock Text="Где лежат файлы и как обновляется общий справочник. Настраивается на каждом компьютере отдельно."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Кнопок «Сохранить» здесь больше нет: путь сохраняется сам — сразу после выбора в
                 «…», по уходу фокуса из поля и по Enter (см. NetworkSyncView.SaveRootPath и соседей).
                 О сохранении сообщает нижняя строка состояния. -->
            <TextBlock Text="ПУТЬ К ДИСКУ (WEBDAV / СЕТЕВАЯ ПАПКА)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RootPathInput" Height="34" Margin="0,0,8,0"
                         LostFocus="RootPath_LostFocus" KeyDown="RootPath_KeyDown"
                         ToolTip="Общий диск с папкой «ПО». Сохраняется сам — по уходу из поля или по Enter."/>
                <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowseRoot_Click"
                        ToolTip="Выбрать папку — сохранится сразу"/>
            </Grid>

            <TextBlock Text="ВТОРОЙ ДИСК (ШКАФЫ И ЭЛЕКТРОСХЕМЫ)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SecondDiskInput" Height="34" Margin="0,0,8,0"
                         LostFocus="SecondDisk_LostFocus" KeyDown="SecondDisk_KeyDown"
                         ToolTip="Папка со шкафами и электросхемами — по ней ищет режим «Схемы»"/>
                <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowseSecondDisk_Click"
                        ToolTip="Выбрать папку — сохранится сразу"/>
            </Grid>


            <!-- Хранилище на хостинге. Ключей на 05.08.2026 ещё нет — карточка сделана так, чтобы их
                 можно было вписать в любой момент позже, без обновления программы: пустые ключи это
                 штатное состояние, выкладка просто не делается. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ХРАНИЛИЩЕ НА ХОСТИНГЕ (S3)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Копия инструкции уходит сюда — по этому адресу она открывается по QR-коду с наклейки с любого телефона, а не только из офисной сети. Пока не загружен файл с ключами доступа, выкладки не происходит и всё работает как прежде."/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Адрес хранилища:" Margin="0,0,0,4"/>
                            <TextBox x:Name="S3EndpointInput" Height="34" Margin="0,0,8,0"
                                     LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"
                                     ToolTip="Напр. https://s3.twcstorage.ru"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Бакет:" Margin="0,0,0,4"/>
                            <TextBox x:Name="S3BucketInput" Height="34" Width="160"
                                     LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Регион:" Margin="0,0,0,4"/>
                            <TextBox x:Name="S3RegionInput" Height="34"
                                     LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"
                                     ToolTip="У Timeweb — ru-1"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Папка внутри бакета (необязательно):" Margin="0,0,0,4"/>
                    <TextBox x:Name="S3PrefixInput" Height="34" Margin="0,0,0,10"
                             LostFocus="S3Field_LostFocus" KeyDown="S3Field_KeyDown"
                             ToolTip="Пусто — раскладка в бакете повторяет раскладку диска один в один."/>

                    <!-- Ключи доступа — файлом, а не полями ввода (просьба Ивана Герасимова от
                         06.08.2026). Ключи приходят от хостинга готовым файлом, и любой ручной ввод
                         здесь — это перепечатывание сорока случайных символов с шансом на опечатку,
                         которая проявится не сразу, а первой несостоявшейся выкладкой. Разбор терпим
                         к формату файла (txt/csv/json/env — см. S3SecretsFile): формат присланного
                         файла мы не выбираем. -->
                    <TextBlock Text="Ключи доступа:" Margin="0,0,0,4"/>
                    <Border x:Name="S3SecretsDropZone" Style="{StaticResource DropZoneBorder}" Height="92" Cursor="Hand"
                            AllowDrop="True" Drop="S3Secrets_Drop" DragOver="S3Secrets_DragOver" MouseLeftButtonUp="S3Secrets_Click"
                            ToolTip="Файл с ключами, который прислал хостинг. Ключи хранятся зашифрованными; секретный ключ — это доступ на запись во весь бакет, поэтому показывается он только в виде «сохранён».">
                        <TextBlock x:Name="S3SecretsLabel" Style="{StaticResource MutedText}" TextAlignment="Center"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                    </Border>
                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Выбрать файл..." Style="{StaticResource SecondaryButton}"
                                Click="S3SecretsBrowse_Click" ToolTip="Выбрать файл с ключами — применится сразу"/>
                        <Button Grid.Column="2" x:Name="S3SecretsClearButton" Content="Убрать ключи" Style="{StaticResource SecondaryButton}"
                                Click="S3SecretsClear_Click" ToolTip="Стереть ключи с этого компьютера. Выкладка остановится, всё остальное продолжит работать."/>
                    </Grid>

                    <CheckBox x:Name="S3PublishCheck" Content="Выкладывать инструкции на хостинг"
                              Margin="0,0,0,8" Click="S3Publish_Click"
                              ToolTip="Снять, чтобы приостановить выкладку, не стирая реквизиты."/>

                    <Button x:Name="S3CheckButton" Content="Проверить доступ" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="S3Check_Click"
                            ToolTip="Спрашивает у бакета список файлов. Право на запись так не проверить — оно проверится первой же выложенной инструкцией."/>
                    <TextBlock x:Name="S3Status" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="ПАПКА ОСМОТРА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Сюда сохраняются сканы, фото по QR и файлы, накопленные во время осмотра оборудования."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InspectionFolderInput" Height="34" Margin="0,0,8,0"
                         LostFocus="InspectionFolder_LostFocus" KeyDown="InspectionFolder_KeyDown"/>
                <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" Width="34" Click="BrowseInspectionFolder_Click"
                        ToolTip="Выбрать папку — сохранится сразу"/>
            </Grid>

            <!-- Автоочистка папки осмотра переехала в саму вкладку "Осмотр" (InspectionView) — логичнее
                 настраивать её там же, где видна сама папка, а не в Сетевых дисках. -->

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ПОЛУЧЕНИЕ ОБНОВЛЕНИЙ КОНФИГА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <!-- Задача 2: раньше здесь был настраиваемый интервал опроса (sync_interval_min) —
                         убран, потому что новая система синхронизации подтягивает изменения сама:
                         маркер ревизии проверяется на фиксированном коротком интервале (см.
                         MainWindowViewModel._revisionPollTimer, ~75 сек) плюс мгновенно по событию
                         изменения файла (FileSystemWatcher на revision.json, best-effort — не на
                         каждой сетевой шаре поддерживается уведомлениями). Настраиваемый интервал
                         делал ровно ту же дешёвую проверку, просто реже и без выигрыша — поле убрано
                         из интерфейса, сама настройка (и таймер, который её ещё уважает) в коде
                         осталась нетронутой на случай отладки. -->
                    <TextBlock Text="Справочник, теги и резервы номеров подтягиваются с диска сами, как только там появляется новая версия."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SyncNowButton" Content="Синхронизировать сейчас" Style="{StaticResource SecondaryButton}" Click="SyncNow_Click" Margin="0,0,12,0"
                                ToolTip="Подстраховка на случай, если диск на минуту отвалился: автоматика и так проверяет обновления регулярно."/>
                        <TextBlock x:Name="LastSyncText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="LastCheckText" Text="" Style="{StaticResource MutedText}" FontStyle="Italic" Margin="0,4,0,0"
                               ToolTip="Обновляется на каждой фоновой проверке, даже если изменений на диске не нашлось — если эта отметка не сдвигается, фоновая проверка не запускается вовсе; если сдвигается, а «Последняя синхронизация» выше — нет, изменений на диске просто не найдено."/>
                    <TextBlock x:Name="RevisionText" Text="" Style="{StaticResource MutedText}" FontStyle="Italic" Margin="0,2,0,0"
                               ToolTip="Ревизия маркера Конфиг\revision.json, которую эта машина уже применила — по ней проверка обновлений понимает, тянуть ли конфиг целиком, без сравнения по часам."/>
                    <StackPanel x:Name="ConflictStatusPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ConflictStatusText" Text="" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Показать и решить" Style="{StaticResource SecondaryButton}" Click="ShowConflicts_Click"/>
                    </StackPanel>

                    <!-- Подробный режим синхронизации — то, что оператор назвал «режимом отладки, чтобы
                         отслеживать, что синхронится, а что нет». Опционально (по умолчанию выкл — без
                         перегруза): когда включён, каждый фоновый тик приёма/отправки/тикетов пишет в
                         статус-строку, ЧТО именно синхронизировалось. Индикатор синхры (пилюля в
                         статус-строке) работает всегда, независимо от этого переключателя. -->
                    <CheckBox x:Name="SyncVerboseCheck" Margin="0,14,0,0" Click="SyncVerbose_Click"
                              Content="Подробный режим синхронизации (писать в статус-строку, что синхронизируется)"
                              ToolTip="Индикатор синхронизации в правом нижнем углу работает всегда, независимо от этого переключателя: крутящиеся стрелки — идёт синхра, оранжевый знак — ошибка, стрелки цветом — есть неотправленное."/>
                </StackPanel>
            </Border>

            <!-- Only administrator sees this — everyone else only pulls, see RefreshIfActive() -->
            <Border x:Name="PushSection" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ОТПРАВКА ИЗМЕНЕНИЙ НА ДИСК" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <!-- Задача 2: интервал ниже (config_push_interval_min) НЕ убран, в отличие от
                         интервала получения выше — он не дублирует ничего автоматического. Каждое
                         изменение справочника (тип шкафа, тег, производитель и т.п.) отправляется на
                         диск сразу же, само по себе (см. MainWindowViewModel.PushCatalogChange) — этот
                         интервал только подстраховка на случай, если тот немедленный пуш не удался
                         (диск был недоступен в момент правки): периодически досылает накопленное. -->
                    <TextBlock Text="Правки справочника уходят на диск сразу. Интервал ниже — только подстраховка: досылает то, что не ушло, пока диск был недоступен."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Каждые" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PushIntervalInput" Width="64" Height="34" Margin="0,0,8,0"
                                 LostFocus="PushInterval_LostFocus" KeyDown="PushInterval_KeyDown"
                                 ToolTip="Целое число минут, 0 — подстраховочная автоотправка отключена (кнопка «Отправить сейчас» всё равно работает). Сохраняется по уходу из поля или по Enter."/>
                        <TextBlock Text="минут" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Отправить сейчас" Style="{StaticResource SecondaryButton}" Click="PushNow_Click" Margin="0,0,12,0"/>
                        <TextBlock x:Name="LastPushText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Эталонная синхронизация (authoritative push) — полная замена справочника у
                         всех получателей, а не аддитивная отправка выше. Опасная, редкая операция,
                         поэтому визуально отделена рамкой ErrorBrush и подтверждается отдельным
                         жёстким диалогом (см. PushAuthoritative_Click) перед самой отправкой. -->
                    <Border BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ЭТАЛОННАЯ СИНХРОНИЗАЦИЯ" Style="{StaticResource MutedText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                       Text="Сделать справочник этой машины (типы шкафов, подтипы, контроллеры, модификации, производители ПЧ/УПП, теги, разрешённые расширения) образцом для всех остальных компьютеров: то, чего здесь нет, будет удалено и у них. Прошивки и файлы параметров не затрагиваются."/>
                            <Button x:Name="PushAuthoritativeButton" Content="Сделать это состояние эталонным для всех"
                                    Style="{StaticResource DangerButton}" Click="PushAuthoritative_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
