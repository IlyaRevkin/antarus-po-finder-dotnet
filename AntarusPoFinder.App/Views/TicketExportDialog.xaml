<Window x:Class="AntarusPoFinder.App.Views.TicketExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Выгрузка тикетов" Width="460" SizeToContent="Height"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Тикеты уедут одним архивом: текст для чтения, тот же список для разбора программой и файлы, приложенные к тикетам. Архив можно унести флешкой, отправить почтой или загрузить на страницу приёма."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Text="ЧТО ВЫГРУЖАТЬ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <RadioButton x:Name="ScopeActive" GroupName="Scope" IsChecked="True" Margin="0,0,0,6"
                     Content="Только открытые и взятые в работу"
                     ToolTip="Закрытые не нужны тому, кто будет чинить — их и так уже разобрали"/>
        <RadioButton x:Name="ScopeAll" GroupName="Scope" Margin="0,0,0,6" Content="Все, что видны на странице"/>
        <RadioButton x:Name="ScopeSelected" GroupName="Scope" Margin="0,0,0,12" Content="Только выделенный тикет"/>

        <CheckBox x:Name="WithAttachmentsCheck" IsChecked="True" Margin="0,0,0,4"
                  Content="Приложить файлы из тикетов"
                  ToolTip="Скриншоты и логи лежат на сетевом диске; без него выгрузятся только тексты"/>
        <TextBlock x:Name="AttachmentsHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Сохранить…" Width="120" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
