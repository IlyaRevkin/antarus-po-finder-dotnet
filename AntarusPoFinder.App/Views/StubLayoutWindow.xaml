<Window x:Class="AntarusPoFinder.App.Views.StubLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Макет заглушки «Инструкция в разработке»"
        Icon="pack://application:,,,/AntarusPoFinder.App;component/Assets/icon.ico"
        Width="900" Height="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,12"
                   Style="{StaticResource MutedText}"
                   Text="Эту страницу видит заказчик, наведя телефон на наклейку, пока инструкции ещё нет. Ссылка постоянная: когда документ допишут, тот же QR откроет его. Справа — что написано и как это выглядит, слева — та самая страница, которая уйдёт в файл."/>

        <!-- Предпросмотр рисуется ТЕМ ЖЕ кодом, что и настоящая заглушка (InstructionStubWriter.Draw):
             разойдись он с ней хоть на отступ — подгонять пришлось бы вслепую. -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ЗАГОЛОВОК" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleInput" Margin="0,0,0,4" TextChanged="Layout_Changed" MaxLength="80"/>
                <TextBlock Text="Размер, % ширины листа" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                <TextBox x:Name="TitleSizeInput" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" TextChanged="Layout_Changed"/>

                <TextBlock Text="ПОЯСНЕНИЕ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="HintInput" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,4" TextChanged="Layout_Changed"/>
                <TextBlock Text="Размер, % ширины листа" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                <TextBox x:Name="HintSizeInput" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" TextChanged="Layout_Changed"/>

                <TextBlock Text="ПОДПИСЬ ВНИЗУ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FooterInput" Margin="0,0,0,4" TextChanged="Layout_Changed" MaxLength="120"
                         ToolTip="Пусто — подпись не печатается."/>
                <TextBlock Text="Размер, % ширины листа" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                <TextBox x:Name="FooterSizeInput" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" TextChanged="Layout_Changed"/>

                <TextBlock x:Name="PlaceholderHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <CheckBox x:Name="FrameCheck" Content="Рамка по краю листа" Margin="0,0,0,8" Click="Layout_Changed"/>
                <TextBlock Text="Серый тон пояснения и подписи (0 — чёрный, 200 — светло-серый)"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBox x:Name="ToneInput" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" TextChanged="Layout_Changed"/>

                <TextBlock Text="ПРЕДПРОСМОТР" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Номер версии, на котором показывать подстановку" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                <TextBox x:Name="SampleVersionInput" Margin="0,0,0,12" TextChanged="Layout_Changed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Вернуть как было" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Reset_Click"/>
            <Button Content="Сохранить" Width="120" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
