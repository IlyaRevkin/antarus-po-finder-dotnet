<Window x:Class="AntarusPoFinder.App.Views.InstructionLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="QR и этикетка"
        Width="900" Height="620" MinWidth="640" MinHeight="460"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <!-- Предпросмотр — тот же самый визуал, который уйдёт на принтер (см. LabelPrinter.BuildLabel):
             отдельной «версии для экрана» нет, иначе напечатанное расходилось бы с показанным.
             Под ним — предупреждения раскладки: настройки мы не запрещаем, но если заданную сторону
             QR или кегль пришлось уменьшить, человек должен видеть это здесь, а не на уже
             напечатанной наклейке. -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BgCardBrush}" CornerRadius="4" Padding="12" Margin="0,8,12,8">
            <DockPanel>
                <Border x:Name="WarningBox" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="LabelHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Макет правится прямо здесь, а не в настройках: подобрать поля так, чтобы принтер ничего
             не срезал, можно только глядя на этикетку. Сохранение — отдельной кнопкой, чтобы разовая
             подгонка под конкретную наклейку не меняла настройку у всех. -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgCardBrush}" CornerRadius="4"
                Padding="12" Margin="0,8,0,8" Width="270">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="МАКЕТ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="Ширина / высота, мм" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBox x:Name="WidthInput" Width="80" TextChanged="Layout_Changed"/>
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="HeightInput" Width="80" TextChanged="Layout_Changed"/>
                    </StackPanel>

                    <!-- Поля по сторонам, а не одно на все четыре: непечатаемая кромка у принтера
                         почти никогда не одинакова, и раньше её перекос приходилось доводить сдвигом
                         всего макета. Порядок полей — как на всех четырёх сторонах наклейки. -->
                    <TextBlock Text="Поля: слева / сверху, мм" Style="{StaticResource MutedText}"
                               ToolTip="Главное средство от обрезанного верха: у принтера этикеток есть непечатаемая кромка, и содержимое должно начинаться после неё. Кнопка «Считать с драйвера принтера» подставляет сюда настоящие кромки."/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <TextBox x:Name="MarginLeftInput" Width="80" TextChanged="Layout_Changed"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="MarginTopInput" Width="80" TextChanged="Layout_Changed"/>
                    </StackPanel>
                    <TextBlock Text="Поля: справа / снизу, мм" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBox x:Name="MarginRightInput" Width="80" TextChanged="Layout_Changed"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="MarginBottomInput" Width="80" TextChanged="Layout_Changed"/>
                    </StackPanel>

                    <TextBlock Text="Поворот содержимого" Style="{StaticResource MutedText}"
                               ToolTip="Для рулонных принтеров: наклейка едет узкой стороной вперёд, и макет надо развернуть, чтобы читался на шкафу правильно. Размер самой наклейки не меняется — её режет высечка."/>
                    <ComboBox x:Name="RotationCombo" Margin="0,2,0,8" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="Без поворота" Tag="None"/>
                        <ComboBoxItem Content="На 90° по часовой" Tag="Clockwise90"/>
                        <ComboBoxItem Content="На 90° против часовой" Tag="CounterClockwise90"/>
                    </ComboBox>

                    <TextBlock Text="Сдвиг X / Y, мм" Style="{StaticResource MutedText}"
                               ToolTip="Если принтер тянет ленту со смещением — двигаем макет целиком, не трогая поля. Настройка этой машины, коллегам не уезжает."/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBox x:Name="OffsetXInput" Width="80" TextChanged="Layout_Changed"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="OffsetYInput" Width="80" TextChanged="Layout_Changed"/>
                    </StackPanel>

                    <!-- Размер наклейки и её кромка уже настроены в свойствах принтера — вбивать их
                         сюда второй раз и подбирать на глаз по обрезанной печати незачем. Кнопка
                         спрашивает драйвер и подставляет размер, поля и сдвиг; всё остальное
                         (кегли, вид кода, подписи) — решение человека, и не трогается. -->
                    <Button Content="Считать с драйвера принтера" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,4" Click="ReadFromPrinter_Click"
                            ToolTip="Взять у выбранного принтера размер листа и непечатаемые края: размер наклейки, поля и сдвиг подставятся сами. Настройки принтера при этом не меняются."/>
                    <TextBlock x:Name="PrinterFitText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Margin="0,0,0,8" Visibility="Collapsed"/>

                    <TextBlock Text="Сторона QR, мм (0 — сам)" Style="{StaticResource MutedText}"/>
                    <TextBox x:Name="QrInput" Width="80" HorizontalAlignment="Left" Margin="0,2,0,8" TextChanged="Layout_Changed"/>

                    <!-- Положение кода и его вид. До сих пор раскладка была одна на всех: код слева,
                         текст колонкой справа. На разных наклейках удобно по-разному, а увидеть, что
                         получилось, всё равно можно только здесь — поэтому обе ручки стоят рядом с
                         предпросмотром. -->
                    <TextBlock Text="Положение кода" Style="{StaticResource MutedText}"
                               ToolTip="Где стоит код относительно названия. «Сам» — как было: слева, а на узкой наклейке над текстом."/>
                    <ComboBox x:Name="QrPlaceCombo" Margin="0,2,0,8" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="Сам" Tag="Auto"/>
                        <ComboBoxItem Content="Слева от текста" Tag="Left"/>
                        <ComboBoxItem Content="Справа от текста" Tag="Right"/>
                        <ComboBoxItem Content="Над текстом" Tag="Above"/>
                        <ComboBoxItem Content="Под текстом" Tag="Below"/>
                    </ComboBox>

                    <TextBlock Text="Вид кода" Style="{StaticResource MutedText}"
                               ToolTip="Форма клеток. На считывание не влияет — сканер берёт пробу в середине клетки. «Классический» — обычная растровая матрица, запасной вариант на случай упрямого сканера; у него нет окошка с подписью в центре."/>
                    <ComboBox x:Name="QrStyleCombo" Margin="0,2,0,8" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="Скруглённый" Tag="Rounded"/>
                        <ComboBoxItem Content="Точками" Tag="Dots"/>
                        <ComboBoxItem Content="Классический" Tag="Classic"/>
                    </ComboBox>

                    <TextBlock Text="Кегль заголовка / ссылки, пт" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBox x:Name="TitlePtInput" Width="80" TextChanged="Layout_Changed"/>
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox x:Name="CaptionPtInput" Width="80" TextChanged="Layout_Changed"/>
                    </StackPanel>

                    <!-- Подпись назначения. Дословная жалоба: «на этикетке нигде не написано, что
                         это инструкция для заказчика — просто QR, название установки и непонятные
                         цифры». Текст правится здесь и в Настройки → Печать, потому что у разных
                         шкафов он разный. По умолчанию — «Руководство по эксплуатации»: документ,
                         который заказчик откроет по коду, называется именно так. -->
                    <CheckBox x:Name="ShowHeadlineCheck" Content="Подпись назначения" Margin="0,0,0,4" Click="Layout_Changed"
                              ToolTip="Строка над кодом, объясняющая, что это за наклейка и зачем её сканировать."/>
                    <TextBox x:Name="HeadlineInput" Margin="0,2,0,8" TextChanged="Layout_Changed" MaxLength="60"
                             ToolTip="Например: «Руководство по эксплуатации — наведите камеру». Не длиннее двух строк на этикетке."/>

                    <TextBlock Text="Положение подписи назначения" Style="{StaticResource MutedText}"
                               ToolTip="«Сам» — подпись идёт первой строкой рядом с кодом и ничего у него не отнимает. «Сверху»/«снизу» — полосой во всю ширину: читается заметнее, но забирает высоту у кода."/>
                    <ComboBox x:Name="HeadlinePlaceCombo" Margin="0,2,0,8" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="Сам" Tag="Auto"/>
                        <ComboBoxItem Content="Полосой сверху" Tag="Top"/>
                        <ComboBoxItem Content="Полосой снизу" Tag="Bottom"/>
                    </ComboBox>

                    <TextBlock Text="Выравнивание подписи" Style="{StaticResource MutedText}"/>
                    <ComboBox x:Name="HeadlineAlignCombo" Margin="0,2,0,8" SelectionChanged="Layout_Changed">
                        <ComboBoxItem Content="По центру" Tag="Center"/>
                        <ComboBoxItem Content="По левому краю" Tag="Left"/>
                        <ComboBoxItem Content="По правому краю" Tag="Right"/>
                    </ComboBox>

                    <!-- Своя строка под названием установки: номер договора, объект, «не снимать».
                         Печатается тем же кеглем, что и версия, и рядом с ней. -->
                    <TextBlock Text="Своя строка под названием" Style="{StaticResource MutedText}"
                               ToolTip="Что дописать на этой наклейке от себя: номер договора, объект, предупреждение. Пусто — строки нет."/>
                    <TextBox x:Name="NoteInput" Margin="0,2,0,8" TextChanged="Layout_Changed" MaxLength="80"/>

                    <TextBlock Text="Подпись в центре кода" Style="{StaticResource MutedText}"
                               ToolTip="До 15 знаков. Длиннее четырёх — верстается в две-три строки: так те же буквы получаются крупнее, потому что плашке расти некуда. Пусто — код без окошка."/>
                    <TextBox x:Name="HoleTextInput" Margin="0,2,0,2"
                             TextChanged="Layout_Changed" MaxLength="15"/>
                    <TextBlock x:Name="HoleHintText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <CheckBox x:Name="ShowLinkCheck" Content="Печатать ссылку текстом" Margin="0,0,0,4" Click="Layout_Changed"
                              ToolTip="Запасной путь, когда телефон код не берёт. На узкой этикетке можно выключить."/>
                    <CheckBox x:Name="ShowFrameCheck" Content="Рамка по краю" Margin="0,0,0,8" Click="Layout_Changed"/>

                    <Button Content="Сохранить как настройки по умолчанию" Style="{StaticResource SecondaryButton}"
                            Margin="0,4,0,4" Click="SaveLayout_Click"
                            ToolTip="Оформление и тексты уедут ко всем машинам: вид и положение кода, кегли, подписи, рамка. Размер наклейки, поля, поворот и сдвиг останутся на этой машине — у каждого принтера они свои."/>
                    <Button Content="Вернуть исходный макет" Style="{StaticResource SecondaryButton}" Click="ResetLayout_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="LinkText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="PrinterText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Ссылка на наклейке ведёт на хостинг, и «а файл-то туда доехал?» — первый вопрос
                 перед печатью. Один запрос по одному ключу: дёшево и отвечает правдой. -->
            <TextBlock x:Name="HostingStateText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       Margin="0,0,10,0" TextWrapping="Wrap"/>
            <Button x:Name="CheckHostingBtn" Content="Проверить на хостинге" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="CheckHosting_Click"/>
            <Button Content="Копировать ссылку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CopyLink_Click"/>
            <Button Content="Печать" Width="120" Margin="0,0,8,0" Click="Print_Click"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
