<Window x:Class="AntarusPoFinder.App.Views.DetachedPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="620" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- Сюда переезжает настоящая панель из настроек — не копия и не второй экземпляр.
                 Поэтому у окна нет ни своей разметки содержимого, ни своих обработчиков. -->
            <ContentControl x:Name="Host"/>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Закрыть" MinWidth="120" Margin="0,14,0,0"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
