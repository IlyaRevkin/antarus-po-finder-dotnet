<Window x:Class="AntarusPoFinder.App.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Antarus"
        Width="820" Height="620" MinWidth="320" MinHeight="240"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <!-- Uniform: содержимое вписывается в окно с сохранением пропорций и масштабируется вместе с
             ним, без искажений и без обрезки. Картинка и видео — два разных элемента: показывается
             всегда ровно один, второй скрыт (см. PhotoViewerWindow.xaml.cs). -->
        <Image x:Name="Photo" Stretch="Uniform" Margin="12" Visibility="Collapsed"
               ToolTipService.ShowDuration="20000" ToolTip="Esc — закрыть  ·  Ctrl+Shift+F4 — закрыть  ·  либо снять «Пасхалку» в диспетчере задач (Finder при этом останется работать)"/>
        <MediaElement x:Name="Video" Stretch="Uniform" Margin="12" Visibility="Collapsed"
                      ToolTipService.ShowDuration="20000" ToolTip="Esc — закрыть  ·  Ctrl+Shift+F4 — закрыть  ·  либо снять «Пасхалку» в диспетчере задач (Finder при этом останется работать)"
                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed"/>

        <!-- Своего крестика здесь больше нет. У окна обычный заголовок Windows со своим крестиком,
             и второй, нарисованный поверх содержимого, стоял ровно под ним — два крестика в одном
             углу. Esc закрывал именно эту кнопку (IsCancel), поэтому обработка Escape переехала в
             Window_PreviewKeyDown рядом со стрелками. -->

        <!-- Перелистывание. Прячется целиком, когда файл в папке один: стрелки «в никуда» только
             сбивают с толку (см. UpdateChrome). -->
        <Button x:Name="PrevButton" Content="‹" Click="Prev_Click"
                Width="40" Height="56" FontSize="24" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0"
                ToolTip="Предыдущее (←)"/>
        <Button x:Name="NextButton" Content="›" Click="Next_Click"
                Width="40" Height="56" FontSize="24" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0"
                ToolTip="Следующее (→)"/>
        <TextBlock x:Name="Counter" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                   Padding="10,4" FontSize="13" Opacity="0.85"
                   Foreground="{DynamicResource FgBrush}"/>

        <!-- Выходы названы прямо в окне. Окно, которое не закрывается крестиком, обязано сказать
             человеку, как из него выйти, — иначе это неотличимо от блокировщика экрана. Полоса
             выглядывает при открытии и при попытке закрыть обычным способом; то же самое висит
             подсказкой при наведении на изображение. -->
        <Border x:Name="HintBar" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="16,10">
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="720"
                       TextAlignment="Center"
                       Text="Esc — закрыть  ·  Ctrl+Shift+F4 — закрыть  ·  либо снять «Пасхалку» в диспетчере задач (Finder при этом останется работать)"/>
        </Border>
    </Grid>
</Window>
