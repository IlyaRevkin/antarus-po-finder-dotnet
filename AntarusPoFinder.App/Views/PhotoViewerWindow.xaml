<Window x:Class="AntarusPoFinder.App.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Antarus"
        Width="820" Height="620" MinWidth="320" MinHeight="240"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <!-- Uniform: содержимое вписывается в окно с сохранением пропорций и масштабируется вместе с
             ним, без искажений и без обрезки. Картинка и видео — два разных элемента: показывается
             всегда ровно один, второй скрыт (см. PhotoViewerWindow.xaml.cs). -->
        <Image x:Name="Photo" Stretch="Uniform" Margin="12" Visibility="Collapsed"/>
        <MediaElement x:Name="Video" Stretch="Uniform" Margin="12" Visibility="Collapsed"
                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed"/>

        <!-- Крестик поверх содержимого; Esc закрывает тем же обработчиком (IsCancel). -->
        <Button Content="✕" Click="Close_Click" IsCancel="True"
                Width="32" Height="32" FontSize="14"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                ToolTip="Закрыть (Esc)"/>
    </Grid>
</Window>
