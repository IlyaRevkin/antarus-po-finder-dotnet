<UserControl x:Class="AntarusPoFinder.App.Views.FirmwareCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AntarusPoFinder.App.Views">
    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
        <StackPanel>
            <!-- Grid, а не горизонтальный StackPanel: у длинного наименования подтипа (напр. полное
                 «шкаф управления пожарными насосами…») в StackPanel'е не было предела ширины — имя и
                 номер версии уезжали за правый край карточки и обрезались в узком окне (жалоба
                 «категория/название не влезает»). Теперь имя в колонке «*» переносится по словам, а
                 номер версии остаётся справа отдельной Auto-колонкой и не обрезается. -->
            <Grid Cursor="Hand" MouseLeftButtonUp="Header_Click"
                  ToolTip="Нажмите, чтобы скопировать номер версии (имя файла на диске)">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="NameLabel" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="VersionLabel" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock x:Name="MetaLabel" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <!-- Что реально лежит рядом с версией (LFS/PSL/HMI/параметры/документы). Раньше это было
                 видно только по тому, есть ли пункт в меню «Ещё» — то есть «есть ли LFS» приходилось
                 выяснять, открыв меню и не найдя там строки. -->
            <TextBlock x:Name="FilesLabel" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <!-- Описания версии на карточке больше нет: у него не было предела по смыслу (несколько
                 строк changelog'а на КАЖДОЙ карточке выдачи), а прочитать его можно там, где оно
                 и осмысленно — «Ещё» → «История версий», где видно ещё и чем версии отличаются. -->
            <views:TagBubbleEditor x:Name="TagsView" Margin="0,4,0,0"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="SoftwareNameLabel" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <Button Grid.Column="1" x:Name="CopyButton" Content="Копировать" Style="{StaticResource SecondaryButton}" Click="Copy_Click"/>
            </Grid>

            <!-- Состояние локальной копии: раньше на её месте была кнопка «Синхронизировать»,
                 теперь копия подтягивается сама (SearchView.AutoSyncMissing), а карточка просто
                 показывает, что с ней происходит. Ручная синхронизация осталась в меню «Ещё». -->
            <TextBlock x:Name="SyncStatusLabel" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <WrapPanel x:Name="ActionsPanel" Margin="0,8,0,0"/>

            <Popup x:Name="MorePopup" StaysOpen="False" AllowsTransparency="True"
                   Placement="Bottom" HorizontalOffset="0" VerticalOffset="2">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="6" Padding="6">
                    <StackPanel x:Name="MorePanel" MinWidth="230"/>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
