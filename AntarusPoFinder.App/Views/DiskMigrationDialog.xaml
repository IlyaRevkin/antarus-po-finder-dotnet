<Window x:Class="AntarusPoFinder.App.Views.DiskMigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Перестроить структуру диска"
        Width="900" Height="620" MinWidth="640" MinHeight="480"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Приводит уже накопленный диск к текущим правилам: имя файла прошивки = имя папки версии, имена инструкций и заглушки. Сначала посмотрите план, выполнение — отдельной кнопкой."/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox x:Name="RenameCheck" IsChecked="True" Margin="0,0,0,4"
                      Content="Переименовать файлы прошивок в каноническое имя"
                      ToolTip="Переименовываются только папки версий, где лежит ровно один файл: в многофайловой папке имя файла привязано к подсказке «чем открывать», и у коллег она не обновится."/>
            <!-- Текст галочки — TextBlock, а не строка в Content: у ContentPresenter в шаблоне
                 CheckBox RecognizesAccessKey=True, и «инструкция_&lt;версия&gt;» отрисовалось бы как
                 «инструкция&lt;версия&gt;» — подчёркивание съедается как метка горячей клавиши, а вместе
                 с ним пропадает ровно то имя файла, о котором пункт и говорит. Поймано живым
                 прогоном; тесты такого увидеть не могут. -->
            <CheckBox x:Name="InstructionNamingCheck" IsChecked="True" Margin="0,0,0,4"
                      ToolTip="Переименовываются только файлы в папках «Инструкция» внутри версии — там понятно, какой версии принадлежит документ. В общей папке контроллера инструкция принадлежит всем его версиям сразу, её имя не трогаем. Заглушка настоящей инструкцией не считается и исчезает, как только документ приложат.">
                <TextBlock Text="Инструкции: имя файла «инструкция_&lt;версия&gt;» и заглушка «Инструкция в разработке»"
                           TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox x:Name="FoldersCheck" IsChecked="True" Margin="0,0,0,4"
                      Content="Создать недостающие папки структуры (Инструкция, Карта ВВ, Карта Modbus, HMI, ОПЦ, Паспорт)"/>
            <CheckBox x:Name="FoldIntoVersionCheck" Margin="0,0,0,4"
                      Content="Собрать файлы прошивок в подпапку «Прошивка» внутри папки версии"
                      ToolTip="Имя самой папки версии не меняется, поэтому у коллег ничего не ломается: программа ищет файлы и в «Прошивка», и в корне папки версии."/>
            <CheckBox x:Name="OpcCheck" Margin="0,0,0,4"
                      Content="Перенести ОПЦ внутрь контроллера, назвав папки номером заявки / SN"
                      ToolTip="Единственная операция, которая меняет путь версии в базе. У коллег путь обновится не синхронизацией, а кнопкой «Найти переехавшие ОПЦ» на этой же странице настроек."/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Две последние галочки — переезд данных. Запускать на ОДНОЙ машине, когда никто не заливает прошивки, и только после того, как у всех обновилась программа: старый клиент видит только прежнюю раскладку."/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="PlanButton" Content="Показать план" Width="150" Margin="0,0,8,0" Click="Plan_Click"/>
            <Button x:Name="RunButton" Content="Выполнить" Width="130" Margin="0,0,8,0" IsEnabled="False" Click="Run_Click"/>
            <Button Content="Сохранить план в файл" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Click="SavePlan_Click"/>
            <!-- Ручной разбор плана: делать не «всё, что предложено», а то, что оператор отметил.
                 До этого выбор был только категориями, и одна спорная строка заставляла выключать
                 весь пункт целиком. -->
            <Button Content="Отметить все" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SelectAll_Click"/>
            <Button Content="Снять все" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SelectNone_Click"/>
            <Button x:Name="PickFileButton" Content="Указать файл прошивки…" Style="{StaticResource SecondaryButton}"
                    Click="PickFirmware_Click"
                    ToolTip="Для строки, где в папке версии несколько файлов: указать, какой из них прошивка, — и она будет переименована по норме."/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="OpsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource RoomyDataGrid}" CanUserResizeColumns="True"
                  MouseDoubleClick="OpsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Делать" Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanRun}"
                                      Checked="RowSelection_Changed" Unchecked="RowSelection_Changed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Что" Binding="{Binding KindLabel}" Width="Auto" MinWidth="170"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Подробности" Binding="{Binding Note}" Width="*" MinWidth="220"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Где" Binding="{Binding Source}" Width="2*" MinWidth="220"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Итог" Binding="{Binding StatusLabel}" Width="Auto" MinWidth="90"
                                    ElementStyle="{StaticResource DataGridCellTextCentered}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" x:Name="SummaryText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
