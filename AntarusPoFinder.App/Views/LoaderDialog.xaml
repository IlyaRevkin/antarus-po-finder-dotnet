<Window x:Class="AntarusPoFinder.App.Views.LoaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Загрузка через Segnetics Loader"
        Width="540" MinWidth="460" MinHeight="320" MaxHeight="760"
        SizeToContent="Height" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <!-- Окно операции намеренно КОМПАКТНОЕ и стартует само (см. LoaderDialog.xaml.cs): файл уже
         выбран карточкой, второе нажатие «Загрузить» ничего не решало. Всё, что нужно не всегда —
         выбор другого файла, подготовка ПЛК, журнал — убрано под «Дополнительно»/«Подробности».

         MinHeight есть, а MinWidth был всегда: окно тянется мышью, и по высоте его можно было
         сжать в полоску, за которой не видно ни хода заливки, ни кнопок. Высота подбирается по
         содержимому (SizeToContent), поэтому нижняя граница нужна только на случай ручного
         перетаскивания — и равна примерно тому, что занимает окно в самом свёрнутом виде. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderLabel" Style="{StaticResource TitleText}"
                   TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- Имя файла подписью, а не полем ввода: полный путь — в подсказке при наведении,
             сменить файл можно в «Дополнительно» ниже. -->
        <!-- ЧТО ЗА ОБЪЕКТ — в шапке, рядом с именем файла, а не мелочью в строке состояния внизу.
             Это главный ответ на вопрос «куда я сейчас лью», и читать его надо сверху, вместе с
             названием версии. Значок на полосе ниже — то же самое боковым зрением. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Border x:Name="MotifChip" Visibility="Collapsed" CornerRadius="10" Padding="10,2"
                    Margin="0,0,10,0" BorderThickness="1">
                <TextBlock x:Name="MotifLabel" FontWeight="SemiBold" FontSize="11"/>
            </Border>
            <TextBlock x:Name="SourceLabel" Style="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" x:Name="UnavailableBanner" Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Segnetics Loader Automation недоступен"
                           FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="UnavailableReasonLabel" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Полоса в мотиве оборудования: у насосной станции она «наливается» своим цветом, у
                 канализационной — своим, у теплового пункта — тёплым. Это не украшение: заливка идёт
                 минуты, и всё это время на экране должно быть видно, ЧТО шьётся, а не только
                 проценты. Значок и подпись рядом — чтобы прочитать можно было и прямо, не только
                 боковым зрением. Незнакомое оборудование выглядит ровно как раньше. -->
            <!-- СХЕМА ОБЪЕКТА — два готовых знака и труба между ними.
                 Рисовать схему путями в коде не вышло четыре раза подряд («стилизации мало», «та
                 что есть кривая», «какой-то крест нарисован»), поэтому знаки взяты из Material
                 Symbols (см. EquipmentMotifArt), а вся «графика» здесь — прямая труба со стрелкой.
                 Каждый знак масштабируется в своём месте, поэтому пропорции не ломаются. -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MotifScheme"
                        Orientation="Horizontal" Visibility="Collapsed"
                        VerticalAlignment="Center" Margin="0,2,0,12">
                <Path x:Name="MotifSceneFrom" Width="34" Height="34" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <Path x:Name="MotifPipe" Width="72" Height="22" Stretch="Uniform" Margin="10,0"
                      VerticalAlignment="Center" StrokeThickness="2" Opacity="0.75"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M0,11 L60,11 M52,5 L60,11 L52,17"/>
                <Path x:Name="MotifSceneTo" Width="34" Height="34" Stretch="Uniform"
                      VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- ⚠️ ОБВОДКА, а не заливка: фигуры нарисованы контурами (корпус насоса — окружность,
                     волны тепла — линии), и Fill превращал их в бесформенное пятно. Именно это
                     выглядело «кривой стилизацией». Размер 24, а не 18: на 18 пикселях рисунок не
                     читается вовсе, а он здесь ради того, чтобы читаться боковым зрением. -->
                <Path Grid.Column="0" x:Name="MotifIcon" Width="24" Height="24" Margin="0,0,10,0"
                      Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed"
                      StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Grid Grid.Column="1">
                    <!-- ПОЛОСА-НАСОС (стиль FlowProgressBar): слева вращается рабочее колесо, по
                         трубе идут струи, заполненная часть — прокачанное. Раньше здесь был свой
                         бегущий блик поверх обычной полосы; он ничего не говорил («было бы круто
                         типа гидрант качает воду, а не волна») и к тому же жил отдельной копией
                         анимации, которую приходилось заводить и останавливать руками. Один стиль
                         на окно загрузки и на строку состояния — одно движение в обоих местах. -->
                    <ProgressBar x:Name="Progress" Style="{StaticResource FlowProgressBar}"
                                 Height="22" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{DynamicResource AccentBrush}"/>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PercentLabel"
                       VerticalAlignment="Center" Margin="10,0,0,0" Text=""/>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="StageLabel" Style="{StaticResource MutedText}" Text="Запуск…"/>

                <TextBlock x:Name="ElapsedLabel" Style="{StaticResource MutedText}"
                           Margin="16,0,0,0" FontFamily="Consolas" Text="00:00"
                           Visibility="Collapsed">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="2"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Подготовка ПЛК применяется по ЗАПОМНЕННОЙ настройке (авто-старт ничего не спрашивает) —
             поэтому она обязана быть видна оператору отдельной строкой, а не только галкой внутри
             свёрнутого блока. -->
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="PreparationLabel" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

            <!-- Что будет, если нажать «Остановить». Окно больше не запирает программу, поэтому
                 оператор вполне может уйти в поиск и вернуться сюда через полминуты — он обязан
                 видеть, безопасно ли обрывать ЭТУ операцию, а не помнить это наизусть.
                 Текст считает LongOperationRules.CancelWarning / CancelHint. -->
            <Border x:Name="CancelPolicyBox" Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                <TextBlock x:Name="CancelPolicyLabel" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </Border>

            <!-- Что делать руками после провала. Появляется вместе с кнопкой «Повторить попытку»:
                 самая частая причина отказа Loader — не программа, а обвязка ПЛК (см. code-behind). -->
            <Border x:Name="FailureHintBox" Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="FailureHintLabel" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <!-- Действие прямо здесь, а не «сходите в настройки». По журналам заливок видно,
                         как человек жмёт «Повторить» по пятнадцать раз подряд с одной и той же
                         ошибкой: подсказка без кнопки читается как общие слова. -->
                    <Button x:Name="SwitchConnectionBtn" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
                            Click="SwitchConnection_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <Expander x:Name="AdvancedExpander" Style="{StaticResource SectionExpander}" Margin="0,0,0,4">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AdvancedArrow" Text="▸" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ДОПОЛНИТЕЛЬНО" Style="{StaticResource MutedText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="20,0,0,6">
                    <CheckBox x:Name="PrepareControllerCheck"
                              Content="Форматировать проект и обновить ядро"
                              Margin="0,0,0,6"
                              ToolTip="Перед загрузкой Loader отформатирует проект и обновит ядро ПЛК по сохранённым настройкам подключения и прошивки. Значение запоминается и применяется при следующем запуске автоматически."/>
                    <TextBlock x:Name="AdvancedSourceLabel" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ChangeSourceBtn" Content="Выбрать другой файл…"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Click="ChangeSource_Click"/>
                        <Button x:Name="RestartBtn" Content="Запустить заново"
                                Style="{StaticResource SecondaryButton}" Click="Restart_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="DetailsExpander" Style="{StaticResource SectionExpander}" Margin="0,0,0,8">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DetailsArrow" Text="▸" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ПОДРОБНОСТИ" Style="{StaticResource MutedText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <Border Style="{StaticResource CardBorder}" Margin="20,0,0,0">
                    <RichTextBox x:Name="LogBox" Height="150"
                                 IsReadOnly="True" IsDocumentEnabled="False"
                                 BorderThickness="0" Padding="0"
                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="False">
                        <FlowDocument x:Name="LogDocument" PagePadding="0"/>
                    </RichTextBox>
                </Border>
            </Expander>
        </StackPanel>

        <!-- Внизу во время работы — «Свернуть» и «Остановить», после — «Закрыть».
             Рабочая папка и сохранение лога нужны только по итогу и живут в одном меню «…».
             «Свернуть» появилось вместе с немодальностью: окно больше не запирает программу, но
             всё ещё держится поверх главного (Owner), а искать за ним карточку прошивки неудобно.
             Свёрнутое окно остаётся кнопкой на панели задач — то есть операция не теряется. -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="MoreBtn" Content="…" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="More_Click"
                    ToolTip="Рабочая папка операции и сохранение журнала">
                <Button.ContextMenu>
                    <ContextMenu x:Name="MoreMenu">
                        <MenuItem x:Name="OpenWorkspaceItem" Header="Рабочая папка" Click="OpenWorkspace_Click"/>
                        <MenuItem x:Name="SaveLogItem" Header="Сохранить журнал…" Click="SaveLog_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!-- «Повторить попытку» стоит рядом с «Закрыть», а не в свёрнутом «ДОПОЛНИТЕЛЬНО»:
                 после отказа Loader повтор — первое, что делают, и искать его под стрелочкой нельзя. -->
            <Button x:Name="RetryBtn" Content="Повторить попытку" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="Restart_Click"/>
            <Button x:Name="MinimizeBtn" Content="Свернуть" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="Minimize_Click"
                    ToolTip="Убрать окно с глаз — операция продолжится, ход виден внизу главного окна"/>
            <Button x:Name="StopBtn" Content="Остановить" Style="{StaticResource SecondaryButton}"
                    Click="Stop_Click"/>
            <Button x:Name="CloseBtn" Content="Закрыть" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Visibility="Collapsed" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
