<Window x:Class="AntarusPoFinder.App.Views.LoaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Загрузка через Segnetics Loader" Width="760" Height="610" MinWidth="620" MinHeight="500"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderLabel" Style="{StaticResource TitleText}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Border Grid.Row="1" x:Name="UnavailableBanner" Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Segnetics Loader Automation недоступен"
                           FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="UnavailableReasonLabel" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ПАРАМЕТРЫ ЗАГРУЗКИ" Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Файл:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="SourceInput" Height="32" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="BrowseSourceBtn" Content="Обзор…"
                            Style="{StaticResource SecondaryButton}" Click="BrowseSource_Click"/>
                </Grid>

                <CheckBox x:Name="PrepareControllerCheck"
                          Content="Форматировать проект и обновить ядро"
                          ToolTip="Перед загрузкой Loader отформатирует проект и обновит ядро ПЛК по сохранённым настройкам подключения и прошивки."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Row="0" Grid.Column="0" x:Name="Progress"
                         Height="16" Minimum="0" Maximum="100" Value="0"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgInputBrush}"
                         BorderBrush="{DynamicResource BorderBrush2}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PercentLabel"
                       VerticalAlignment="Center" Margin="10,0,0,0" Text=""/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="StageLabel" Style="{StaticResource MutedText}"
                           Text="Готов к запуску"/>
                <TextBlock x:Name="ElapsedLabel" Style="{StaticResource MutedText}"
                           Margin="24,0,0,0" FontFamily="Consolas" Text="00:00"
                           Visibility="Collapsed">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="2"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ЛОГ ОПЕРАЦИИ" Style="{StaticResource MutedText}"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <RichTextBox Grid.Row="1" x:Name="LogBox"
                             IsReadOnly="True" IsDocumentEnabled="False"
                             BorderThickness="0" Padding="0"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             SpellCheck.IsEnabled="False">
                    <FlowDocument x:Name="LogDocument" PagePadding="0"/>
                </RichTextBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenWorkspaceBtn" Content="Рабочая папка" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" IsEnabled="False" Click="OpenWorkspace_Click"
                    ToolTip="Локальная папка операции: копия проекта и лог Searcher"/>
            <Button x:Name="SaveLogBtn" Content="Сохранить лог…" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" IsEnabled="False" Click="SaveLog_Click"/>
            <Button x:Name="StopBtn" Content="Остановить" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" IsEnabled="False" Click="Stop_Click"/>
            <Button x:Name="RunBtn" Content="Загрузить" Margin="0,0,8,0" Click="Run_Click"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
