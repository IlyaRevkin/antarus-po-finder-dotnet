<Window x:Class="AntarusPoFinder.App.Views.LoaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Загрузка через Segnetics Loader"
        Width="540" MinWidth="460" MaxHeight="760"
        SizeToContent="Height" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <!-- Окно операции намеренно КОМПАКТНОЕ и стартует само (см. LoaderDialog.xaml.cs): файл уже
         выбран карточкой, второе нажатие «Загрузить» ничего не решало. Всё, что нужно не всегда —
         выбор другого файла, подготовка ПЛК, журнал — убрано под «Дополнительно»/«Подробности». -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderLabel" Style="{StaticResource TitleText}"
                   TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- Имя файла подписью, а не полем ввода: полный путь — в подсказке при наведении,
             сменить файл можно в «Дополнительно» ниже. -->
        <TextBlock Grid.Row="1" x:Name="SourceLabel" Style="{StaticResource MutedText}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

        <Border Grid.Row="2" x:Name="UnavailableBanner" Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Segnetics Loader Automation недоступен"
                           FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="UnavailableReasonLabel" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Row="0" Grid.Column="0" x:Name="Progress"
                         Height="14" Minimum="0" Maximum="100" Value="0"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgInputBrush}"
                         BorderBrush="{DynamicResource BorderBrush2}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PercentLabel"
                       VerticalAlignment="Center" Margin="10,0,0,0" Text=""/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="StageLabel" Style="{StaticResource MutedText}" Text="Запуск…"/>
                <TextBlock x:Name="ElapsedLabel" Style="{StaticResource MutedText}"
                           Margin="16,0,0,0" FontFamily="Consolas" Text="00:00"
                           Visibility="Collapsed">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="2"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Подготовка ПЛК применяется по ЗАПОМНЕННОЙ настройке (авто-старт ничего не спрашивает) —
             поэтому она обязана быть видна оператору отдельной строкой, а не только галкой внутри
             свёрнутого блока. -->
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="PreparationLabel" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

            <!-- Что делать руками после провала. Появляется вместе с кнопкой «Повторить попытку»:
                 самая частая причина отказа Loader — не программа, а обвязка ПЛК (см. code-behind). -->
            <Border x:Name="FailureHintBox" Style="{StaticResource CardBorder}" Margin="0,0,0,8"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                <TextBlock x:Name="FailureHintLabel" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <Expander x:Name="AdvancedExpander" Style="{StaticResource SectionExpander}" Margin="0,0,0,4">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AdvancedArrow" Text="▸" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ДОПОЛНИТЕЛЬНО" Style="{StaticResource MutedText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="20,0,0,6">
                    <CheckBox x:Name="PrepareControllerCheck"
                              Content="Форматировать проект и обновить ядро"
                              Margin="0,0,0,6"
                              ToolTip="Перед загрузкой Loader отформатирует проект и обновит ядро ПЛК по сохранённым настройкам подключения и прошивки. Значение запоминается и применяется при следующем запуске автоматически."/>
                    <TextBlock x:Name="AdvancedSourceLabel" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ChangeSourceBtn" Content="Выбрать другой файл…"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Click="ChangeSource_Click"/>
                        <Button x:Name="RestartBtn" Content="Запустить заново"
                                Style="{StaticResource SecondaryButton}" Click="Restart_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="DetailsExpander" Style="{StaticResource SectionExpander}" Margin="0,0,0,8">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DetailsArrow" Text="▸" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="ПОДРОБНОСТИ" Style="{StaticResource MutedText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <Border Style="{StaticResource CardBorder}" Margin="20,0,0,0">
                    <RichTextBox x:Name="LogBox" Height="150"
                                 IsReadOnly="True" IsDocumentEnabled="False"
                                 BorderThickness="0" Padding="0"
                                 Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="False">
                        <FlowDocument x:Name="LogDocument" PagePadding="0"/>
                    </RichTextBox>
                </Border>
            </Expander>
        </StackPanel>

        <!-- Внизу максимум две кнопки: пока идёт работа — «Остановить», после — «Закрыть».
             Рабочая папка и сохранение лога нужны только по итогу и живут в одном меню «…». -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="MoreBtn" Content="…" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="More_Click"
                    ToolTip="Рабочая папка операции и сохранение журнала">
                <Button.ContextMenu>
                    <ContextMenu x:Name="MoreMenu">
                        <MenuItem x:Name="OpenWorkspaceItem" Header="Рабочая папка" Click="OpenWorkspace_Click"/>
                        <MenuItem x:Name="SaveLogItem" Header="Сохранить журнал…" Click="SaveLog_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!-- «Повторить попытку» стоит рядом с «Закрыть», а не в свёрнутом «ДОПОЛНИТЕЛЬНО»:
                 после отказа Loader повтор — первое, что делают, и искать его под стрелочкой нельзя. -->
            <Button x:Name="RetryBtn" Content="Повторить попытку" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="Restart_Click"/>
            <Button x:Name="StopBtn" Content="Остановить" Style="{StaticResource SecondaryButton}"
                    Click="Stop_Click"/>
            <Button x:Name="CloseBtn" Content="Закрыть" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Visibility="Collapsed" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
