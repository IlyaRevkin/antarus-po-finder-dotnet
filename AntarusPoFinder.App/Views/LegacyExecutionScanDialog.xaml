<Window x:Class="AntarusPoFinder.App.Views.LegacyExecutionScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/AntarusPoFinder.App;component/Assets/icon.ico"
        Title="Осмотр старой раскладки исполнений"
        Width="820" Height="600" MinWidth="560" MinHeight="400"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВРЕМЕННЫЙ ИНСТРУМЕНТ. Только смотрит: ни одного файла и ни одной записи не трогает.
             Сведение старых записей-исполнений в одну версию — ручное решение человека, и машина
             имеет право только предложить группу-кандидата (см. LegacyExecutionScan). -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Что осталось от прежней модели исполнений, где каждое исполнение было отдельной прошивкой со своим номером. Этот осмотр ничего не меняет: он показывает, что нашёл и что предлагает, а решение принимаете вы."/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </Border>

        <TextBox Grid.Row="2" x:Name="ReportText" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить отчёт…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
