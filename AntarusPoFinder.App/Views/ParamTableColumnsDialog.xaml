<Window x:Class="AntarusPoFinder.App.Views.ParamTableColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Свои столбцы документа"
        Width="620" Height="470" MinWidth="520" MinHeight="380"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Intro" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                   Text="Столбцы сверх обязательных: «Диапазон», «Кем проверено», что угодно ещё. Они появятся в таблице документа справа от встроенных, заполняются там же, где остальные ячейки, и уезжают к коллегам вместе с документом."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="ColumnsList" SelectionChanged="Selection_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="2" Width="180">
                <Button x:Name="AddBtn" Content="Добавить столбец…" Margin="0,0,0,8" Click="Add_Click"/>
                <Button x:Name="RenameBtn" Content="Переименовать…" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,0,8" Click="Rename_Click"
                        ToolTip="Меняется только заголовок: значения, уже записанные в этот столбец, останутся на месте"/>
                <Button x:Name="UpBtn" Content="Выше" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="Up_Click"/>
                <Button x:Name="DownBtn" Content="Ниже" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="Down_Click"/>
                <Button x:Name="RemoveBtn" Content="Убрать столбец" Style="{StaticResource SecondaryButton}" Click="Remove_Click"/>
            </StackPanel>
        </Grid>

        <!-- Оговорка стоит рядом с кнопкой «Убрать», а не в подтверждении: человек читает её ДО
             того, как решил убирать, и не пугается задним числом. -->
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                   Text="Убранный столбец пропадает из новых редакций, но не из старых: ревизия — снимок, и то, что в ней было записано, остаётся видно. Заведите столбец с тем же названием снова — он вернётся вместе с содержимым."/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountLabel" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <!-- Кнопка закрытия НИЧЕГО не сохраняет и обработчика не имеет: правки здесь записываются
                 сразу, а окно закрывают и крестиком тоже. Что менялось, окно-владелец узнаёт по
                 свойству Changed, а не по DialogResult. -->
            <Button Content="Закрыть" Width="110" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
