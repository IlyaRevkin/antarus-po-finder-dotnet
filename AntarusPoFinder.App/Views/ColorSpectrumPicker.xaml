<UserControl x:Class="AntarusPoFinder.App.Views.ColorSpectrumPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Квадрат «насыщенность × яркость». Собран тремя слоями, как и везде, где рисуют спектр:
             снизу чистый оттенок, поверх белая заливка слева направо (бледнее), поверх чёрная
             сверху вниз (темнее). Рисовать попиксельно незачем — градиенты это и есть. -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}" CornerRadius="4"
                SnapsToDevicePixels="True">
            <Grid x:Name="SvArea" Height="150" Width="240" ClipToBounds="True"
                  Background="{DynamicResource BgCardBrush}"
                  MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp">
                <Rectangle x:Name="HueLayer"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000"/>
                            <GradientStop Offset="1" Color="#FF000000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Маркер — кольцо с белой и чёрной обводкой: одноцветное терялось бы то на светлой,
                     то на тёмной половине квадрата. -->
                <Ellipse x:Name="SvThumb" Width="14" Height="14" IsHitTestVisible="False"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Stroke="White" StrokeThickness="2"/>
                <Ellipse Width="18" Height="18" IsHitTestVisible="False"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Stroke="#60000000" StrokeThickness="1"
                         Margin="{Binding Margin, ElementName=SvThumb}"/>
            </Grid>
        </Border>

        <!-- Радужная полоса — выбор оттенка. -->
        <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}" CornerRadius="4"
                Margin="0,8,0,0" SnapsToDevicePixels="True">
            <Grid x:Name="HueArea" Height="20" Width="240" ClipToBounds="True"
                  MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Hue_MouseUp">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.000" Color="#FF0000"/>
                            <GradientStop Offset="0.167" Color="#FFFF00"/>
                            <GradientStop Offset="0.333" Color="#00FF00"/>
                            <GradientStop Offset="0.500" Color="#00FFFF"/>
                            <GradientStop Offset="0.667" Color="#0000FF"/>
                            <GradientStop Offset="0.833" Color="#FF00FF"/>
                            <GradientStop Offset="1.000" Color="#FF0000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="HueThumb" Width="4" IsHitTestVisible="False"
                           HorizontalAlignment="Left" Fill="White" Stroke="#80000000" StrokeThickness="1"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
