<UserControl x:Class="AntarusPoFinder.App.Views.NewVersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AntarusPoFinder.App.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Название страницы, пункта сайдбара и пункта «Модерация прошивки» в меню «Ещё» карточки
             поиска специально одно и то же: все три открывают ОДНО И ТО ЖЕ окно (EditFirmwareDialog),
             и разные имена у одного окна оператора только путали. -->
        <TextBlock Grid.Row="0" Text="Модерация прошивок" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Загруженные версии ждут здесь, чтобы им проставили теги/описание, при необходимости поправили подтипы шкафов и подтвердили релиз. Двойной клик по строке или кнопка «Открыть». Откатанные и уже заменённые более свежей версией сюда не попадают."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <DataGrid Grid.Row="2" x:Name="RecentGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  MouseDoubleClick="RecentGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="80"/>
                <DataGridTextColumn Header="Подтип" Binding="{Binding SubtypeName}" Width="100"/>
                <DataGridTextColumn Header="Контроллер" Binding="{Binding CtrlName}" Width="120"/>
                <DataGridTemplateColumn Header="Версия" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <views:CopyableVersionText Text="{Binding VersionRaw}" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="100"/>
                <DataGridTextColumn Header="Теги" Binding="{Binding TagsDisplay}" Width="140"/>
                <!-- Столбца «Статус» здесь больше нет: в списке остались только текущие активные
                     версии, и он всегда показывал бы одно и то же «Текущая». -->
                <DataGridTemplateColumn Header="" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Открыть" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                    Click="EditTagsButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
