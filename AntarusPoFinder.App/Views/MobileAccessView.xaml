<UserControl x:Class="AntarusPoFinder.App.Views.MobileAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Мобильный доступ" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,20"
                       Text="Поиск прошивки и её актуальная версия — с телефона, пока он в одной сети с этим компьютером. Адрес постоянный: телефон достаточно один раз добавить в закладки, сканировать код каждый раз не нужно."/>

            <CheckBox x:Name="EnabledCheck" Margin="0,0,0,16"
                      Content="Отдавать страницу на телефон, пока программа открыта"
                      Checked="Enabled_Changed" Unchecked="Enabled_Changed"
                      ToolTip="Пока выключено, программа не слушает сеть вовсе"/>

            <TextBlock Text="АДРЕС ДЛЯ ТЕЛЕФОНА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="UrlBox" Height="34" Margin="0,0,8,0" IsReadOnly="True"
                         ToolTip="Введите этот адрес в браузере телефона и добавьте в закладки"/>
                <Button Grid.Column="1" x:Name="CopyButton" Content="Копировать"
                        Style="{StaticResource SecondaryButton}" Click="Copy_Click"/>
            </Grid>

            <TextBlock x:Name="StateText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- QR остаётся как удобство на первый раз: вбить руками адрес с токеном на телефоне
                 долго и легко ошибиться. Но он больше не обязателен к каждой сессии — именно это
                 и просил Илья. -->
            <Image x:Name="QrImage" Width="200" Height="200" HorizontalAlignment="Left" Margin="0,0,0,16"
                   Stretch="Uniform" SnapsToDevicePixels="True"/>

            <Button x:Name="ResetButton" Content="Сменить адрес" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="Reset_Click" Margin="0,0,0,20"
                    ToolTip="Выдать новый токен. Прежние закладки и коды перестанут работать"/>

            <TextBlock Text="ЧЕГО ЭТА СТРАНИЦА НЕ УМЕЕТ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Телефон видит базу только пока этот компьютер включён и находится с ним в одной сети. Параметров ПЧ/УПП, карт входов-выходов и заведения багов здесь пока нет — они появятся после того, как станет понятно, что доступ живёт на объекте."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
