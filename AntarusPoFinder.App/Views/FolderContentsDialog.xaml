<Window x:Class="AntarusPoFinder.App.Views.FolderContentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Что взять из папки"
        Width="760" Height="560" MinWidth="560" MinHeight="400"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LabelText" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
            <TextBlock x:Name="FolderText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </Border>

        <!-- Две отметки на строку, и они разные: «прошивка» — ровно одна на всю папку (её и
             переименуют в номер версии), «взять» — сколько угодно. Поэтому колонка «прошивка»
             ведёт себя как переключатель: код-behind снимает её у остальных строк. -->
        <DataGrid Grid.Row="2" x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  Style="{StaticResource RoomyDataGrid}" CanUserResizeColumns="True"
                  MouseDoubleClick="FilesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Прошивка" Width="Auto" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="Main_Checked" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="Этот файл и есть прошивка: он ляжет в папку «Прошивка» под именем версии."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Взять" Width="Auto" MinWidth="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Take, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="Скопировать этот файл рядом с прошивкой, со своим именем."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Файл" Width="3*" MinWidth="220" SortMemberPath="RelativePath">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativePath}" ToolTip="{Binding RelativePath}"
                                       Style="{StaticResource DataGridCellText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeLabel}" Width="Auto" MinWidth="70"
                                    IsReadOnly="True" ElementStyle="{StaticResource DataGridCellTextCentered}"/>
                <DataGridTemplateColumn Header="Примечание" Width="2*" MinWidth="140" SortMemberPath="Note">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Note}" ToolTip="{Binding Note}"
                                       Style="{StaticResource DataGridCellText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="SummaryText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Только прошивку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="OnlyFirmware_Click"
                        ToolTip="Снять отметки «взять» со всех файлов — поедет одна прошивка."/>
                <Button Content="Взять всё" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="TakeAll_Click"
                        ToolTip="Отметить все файлы, кроме служебного мусора, — папка поедет целиком."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="90"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="ОК" Width="90" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
