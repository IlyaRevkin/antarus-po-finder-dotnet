<UserControl x:Class="AntarusPoFinder.App.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Тикеты" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="ScopeHintText" Text="Баг-репорты и предложения по программе."
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- New ticket -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="НОВЫЙ ТИКЕТ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="TicketTypeCombo" Height="34" Margin="0,0,8,0" DisplayMemberPath="Label"/>
                    <TextBox Grid.Column="1" x:Name="TicketTextInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                              VerticalScrollBarVisibility="Auto"
                              ToolTip="Опишите проблему или предложение — что произошло/что хотелось бы, по возможности как воспроизвести."/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Прикрепить файлы…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AttachFiles_Click"
                            ToolTip="Скриншот, лог или любой файл, поясняющий проблему. Ложится на сетевой диск рядом с тикетом — коллегам в конторе видно, в хранилище на хостинге НЕ уезжает"/>
                    <Button Grid.Column="1" x:Name="ClearAttachmentsBtn" Content="Очистить вложения" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="ClearAttachments_Click"/>
                    <TextBlock Grid.Column="2" x:Name="AttachmentsSummaryText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
                <!-- Сказано прямо и постоянной строкой, а не только в подсказке: сам тикет и его
                     статус ездят и по сетевому диску, и через хранилище на хостинге, а вложения —
                     только по диску (TicketStorageSync возит запись, не файлы). Человек, приложивший
                     скриншот, обязан знать, что тот, кто чинит, увидит его не сам собой. -->
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Тикет и его статус синхронизируются между машинами и с хранилищем на хостинге. Вложения остаются на сетевом диске конторы — чтобы их увидел тот, кто вне сети, отправьте архив кнопкой «Выгрузить…»."/>
                <Button Content="Создать тикет" HorizontalAlignment="Left" Click="CreateTicket_Click"/>
            </StackPanel>
        </Border>

        <!-- List — "Текст" is trimmed to one line here (a several-thousand-character ticket would
             otherwise dominate the whole grid); double-click a row (or select + "Подробнее") for the
             full text and any attachments, see TicketDetailDialog. -->
        <!-- ScrollUnit=Pixel — прокрутка по пикселям вместо прыжков через целую строку (виртуализация
             при этом остаётся включённой, в отличие от CanContentScroll=False). На списке с длинными
             тикетами построчные прыжки читались как рывки. -->
        <!-- Отбор автоотчётов о сбоях. Тикет: «по умолчанию автоотчёты скрыты, для более читаемого
             просмотра предложенных тем» — их было 7 из 28, и каждый со стектрейсом в поле «Текст».
             Галка снята при каждом открытии программы: «по умолчанию скрыты» — это про умолчание, а
             не про запомненный выбор. Число рядом обязательно: без него «скрыты» читается как
             «потерялись». -->
        <CheckBox Grid.Row="3" x:Name="ShowAutoReportsCheck" Margin="0,0,0,8"
                  Content="Показывать автоматические отчёты о сбоях"
                  Checked="ShowAutoReports_Changed" Unchecked="ShowAutoReports_Changed"
                  ToolTip="Отчёты, которые программа заводит сама при падении. Живые предложения и баги от людей видно и без них."/>

        <DataGrid Grid.Row="4" x:Name="TicketsGrid" AutoGenerateColumns="False" Margin="0,0,0,10"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  IsReadOnly="True" SelectionChanged="TicketsGrid_SelectionChanged" MouseDoubleClick="TicketsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" Binding="{Binding TypeLabel}" Width="90"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding Text}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" SortMemberPath="StatusOrder" Width="90"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding CreatedBy}" Width="120"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding CreatedByRoleLabel}" Width="110"/>
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAtLabel}" SortMemberPath="CreatedAtSort" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button Content="Подробнее" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ShowDetail_Click"
                    ToolTip="Полный текст тикета и вложения — то же, что двойной клик по строке"/>
            <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Refresh_Click"
                    ToolTip="Перечитать список — тикеты с других машин приезжают синхронизацией"/>
            <Button x:Name="ExportBtn" Content="Выгрузить…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportTickets_Click"
                    ToolTip="Сложить тикеты вместе с вложениями в один архив — унести флешкой, отправить почтой или загрузить на страницу приёма"/>
            <Button x:Name="TakeInProgressBtn" Content="Взять в работу" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="SetStatus_Click" Tag="in_progress" Visibility="Collapsed"
                    ToolTip="Отметить, что тикетом занимаются — автор увидит это у себя"/>
            <Button x:Name="CloseTicketBtn" Content="Закрыть" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="SetStatus_Click" Tag="closed" Visibility="Collapsed"
                    ToolTip="Пометить тикет решённым"/>
            <Button x:Name="ReopenTicketBtn" Content="Переоткрыть" Style="{StaticResource SecondaryButton}"
                    Click="SetStatus_Click" Tag="open" Visibility="Collapsed"
                    ToolTip="Вернуть закрытый тикет в работу"/>
        </StackPanel>
    </Grid>
</UserControl>
