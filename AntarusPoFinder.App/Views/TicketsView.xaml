<UserControl x:Class="AntarusPoFinder.App.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PageTitle" Text="Тикеты" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>

        <!-- Две вкладки, а не один список с отбором. Жалоба Ильи: «отправил тестовый баг, оно
             улетело в общие тикеты, вкладка баги прошивок отдельно должно быть».

             Это разные потоки работы, а не два вида одного списка: у багов прошивок другой адресат
             (программист, а не тот, кто чинит приложение), свои столбцы и свои права. Смешанные в одну
             кучу, они терялись среди жалоб на интерфейс. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel x:Name="TabsRow" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="TabBtnApp" Style="{StaticResource NavButton}" Tag="Active" Padding="16,8" Margin="0,0,4,0" Click="Tab_Click">
                    <!-- Число незакрытых прямо на вкладке — симметрично вкладке багов прошивок:
                         иначе «сколько ещё чинить» видно только у одной из двух, и вторая читается
                         как пустая. -->
                    <TextBlock x:Name="TabAppText" Text="Программа" Style="{StaticResource NavButtonContentText}"/>
                </Button>
                <Button x:Name="TabBtnFwBugs" Style="{StaticResource NavButton}" Padding="16,8" Click="Tab_Click">
                    <TextBlock x:Name="TabFwBugsText" Text="Баги прошивок" Style="{StaticResource NavButtonContentText}"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="ScopeHintText" Text="Баг-репорты и предложения по программе."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- New ticket -->
        <Border Grid.Row="2" x:Name="NewTicketCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="НОВЫЙ ТИКЕТ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="TicketTypeCombo" Height="34" Margin="0,0,8,0" DisplayMemberPath="Label"/>
                    <TextBox Grid.Column="1" x:Name="TicketTextInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                              VerticalScrollBarVisibility="Auto"
                              ToolTip="Опишите проблему или предложение — что произошло/что хотелось бы, по возможности как воспроизвести."/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Прикрепить файлы…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AttachFiles_Click"
                            ToolTip="Скриншот, лог или любой файл, поясняющий проблему. Ложится на сетевой диск рядом с тикетом — коллегам в конторе видно, в хранилище на хостинге НЕ уезжает"/>
                    <Button Grid.Column="1" x:Name="ClearAttachmentsBtn" Content="Очистить вложения" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="ClearAttachments_Click"/>
                    <TextBlock Grid.Column="2" x:Name="AttachmentsSummaryText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
                <!-- Сказано прямо и постоянной строкой, а не только в подсказке: сам тикет и его
                     статус ездят и по сетевому диску, и через хранилище на хостинге, а вложения —
                     только по диску (TicketStorageSync возит запись, не файлы). Человек, приложивший
                     скриншот, обязан знать, что тот, кто чинит, увидит его не сам собой. -->
                <TextBlock x:Name="AttachmentsNoteText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Тикет и его статус синхронизируются между машинами и с хранилищем на хостинге. Вложения остаются на сетевом диске конторы — чтобы их увидел тот, кто вне сети, отправьте архив кнопкой «Выгрузить…»."/>
                <Button Content="Создать тикет" HorizontalAlignment="Left" Click="CreateTicket_Click"/>
            </StackPanel>
        </Border>

        <!-- List — "Текст" is trimmed to one line here (a several-thousand-character ticket would
             otherwise dominate the whole grid); double-click a row (or select + "Подробнее") for the
             full text and any attachments, see TicketDetailDialog. -->
        <!-- ScrollUnit=Pixel — прокрутка по пикселям вместо прыжков через целую строку (виртуализация
             при этом остаётся включённой, в отличие от CanContentScroll=False). На списке с длинными
             тикетами построчные прыжки читались как рывки. -->
        <!-- Отбор автоотчётов о сбоях. Тикет: «по умолчанию автоотчёты скрыты, для более читаемого
             просмотра предложенных тем» — их было 7 из 28, и каждый со стектрейсом в поле «Текст».
             Галка снята при каждом открытии программы: «по умолчанию скрыты» — это про умолчание, а
             не про запомненный выбор. Число рядом обязательно: без него «скрыты» читается как
             «потерялись». -->
        <!-- Закрытые тикеты по умолчанию убраны с глаз (только бета): в выгрузке на 29.10.2026 из
             55 тикетов закрыто 40, и пятнадцать живых тем были размазаны между ними. Число рядом
             обязательно — «скрыты» без числа читается как «потерялись». -->
        <!-- Строка над таблицей: слева отборы, справа — место, куда бета переносит действия над
             выбранным тикетом (см. TicketsView.ApplyBetaLayout). Действия обязаны быть НАД списком,
             а не под ним: список растягивается на всё оставшееся место, и в невысоком окне ряд
             кнопок под ним уезжал за нижний край — дословная жалоба Ильи «чтобы кнопки были видны
             сразу». -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ShowAutoReportsCheck" Margin="0,0,20,0"
                          Content="Показывать автоматические отчёты о сбоях"
                          Checked="ShowAutoReports_Changed" Unchecked="ShowAutoReports_Changed"
                          ToolTip="Отчёты, которые программа заводит сама при падении. Живые предложения и баги от людей видно и без них."/>
                <CheckBox x:Name="ShowClosedCheck" Content="Показывать закрытые"
                          Checked="ShowAutoReports_Changed" Unchecked="ShowAutoReports_Changed"
                          ToolTip="Закрытые тикеты никуда не делись — они просто не мешают смотреть, что ещё чинить."/>
            </StackPanel>
            <StackPanel Grid.Column="1" x:Name="TopActionsHost" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Бета: бланк «НОВЫЙ ТИКЕТ» свёрнут, пока он не нужен, и раскрывается этой кнопкой.
                     Он занимал треть экрана над списком, а заводят тикет куда реже, чем смотрят
                     уже заведённые, — страница открывалась формой, а не тем, за чем на неё пришли. -->
                <Button x:Name="NewTicketToggleBtn" Content="Новый тикет" Margin="8,0,0,0"
                        Visibility="Collapsed" Click="NewTicketToggle_Click"
                        ToolTip="Раскрыть бланк: тип, описание и вложения"/>
                <!-- Редкое — под одной пилюлей, как вкладки «Ещё» в Настройках. Видна только в бете. -->
                <Button x:Name="MoreBtn" Style="{StaticResource NavButton}" Padding="12,6" Margin="8,0,0,0"
                        Visibility="Collapsed" Click="More_Click">
                    <TextBlock Text="Ещё ▾" Style="{StaticResource NavButtonContentText}"/>
                </Button>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="4" x:Name="TicketsGrid" AutoGenerateColumns="False" Margin="0,0,0,10"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  IsReadOnly="True" SelectionChanged="TicketsGrid_SelectionChanged" MouseDoubleClick="TicketsGrid_MouseDoubleClick"
                  PreviewKeyDown="TicketsGrid_PreviewKeyDown">
            <!-- Цвет задаётся ЯЧЕЙКЕ, а не строке, и это не прихоть: общеприложенческий стиль
                 DataGridCell задаёт Foreground явно (см. Styles.xaml), а явное значение всегда бьёт
                 наследование от строки. Цвет на DataGridRow просто не доходил до текста — список
                 оставался сплошь чёрным, и заметить это без живых тикетов было негде.

                 Правило выделения повторено здесь ниже триггеров цвета нарочно: триггеры производного
                 стиля сильнее базовых, и без этого выделенная красная строка оставалась бы красной
                 на синем фоне выделения — нечитаемо. -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RowBrushKey}" Value="ErrorBrush">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowBrushKey}" Value="WarningBrush">
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowBrushKey}" Value="CautionBrush">
                            <Setter Property="Foreground" Value="{DynamicResource CautionBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowBrushKey}" Value="SuccessBrush">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <!-- Закрытый тикет гасится в серый: по списку должно быть видно, что сделано,
                             а что ещё нет, не вчитываясь в столбец «Статус» построчно. -->
                        <DataTrigger Binding="{Binding RowBrushKey}" Value="TextMutedBrush">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="TypeColumn" Header="Тип" Binding="{Binding TypeLabel}" Width="110"/>
                <DataGridTextColumn x:Name="SeverityColumn" Header="Критичность" Binding="{Binding SeverityLabel}" SortMemberPath="SeverityOrder" Width="120"/>
                <DataGridTextColumn x:Name="FwColumn" Header="Прошивка" Binding="{Binding FwLabel}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- MinWidth обязателен, а не для красоты: долю «*» DataGrid пересчитывает не всегда,
                     и после смены видимости столбцов при переключении вкладки текст сжимался в полоску
                     шириной 20 пикселей (проверено замером ActualWidth), а справа зияла пустота. Самое важное
                     в строке — что именно сломалось, и читать это по одной букве невозможно. -->
                <DataGridTextColumn x:Name="TextColumn" Header="Текст" Binding="{Binding Text}" Width="*" MinWidth="240">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusLabel}" SortMemberPath="StatusOrder" Width="90"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding CreatedBy}" Width="120"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding CreatedByRoleLabel}" Width="110"/>
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAtLabel}" SortMemberPath="CreatedAtSort" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Ряд действий. В бете он уезжает наверх, в TopActionsHost, а «Подробнее», «Обновить» и
             «Выгрузить…» из него пропадают — см. ApplyBetaLayout. В рабочей версии всё как было. -->
        <StackPanel Grid.Row="5" x:Name="ActionsRow" Orientation="Horizontal">
            <Button x:Name="DetailBtn" Content="Подробнее" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ShowDetail_Click"
                    ToolTip="Полный текст тикета и вложения — то же, что двойной клик по строке"/>
            <Button x:Name="RefreshBtn" Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Refresh_Click"
                    ToolTip="Перечитать список — тикеты с других машин приезжают синхронизацией"/>
            <Button x:Name="ExportBtn" Content="Выгрузить…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportTickets_Click"
                    ToolTip="Сложить тикеты вместе с вложениями в один архив — унести флешкой, отправить почтой или загрузить на страницу приёма"/>
            <Button x:Name="TakeInProgressBtn" Content="Взять в работу" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="SetStatus_Click" Tag="in_progress" Visibility="Collapsed"
                    ToolTip="Отметить, что тикетом занимаются — автор увидит это у себя"/>
            <Button x:Name="CloseTicketBtn" Content="Закрыть" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="SetStatus_Click" Tag="closed" Visibility="Collapsed"
                    ToolTip="Пометить тикет решённым"/>
            <Button x:Name="ReopenTicketBtn" Content="Переоткрыть" Style="{StaticResource SecondaryButton}"
                    Click="SetStatus_Click" Tag="open" Visibility="Collapsed"
                    ToolTip="Вернуть закрытый тикет в работу"/>
        </StackPanel>
    </Grid>
</UserControl>
