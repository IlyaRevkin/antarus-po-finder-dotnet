<Window x:Class="AntarusPoFinder.App.Views.EditParamSubtypesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Подтипы файла параметров"
        Width="560" Height="560" MinWidth="460" MinHeight="380"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLabel" Grid.Row="0" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- Набор подтипов у параметров задавался только в момент загрузки: ошибся — переделать было
             нечем, кроме повторной заливки. Здесь тот же набор правится у уже загруженного файла:
             отметить — завести запись и ярлык, снять — убрать их. Файл на диске общий и не
             копируется/не удаляется (см. ParamFileLinkService), поэтому основной подтип — тот, в чьей
             папке файл лежит — отмечен и заблокирован: это не ссылка, а сам файл.

             В отличие от прошивок, подтипы здесь берутся из ВСЕХ типов шкафа: один и тот же файл
             параметров частотника подходит сразу нескольким типам. -->
        <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Каким подтипам шкафа подходит этот файл. Файл на диске не дублируется — в папке отмеченного подтипа появляется ярлык, а в списке и поиске файл находится и под ним."/>

        <TextBox x:Name="FilterInput" Grid.Row="2" Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"
                 ToolTip="Фильтр по типу/подтипу" TextChanged="Filter_TextChanged"/>

        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChecksPanel"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Left" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="110" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
