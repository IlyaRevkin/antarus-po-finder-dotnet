<Window x:Class="AntarusPoFinder.App.Views.EditFirmwareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AntarusPoFinder.App.Views"
        Icon="/Assets/icon.ico"
        Width="560" SizeToContent="Height" MaxHeight="860"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!-- ScrollViewer + MaxHeight: с появлением блоков «Доп. файлы» и «Исполняемые файлы» окно
         на невысоком экране/ноутбуке перестало помещаться, а SizeToContent сам по себе просто
         вырастил бы его за пределы экрана вместе с кнопками «Сохранить»/«Отмена». -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleLabel" Style="{StaticResource SubtitleText}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="Описание:" Margin="0,0,0,4"/>
        <TextBox x:Name="DescriptionInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

        <TextBlock Text="Теги:" Margin="0,0,0,4"/>
        <views:TagBubbleEditor x:Name="TagsEditor" Margin="0,0,0,4"/>
        <!-- Подстановка в теге (см. Core/Services/TagPattern.cs): один тег вместо десятка почти
             одинаковых названий шкафов, отличающихся только амперажом. -->
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Звёздочка в теге — подстановка любой части названия: тег «…ПЖ-ПП-2-(*-*А)-АВР-FD-Ст» находится и по «(9-14А)», и по «(20-25А)»."/>

        <TextBlock Text="Тип пуска:" Margin="0,0,0,4"/>
        <!-- WrapPanel, не горизонтальный StackPanel: пятый тип пуска («Отсутствует», см.
             ConfigService.LaunchTypes) не помещается в 520px ширины окна одной строкой и у
             StackPanel просто обрезался бы без возможности до него добраться. -->
        <WrapPanel x:Name="LaunchTypesPanel" Orientation="Horizontal" Margin="0,0,0,16"/>

        <!-- Набор подтипов шкафа задавался только в момент загрузки (чек-комбобокс «Подтипы» в
             «Загрузке ПО»): ошибся — и переделать было нечем, кроме повторной заливки. Здесь тот же
             набор правится у уже загруженной прошивки: отметить подтип — завести ему запись и ярлык,
             снять — убрать их. Файлы на диске общие и не копируются/не удаляются (см.
             FirmwareSubtypeLinkService), поэтому основной подтип — тот, в чьей папке лежат сами файлы
             — отмечен и заблокирован: это не ссылка, а сама прошивка. -->
        <StackPanel x:Name="SubtypesPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="ПОДТИПЫ ШКАФОВ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="SubtypesHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Каким подтипам подходит эта прошивка. Файлы на диске не дублируются — в папке отмеченного подтипа появляется ярлык, а в поиске прошивка находится и под ним."/>
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="SubtypesCheckPanel"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Конфигурации шкафов: заранее заготовленные варианты ОДНОЙ И ТОЙ ЖЕ прошивки под разные
             комплектации («2 насоса», «2 насоса + жокей и задвижка»). Файлы на диске не копируются —
             это те же самые файлы, отличается только набор тегов, то есть названия шкафов, по которым
             вариант находится поиском. См. Core/Services/FirmwareConfigService.cs. Заводятся ПАЧКОЙ:
             одна строка — одна конфигурация, чтобы список названий шкафов можно было вставить из
             таблицы целиком, а не дублировать прошивку по одной штуке. -->
        <StackPanel x:Name="ConfigsPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="КОНФИГУРАЦИИ ШКАФОВ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Варианты одной и той же прошивки под разные комплектации шкафа. Одна строка — одна конфигурация: вставьте названия шкафов списком. Файлы на диске не дублируются, отличаются только теги, по которым конфигурация находится в поиске. Звёздочка работает и здесь: «…ПЖ-ПП-2-(*-*А)-АВР-FD-Ст» одной строкой закрывает весь ряд амперажей. Если варианту нужно короткое имя — «Имя | тег; тег». Убрали строку — конфигурация удалена."/>
            <TextBox x:Name="ConfigsInput" Height="110" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Margin="0,0,0,4"/>
            <TextBlock x:Name="ConfigsHint" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Доп. файлы можно было приложить только в момент загрузки версии: если карту/инструкцию
             прислали позже, оставалось только перезаливать прошивку заново. Поля предзаполнены тем,
             что уже записано у версии; пустое поле = убрать ссылку (файлы на диске не удаляются —
             папки «Карта ВВ»/«Инструкция»/«Карта Modbus» общие для всех версий контроллера). -->
        <StackPanel x:Name="AttachmentsPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="ДОП. ФАЙЛЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Шестая колонка есть только ради «Удалить инструкцию»: у остальных доп. файлов
                         такой кнопки нет и не должно быть — их удаление это отдельный разговор
                         (папки «Карта ВВ»/«Карта Modbus» общие у контроллера), а у инструкции есть
                         куда вернуться после удаления: заглушка «в разработке». -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Карта in/out:" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IoMapInput" Height="30" Margin="0,0,4,4"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="IoMapBrowseFile_Click" ToolTip="Выбрать файл">
                    <Path Data="{StaticResource Icon.File}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="IoMapBrowseFolder_Click" ToolTip="Выбрать папку">
                    <Path Data="{StaticResource Icon.Folder}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="IoMapClear_Click" ToolTip="Очистить">
                    <Path Data="{StaticResource Icon.Close}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Карта modbus:" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ModbusMapInput" Height="30" Margin="0,0,4,4"/>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="ModbusMapBrowseFile_Click" ToolTip="Выбрать файл">
                    <Path Data="{StaticResource Icon.File}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="ModbusMapBrowseFolder_Click" ToolTip="Выбрать папку">
                    <Path Data="{StaticResource Icon.Folder}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="ModbusMapClear_Click" ToolTip="Очистить">
                    <Path Data="{StaticResource Icon.Close}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Инструкция:" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="InstructionsInput" Height="30" Margin="0,0,4,4"/>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="InstructionsBrowseFile_Click" ToolTip="Выбрать файл">
                    <Path Data="{StaticResource Icon.File}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="InstructionsBrowseFolder_Click" ToolTip="Выбрать папку">
                    <Path Data="{StaticResource Icon.Folder}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="InstructionsClear_Click"
                        ToolTip="Очистить поле — снять ссылку на инструкцию при сохранении. Файл на диске и на хостинге остаётся.">
                    <Path Data="{StaticResource Icon.Close}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <!-- Удаление — не «очистка поля»: оно уносит сам документ с диска и с хостинга и
                     возвращает на его место заглушку «Инструкция в разработке». Поэтому действует
                     сразу, а не по кнопке «Сохранить»: откладывать необратимое до сохранения диалога
                     значит обещать возможность передумать, которой не будет. -->
                <Button Grid.Row="2" Grid.Column="5" x:Name="InstructionsDeleteBtn" Style="{StaticResource IconButton}"
                        Margin="2,0,0,4" Click="InstructionsDelete_Click"
                        ToolTip="Удалить инструкцию: убрать документ с диска и с хостинга, вернуть на его место заглушку «Инструкция в разработке». Действует сразу, отменить нельзя.">
                    <Path Data="{StaticResource Icon.Trash}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="HMI-проект:" VerticalAlignment="Center" TextWrapping="Wrap"
                           ToolTip="Файл или папка проекта HMI — ляжет в папку HMI контроллера как «{версия}_hmi»."/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="HmiInput" Height="30" Margin="0,0,4,4"/>
                <!-- Кнопки-иконки без подписи: имя нужно, чтобы живой прогон мог за них взяться
                     (у безымянной иконки нет ни текста, ни AutomationId — искать её приходилось по
                     координатам, и прогон её не находил). -->
                <Button Grid.Row="3" Grid.Column="2" x:Name="HmiBrowseFileBtn" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="HmiBrowseFile_Click" ToolTip="Выбрать файл">
                    <Path Data="{StaticResource Icon.File}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="3" Grid.Column="3" x:Name="HmiBrowseFolderBtn" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="HmiBrowseFolder_Click" ToolTip="Выбрать папку">
                    <Path Data="{StaticResource Icon.Folder}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource IconButton}" Margin="2,0,0,4" Click="HmiClear_Click" ToolTip="Очистить">
                    <Path Data="{StaticResource Icon.Close}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>

                <!-- Файл прошивки ПЛК кладётся в САМУ папку версии, а не в общие папки контроллера,
                     как «карты»/инструкция: по файлам этой папки карточка и считает LFS/PSL. Для
                     Segnetics подпись становится «Прошивка ПЛК (.lfs)» — загрузочный файл, а исходник
                     .psl докладывается отдельным полем ниже (PlcFileLabel/PslFilePanel настраиваются
                     в code-behind по SegneticsProject.IsRelevant). У остальных — одно поле. -->
                <TextBlock Grid.Row="4" Grid.Column="0" x:Name="PlcFileLabel" Text="Файл прошивки:" VerticalAlignment="Center" TextWrapping="Wrap"
                           ToolTip="Файл прошивки ПЛК — ложится прямо в папку версии рядом с прошивкой. Пригодится, чтобы доложить недостающий файл к уже загруженной версии."/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="PlcFileInput" Height="30" Margin="0,0,4,0"/>
                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="PlcFileBrowse_Click" ToolTip="Выбрать файл прошивки">
                    <Path Data="{StaticResource Icon.File}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="PlcFileClear_Click" ToolTip="Очистить">
                    <Path Data="{StaticResource Icon.Close}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
            </Grid>

            <!-- Исходный проект Segnetics (.psl) — отдельно от загрузочного .lfs выше. Видно только
                 для Segnetics (см. code-behind): у KINCO и прочих такого файла нет, показывать поле
                 незачем. Своя мини-сетка теми же колонками, чтобы поле/кнопки встали ровно под гридом. -->
            <Grid x:Name="PslFilePanel" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Исходник (.psl):" VerticalAlignment="Center" TextWrapping="Wrap"
                           ToolTip="Исходный проект SMLogix (.psl) — НЕ загрузочный, из него собирается .lfs. Ложится в папку версии рядом с прошивкой; пригодится, чтобы доложить исходник к уже загруженной версии."/>
                <TextBox Grid.Column="1" x:Name="PslFileInput" Height="30" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="PslFileBrowse_Click" ToolTip="Выбрать исходник (.psl)">
                    <Path Data="{StaticResource Icon.File}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="PslFileClear_Click" ToolTip="Очистить">
                    <Path Data="{StaticResource Icon.Close}" Stretch="Uniform" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                </Button>
            </Grid>

            <!-- Сборка .psl → .lfs прямо в модерации. Показывается только когда в папке версии есть
                 исходник и НЕТ собранного файла: цель — чтобы наладчик в поиске сразу видел .lfs, а
                 не собирал его сам заливкой в контроллер (собранный там файл оседал в локальной
                 рабочей области заливавшего и на диск не попадал). Сборка идёт локально, на диск
                 уезжает только готовый файл (LfsConversionService/LfsPublisher). -->
            <StackPanel x:Name="BuildLfsPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="100,8,0,0">
                <Button x:Name="BuildLfsBtn" Content="Собрать LFS из PSL" Style="{StaticResource SecondaryButton}"
                        Click="BuildLfs_Click"
                        ToolTip="Собрать .lfs изолированным SMLogix и положить его рядом с .psl в папке версии на диске — чтобы его увидели все, а не только эта машина."/>
                <TextBlock x:Name="BuildLfsHint" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- Доп. материалы: свободный список файлов, которые нужны наладчику рядом с прошивкой —
             краткое руководство по шкафу, специфика работы объекта, прошивка ПЛК от поставщика.
             Не фиксированные слоты, как «Карта ВВ»/«Инструкция» выше: набор таких файлов заранее не
             известен, и следующий вид не должен требовать нового релиза. Вид берётся из справочника,
             но список редактируемый — администратор вписывает свой прямо здесь, как новый тег. -->
        <StackPanel x:Name="ExtraFilesPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="ДОП. МАТЕРИАЛЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Любые файлы, которые нужны рядом с прошивкой: краткое руководство для наладчика, специфика работы объекта, прошивка ПЛК от поставщика. Вид и комментарий ищутся поиском наравне с тегами — по ним наладчик и найдёт нужное. Файлы лягут в папку «Доп. материалы» этой версии."/>
            <StackPanel x:Name="ExtraFilesList" Margin="0,0,0,6"/>
            <Border x:Name="ExtraFilesDropZone" AllowDrop="True" Drop="ExtraFilesDrop" DragOver="ExtraFilesDragOver"
                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="Перетащите файлы сюда или"/>
                    <Button x:Name="AddExtraFileBtn" Content="Выбрать файлы..." Style="{StaticResource SecondaryButton}"
                            Click="AddExtraFile_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Модерация исполняемых файлов: и для ПЛК, и для HMI (раньше можно было переназначить
             только HMI, и только среди файлов КОРНЯ папки — если нужный файл лежал во вложенной
             папке, выбрать его было нечем). Кнопка открывает PickFileDialog с обходом подпапок. -->
        <StackPanel x:Name="ExecutablesPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="ИСПОЛНЯЕМЫЕ ФАЙЛЫ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <Grid x:Name="PlcExecutableRow" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Открывать файл:" VerticalAlignment="Center"
                           ToolTip="Какой файл в папке версии открывать по кнопке «Открыть прошивку ПЛК». Это НЕ загрузка файла — только выбор, что открывать из уже лежащих в папке."/>
                <TextBlock Grid.Column="1" x:Name="PlcExecutableText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Выбрать..." Style="{StaticResource SecondaryButton}" Click="PickPlcExecutable_Click"/>
            </Grid>

            <Grid x:Name="HmiExecutableRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="HmiExecutableLabel" Text="HMI-проект:" VerticalAlignment="Center"
                           ToolTip="Какой файл в папке HMI-проекта открывать по кнопке «Открыть HMI проект»."/>
                <TextBlock Grid.Column="1" x:Name="HmiExecutableText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Выбрать..." Style="{StaticResource SecondaryButton}" Click="PickHmiExecutable_Click"/>
            </Grid>
        </StackPanel>

        <!-- Ручной вес прошивки в поиске по конкретному запросу — ОТДЕЛЬНЫЙ от счётчика открытий
             (складывается с ним, а не заменяет). Правится вручную и адресно: наладчик знает, что по
             «пожар» надо ставить именно эту версию, и поднимает её вес, не дожидаясь частоты
             (или гасит случайно накликанное). Информация внутренняя — в самом поиске она не
             показывается, только влияет на порядок выдачи; поэтому и живёт здесь, в модерации, а не
             на карточке. Правится только вклад ЭТОЙ машины (SetLocalFwWeight). -->
        <StackPanel x:Name="WeightPanel" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="ВЕС В ПОИСКЕ (ПО ЗАПРОСАМ)" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Ручной вес этой версии под запрос. Он СКЛАДЫВАЕТСЯ со счётчиком открытий (не заменяет его): чем больше вес, тем выше версия в выдаче по этому запросу. Чтобы гарантированно обойти самую популярную версию, задайте вес больше потолка авто-популярности (он показан в Настройках → Общие). В самом поиске вес не виден — только влияет на порядок."/>
            <DataGrid x:Name="WeightGrid" AutoGenerateColumns="False" MaxHeight="150" Margin="0,0,0,6"
                      Style="{StaticResource RoomyDataGrid}" IsReadOnly="False" CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Запрос" Binding="{Binding QueryKey, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Вес" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить запрос" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddWeightRow_Click"/>
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RemoveWeightRow_Click"/>
                <Button Content="Обнулить всё" Style="{StaticResource SecondaryButton}" Click="ClearWeights_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Width="90" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
