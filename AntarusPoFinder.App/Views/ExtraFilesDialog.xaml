<Window x:Class="AntarusPoFinder.App.Views.ExtraFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Доп. материалы" Width="640" Height="440" MinWidth="520" MinHeight="320"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap"
                   Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

        <!-- Строку можно не только выбрать, но и вытащить мышью прямо в другую программу: прошивку
             ПЛК в среду разработки контроллера кладут перетаскиванием, и это самый короткий путь —
             без прохода через проводник (см. List_MouseMove). -->
        <ListBox Grid.Row="1" x:Name="FilesList"
                 MouseDoubleClick="List_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 MouseMove="List_MouseMove"
                 SelectionChanged="List_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" x:Name="HintText" TextWrapping="Wrap"
                   Style="{StaticResource MutedText}" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,8,0" Click="Close_Click"/>
            <Button x:Name="RevealButton" Content="Показать в папке" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Reveal_Click"
                    ToolTip="Открыть проводник с выделенным файлом — оттуда его перетаскивают в программу контроллера"/>
            <Button x:Name="OpenButton" Content="Открыть" Width="110" Click="Open_Click"
                    ToolTip="Открыть файл программой, назначенной для этого типа файлов"/>
        </StackPanel>
    </Grid>
</Window>
