<UserControl x:Class="AntarusPoFinder.App.Views.PassportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Паспорта шкафов" Style="{StaticResource TitleText}"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Шаблон паспорта, который печатают и вкладывают в шкаф. Привязывается к типу/подтипу шкафа, а не к версии прошивки — поэтому находится и у шкафов, для которых прошивки нет вовсе. Бланк, который не относится ни к одному типу (НКУ, Щит СПЛ, ШР), грузится как типовой: он ложится в общую папку, находится по тегам и печатается с подстановкой названия шкафа."/>
        </StackPanel>

        <!-- Страница целиком прокручивается, карточки сами по себе по высоте — тот же приём и по той
             же причине, что на странице «Параметры ПЧ/УПП» (см. её XAML). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ЗАГРУЗИТЬ ПАСПОРТ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Тип шкафа + подтип одним рядом, ширины как у такого же ряда в «Параметрах»/
                         «Загрузке ПО». Подтип у паспорта РОВНО один (паспорт — документ конкретного
                         шкафа), поэтому здесь обычный ComboBox, а не чек-список, как у параметров:
                         один файл параметров частотника действительно подходит нескольким шкафам,
                         паспорт — нет. Названия конкретных исполнений навешиваются тегами. -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*" MinWidth="90" MaxWidth="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="100" MaxWidth="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип шкафа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GroupCombo" Grid.Column="1" Height="34"
                                  DisplayMemberPath="Name" SelectionChanged="GroupCombo_SelectionChanged"/>
                        <TextBlock Grid.Column="3" Text="Подтип:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SubtypeCombo" Grid.Column="4" Height="34" DisplayMemberPath="Name"/>
                    </Grid>

                    <!-- Типовой бланк — паспорт, который не ложится ни на один тип и подтип (НКУ,
                         Щит СПЛ, ШР): его печатают под конкретный шкаф, вписывая название. Флажок,
                         а не строка-заглушка в списке типов: «типов шкафа» такого не существует, и
                         пункт в справочнике врал бы про иерархию. -->
                    <CheckBox x:Name="GeneralCheck" Margin="110,0,0,8" Click="GeneralCheck_Click"
                              Content="Типовой бланк — без привязки к шкафу (НКУ, Щит СПЛ, ШР)"
                              ToolTip="Ляжет в общую папку бланков, а не в папку «Паспорт» подтипа. Печатается через «Паспорт по шаблону» с подстановкой названия шкафа."/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="NameInput" Grid.Column="1" Height="34"
                                 ToolTip="Как называть этот паспорт («Паспорт ПЖ ПИ», «2 насоса + жокей»). Оно же станет именем папки на диске. Пусто — возьмётся имя файла."/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Файл:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Grid.Column="1" Style="{StaticResource DropZoneBorder}" Height="46" Cursor="Hand"
                                AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" MouseLeftButtonUp="DropZone_Click">
                            <TextBlock x:Name="DropZoneLabel" Text="Перетащите документ сюда, или нажмите для выбора" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="DescInput" Grid.Column="1" Height="34"
                                 ToolTip="Что изменилось в этой редакции (необязательно) — дописывается в журнал записи датированной строкой"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="110,8,0,0"
                               Text="Лучше грузить .docx: из него программа сама соберёт PDF для печати и пересоберёт его, если документ правили. Готовый .pdf тоже принимается — тогда печать идёт прямо из него."/>

                    <!-- Кнопка «Паспорт по шаблону…» отсюда УБРАНА: эта страница про то, чтобы
                         ЗАВЕСТИ паспорт (загрузить и привязать), а формируют и печатают его одной
                         кнопкой «Сформировать паспорт» в боковом меню. Две кнопки про паспорт рядом
                         и были тем, на что жаловался Илья. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="UploadBtn" Content="Загрузить паспорт" Height="36" Click="Upload_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ЗАГРУЖЕННЫЕ ПАСПОРТА" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ShowAllButton" Content="Все загруженные" Click="ShowAllButton_Click"
                                ToolTip="Развернуть таблицу всех загруженных паспортов"/>
                        <Button x:Name="OpenFileBtn" Content="Открыть" Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0" Click="OpenFile_Click" Visibility="Collapsed"
                                ToolTip="Открыть документ паспорта — то же, что двойной клик по строке"/>
                        <Button x:Name="PrintBtn" Content="Печать" Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0" Click="Print_Click" Visibility="Collapsed"
                                ToolTip="Отправить PDF паспорта на принтер по умолчанию (соберётся из docx, если тот правили)"/>
                        <Button x:Name="OpenFolderBtn" Content="Открыть папку" Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0" Click="OpenFolder_Click" Visibility="Collapsed"
                                ToolTip="Открыть в проводнике папку паспорта — там же лежат прежние редакции"/>
                        <Button x:Name="EditTagsBtn" Content="Теги" Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0" Click="EditTags_Click" Visibility="Collapsed"
                                ToolTip="Изменить теги — по ним паспорт находится поиском (сюда и пишут названия конкретных шкафов)"/>
                        <Button x:Name="DeleteRowBtn" Content="Удалить запись" Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0" Click="DeleteRow_Click" Visibility="Collapsed"
                                ToolTip="Убрать паспорт из базы. Файлы на диске остаются"/>
                        <TextBlock x:Name="CountLabel" Text="Записей: 0" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2" x:Name="ListContentPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Группа:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="FilterGroupCombo" Width="150" Margin="0,0,16,0" DisplayMemberPath="Name" SelectionChanged="Filter_Changed"/>
                            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchInput" Width="180" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                     ToolTip="Название / файл / описание / теги" TextChanged="Filter_Changed"/>
                            <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" x:Name="FilesGrid" SelectionMode="Single" SelectionUnit="FullRow"
                                  Height="320" AutoGenerateColumns="False" IsReadOnly="True"
                                  MouseDoubleClick="FilesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Тип / Подтип" Binding="{Binding GroupSubtypeDisplay}" Width="160"/>
                                <DataGridTextColumn Header="Файл" Binding="{Binding Filename}" Width="180"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateOnly}" Width="100"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="180"/>
                                <DataGridTextColumn Header="Теги" Binding="{Binding TagsDisplay}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
