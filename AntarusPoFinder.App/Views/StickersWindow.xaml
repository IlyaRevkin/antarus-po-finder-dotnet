<Window x:Class="AntarusPoFinder.App.Views.StickersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Наклейки"
        Width="620" Height="480" MinWidth="440" MinHeight="320"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Text="Готовые шаблоны наклеек на печать. Двойной клик по строке — открыть."/>

        <!-- Одна колонка: просто список файлов. Никаких разделов/подпапок — окно должно быть простым. -->
        <DataGrid Grid.Row="1" x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource RoomyDataGrid}" MouseDoubleClick="FilesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наклейка" Binding="{Binding Name}" Width="*" MinWidth="180"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="FolderText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Печать" Width="110" Margin="0,0,8,0" Click="Print_Click"/>
            <Button Content="Загрузить…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Upload_Click"
                    ToolTip="Положить новый шаблон в общую папку — он сразу появится у всех машин"/>
            <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Delete_Click"
                    ToolTip="Удалить выбранный файл из общей папки (у всех машин)"/>
            <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click"
                    ToolTip="Общая папка наклеек на диске"/>
        </StackPanel>
    </Grid>
</Window>
