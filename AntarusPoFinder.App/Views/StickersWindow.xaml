<Window x:Class="AntarusPoFinder.App.Views.StickersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Наклейки"
        Width="620" Height="480" MinWidth="440" MinHeight="320"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                   Text="Готовые шаблоны наклеек на печать. Двойной клик по строке — открыть шаблон."/>

        <DataGrid Grid.Row="1" x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource RoomyDataGrid}" MouseDoubleClick="FilesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наклейка" Binding="{Binding Name}" Width="*" MinWidth="180"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Раздел" Binding="{Binding Folder}" Width="Auto" MinWidth="120"
                                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Изменён" Binding="{Binding Changed}" Width="Auto" MinWidth="120"
                                    ElementStyle="{StaticResource DataGridCellTextCentered}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="FolderText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Печать" Width="110" Margin="0,0,8,0" Click="Print_Click"/>
            <Button Content="Открыть" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Open_Click"
                    ToolTip="Открыть шаблон — например, чтобы вписать что-то перед печатью"/>
            <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFolder_Click"
                    ToolTip="Сюда кладут новые шаблоны — они появятся у всех машин"/>
            <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
