<Window x:Class="AntarusPoFinder.App.Views.AuthoritativeDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Эталонная синхронизация — предпросмотр" Width="720" Height="640" MinWidth="560" MinHeight="360"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Что изменится у остальных компьютеров" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}"
                       Text="Сравнение справочника этой машины с тем, что сейчас лежит в общем конфиге на диске. Зелёным — появится там, где этого ещё нет; красным — удалится там, где это ещё есть (кроме записей, которые получатель ещё использует в своих прошивках или файлах параметров — они будут автоматически пропущены). Сами прошивки, файлы параметров, резервы номеров и пользователи не затрагиваются — только восемь категорий справочника ниже."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ЧТО БУДЕТ СНЯТО У КОЛЛЕГ ВМЕСТЕ С ДАННЫМИ. Просьба Ильи: «при эталонной пусть
                     будет опрос того, что затрётся у коллег, и чтобы это можно было настроить».
                     Раздел появляется, только если такие удаления есть: пустая рамка на каждом
                     подтверждении приучает не читать её вовсе. -->
                <Border x:Name="WipeCard" Style="{StaticResource CardBorder}" Visibility="Collapsed" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="УДАЛЁННЫЕ ПОДТИПЫ — СНЯТЬ У ВСЕХ" Style="{StaticResource MutedText}"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                   Text="Эти подтипы вы удалили у себя. Отмеченные будут сняты и у коллег. Снимите галочку с того, что остальным трогать не надо, — у них подтип останется, а у вас уже удалён."/>
                        <StackPanel x:Name="WipeList" Margin="0,0,0,8"/>
                        <CheckBox x:Name="WipeDataCheck" IsChecked="True"
                                  Content="Удалять вместе с прошивками, параметрами и паспортами под ними"
                                  ToolTip="Снято — у коллеги, под чьим подтипом лежат прошивки, подтип останется вместе с ними. Так работала программа до версии 1.75.5.0."/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="CategoriesPanel"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="NoChangesText" Text="Изменений относительно диска нет." Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="Подтвердить и отправить" Style="{StaticResource DangerButton}" Width="200" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
