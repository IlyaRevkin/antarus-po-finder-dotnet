<Window x:Class="AntarusPoFinder.App.Views.ParamTableEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/icon.ico"
        Title="Таблица параметров"
        Width="1180" Height="720" MinWidth="860" MinHeight="520"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Intro" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>

        <!-- Шапка: как назвать документ и — при импорте — чем прочитан файл. Кодировка стоит рядом с
             таблицей, а не в отдельном окне выбора: промах в ней виден именно по таблице (параметров
             не нашлось или в названиях «кракозябры»), и переключать её надо, глядя на результат. -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Название документа:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="NameInput" Height="30" VerticalContentAlignment="Center"
                     ToolTip="Как документ будет называться в списке: «Задание Modbus», «Пуск по месту»"/>

            <TextBlock Grid.Column="3" x:Name="EncodingLabel" Text="Кодировка файла:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="4" x:Name="EncodingCombo" Width="170" Height="30"
                      SelectionChanged="Encoding_Changed"
                      ToolTip="Чем прочитан файл. Если в названиях параметров вместо букв ерунда — выберите другую кодировку"/>

            <Button Grid.Column="6" x:Name="ShowSourceBtn" Content="Показать исходный текст"
                    Style="{StaticResource SecondaryButton}" Click="ShowSource_Click"
                    ToolTip="Тот же файл строками, как он лежит на диске — чтобы было с чем сверить разбор"/>
        </Grid>

        <Border Grid.Row="2" x:Name="WarningsBox" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="НА ЧТО ВЗГЛЯНУТЬ" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="WarningsText" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserResizeColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                  Style="{StaticResource RoomyDataGrid}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Группа" Width="Auto" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- IsEditable: своя группа заводится прямо здесь, набором с клавиатуры —
                                 она попадёт и в справочник (см. ParamTableEditing.SaveRevision). -->
                            <ComboBox ItemsSource="{Binding Groups}" IsEditable="True" Margin="2"
                                      Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Код" Binding="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*" MinWidth="160" ElementStyle="{StaticResource DataGridCellText}"/>

                <!-- Значение и «чем оно задано» — соседние колонки: пустая ячейка значения без
                     пометки читалась бы как «ноль», а на деле это либо «уточнить по ПЛК», либо
                     «снимается с шильдика двигателя на объекте». -->
                <DataGridTextColumn Header="Значение" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="Auto" MinWidth="90" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTemplateColumn Header="Чем задано" Width="Auto" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding StateChoices}" Margin="2"
                                      SelectedItem="{Binding StateLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Заводское" Binding="{Binding Factory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="Auto" MinWidth="80" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="Auto" MinWidth="55" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*" MinWidth="150" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Только для" Binding="{Binding Applicability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" MinWidth="120" ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn Header="Когда нужно" Binding="{Binding AppliesWhen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" MinWidth="120" ElementStyle="{StaticResource DataGridCellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Добавить строку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="AddRow_Click"/>
            <Button Content="Удалить строку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RemoveRow_Click"/>
            <Button Content="Выше" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" Click="MoveUp_Click"/>
            <Button Content="Ниже" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" Click="MoveDown_Click"/>
            <TextBlock x:Name="CountLabel" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Спрашиваем только «зачем». Что именно изменилось, считает программа (ParamTableDiff):
                 на просьбу перечислить правки человек отвечает «поправил параметры» и забывает
                 половину. -->
            <TextBlock Grid.Column="0" Text="Зачем правим:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="ReasonInput" Height="30" VerticalContentAlignment="Center"
                     ToolTip="Одна строка от себя: «объект попросил 55 Гц», «перенёс из txt». Список изменённых параметров программа составит сама"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                <Button x:Name="SaveBtn" Content="Сохранить" Width="150" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
