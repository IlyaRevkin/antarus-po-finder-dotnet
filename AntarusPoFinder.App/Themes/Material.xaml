<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MATERIAL — светлая тема по палитре Material Design 3 (бета 2.0, просьба «добавь темы типа
         матиреал дизайн, ликвид Гласс и тп»).

         Чем отличается от обычной светлой: поверхности не белые, а чуть окрашенные в сторону
         акцента (surface / surface-container в терминах M3), границы мягче, а текст — не чёрный, а
         очень тёмный сине-серый. На дневном свету это заметно спокойнее для глаз, а карточки
         перестают сливаться с фоном без рисования рамок.

         Набор ключей ОБЯЗАН совпадать со светлой и тёмной: стили ссылаются на них по имени, и
         пропущенный ключ — это не «цвет по умолчанию», а исключение при разборе разметки. За этим
         следит ThemeCatalogTests.

         Контраст основных пар (WCAG, относительная светлота):
           TextColor #1B1B1F на BgColor   #FDFBFF — 16.2:1
           TextColor #1B1B1F на BgCard    #F3EDF7 — 15.1:1
           TextMuted #45464F на BgColor            — 9.4:1  (порог 4.5)
           BorderColor #79747E на BgColor          — 3.6:1  (порог 3 для границ) -->

    <!-- ПОВЕРХНОСТИ ПО M3, а не «светлая тема другого оттенка». Было наоборот: фон почти белый
         (#FDFBFF), а карточка серее фона (#F3EDF7) — то есть карточка «проваливалась», и экран
         читался как светлая тема с лиловым отливом. Отсюда «материал нихера не материал».
         Теперь как в Material 3: страница — тонированная поверхность, карточка — чистый белый лист
         НАД ней, с мягкой тенью и без рамки (CardBorderThickness = 0), поле ввода — залитое, на
         тон темнее карточки. Разницу даёт тон и высота, а не линии.
         Контраст: TextColor #1B1B1F на белой карточке — 16.1:1; TextMuted #45464F на фоне — 8.9:1. -->
    <Color x:Key="BgColor">#F7F3FB</Color>
    <Color x:Key="BgSidebarColor">#F2ECF8</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgInputColor">#F1EBF7</Color>
    <Color x:Key="BorderColor">#79747E</Color>
    <Color x:Key="AccentColor">#6750A4</Color>
    <Color x:Key="AccentHoverColor">#7F67BE</Color>
    <Color x:Key="TextColor">#1B1B1F</Color>
    <Color x:Key="TextMutedColor">#45464F</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#146C2E</Color>
    <!-- Зелёный поверх НАСЫЩЕННОГО акцента (выделенная строка списка): тёмно-зелёный там тонет,
         поэтому берётся светлый — ровно по той же причине, что и в остальных темах. -->
    <Color x:Key="SuccessOnAccentColor">#A6F0B5</Color>
    <Color x:Key="WarningColor">#8C4A00</Color>
    <Color x:Key="ErrorColor">#B3261E</Color>
    <Color x:Key="TagBgColor">#EADDFF</Color>
    <Color x:Key="RolledBackColor">#8C4A00</Color>
    <!-- Фон выделенной строки — светлый тон акцента, а не сам акцент: текст строки рисует
         ContentPresenter с общим тёмным Foreground, и на сплошном фиолетовом он был бы нечитаем
         (та же грабля подробно описана в Light.xaml). -->
    <Color x:Key="ListSelectedBgColor">#E8DEF8</Color>
    <Color x:Key="CautionColor">#9A6700</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessOnAccentBrush" Color="{StaticResource SuccessOnAccentColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
    <SolidColorBrush x:Key="TagBgBrush" Color="{StaticResource TagBgColor}"/>
    <SolidColorBrush x:Key="RolledBackBrush" Color="{StaticResource RolledBackColor}"/>
    <SolidColorBrush x:Key="ListSelectedBgBrush" Color="{StaticResource ListSelectedBgColor}"/>


    <!-- ФОРМА ТЕМЫ, а не только цвет. Замечания Ильи: «Стекло нихер не стекло», «Материал нихера не
         материал» — и он прав: материал и стекло узнают по скруглениям, воздуху и тени, а не по
         палитре. Поэтому форму задаёт сама тема, а стили её читают (см. CardBorder в Styles.xaml).
         У светлой и тёмной значения прежние: рабочая версия не должна измениться ни на пиксель. -->
    <CornerRadius x:Key="CardCorner">16</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
    <system:Double x:Key="CardShadowOpacity" xmlns:system="clr-namespace:System;assembly=System.Runtime">0.16</system:Double>

    <!-- Форма кнопок и пунктов меню. У material и стекла пункты — скруглённые «таблетки» без
         рамок: рамка вокруг каждой строки меню читается как сетка таблицы и спорит с заливкой
         активного пункта. У светлой и тёмной всё как было. -->
    <CornerRadius x:Key="NavCorner">14</CornerRadius>
    <Thickness x:Key="NavBorderThickness">0</Thickness>
    <!-- Фон НЕВЫБРАННОГО пункта меню. У material и стекла он прозрачный: белая плашка под каждой
         строкой превращает меню в список карточек и спорит с заливкой активного пункта — именно это
         и выглядело «не материалом». У светлой и тёмной — прежний цвет поля ввода. -->
    <SolidColorBrush x:Key="NavIdleBrush" Color="Transparent"/>

    <!-- ФОРМА КНОПОК И ПОЛЕЙ. Скругление — то, по чему мобильный интерфейс узнают раньше, чем
         прочитают хоть слово: «таблетка» кнопки и мягкое поле ввода и есть разница между
         «настольной программой из 2010-го» и тем, как сегодня выглядят Material и Liquid Glass.
         Карточки и меню уже умели это (CardCorner/NavCorner), а кнопки, поля и списки оставались с
         вшитым в стиль радиусом 6 — из-за этого Материал и Стекло и читались как «та же программа,
         перекрашенная».
         У светлой и тёмной — прежняя шестёрка: рабочая версия не должна измениться ни на пиксель. -->
    <CornerRadius x:Key="ButtonCorner">20</CornerRadius>
    <CornerRadius x:Key="ControlCorner">14</CornerRadius>

    <!-- ПЛОТНОСТЬ БОКОВОГО МЕНЮ. Илья про переделанные настройки: «вот настройки сделал хорошо прям
         организацию пространства, переработай и левую панель к такому дизайну». В настройках
         разделы стоят столбиком плотно (padding 12,6, зазор 1), а в главном меню пункты были
         заметно разреженнее (12,10 и зазор 3) — рядом это читалось как два разных приложения.
         Значения задаёт ТЕМА: у светлой и тёмной прежние, у «Материала» и «Стекла» — как в
         настройках. Так плотность меняется только там, где и сам дизайн новый. -->
    <Thickness x:Key="NavItemPadding">12,7</Thickness>
    <Thickness x:Key="NavItemMargin">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}"/>
    <Thickness x:Key="CardBorderThickness">0</Thickness>

    <!-- ОГОНЬ у пожарных шкафов: пламя под полосой загрузки, которое гасит вода.
         Оранжево-красный, а не красный ошибки: это не авария программы, а то, для чего
         шкаф предназначен. -->
    <Color x:Key="FireColor">#E8590C</Color>
    <SolidColorBrush x:Key="FireBrush" Color="{StaticResource FireColor}"/>

    <!-- ВИД ВТОРИЧНОЙ КНОПКИ И АКТИВНОГО ПУНКТА МЕНЮ.
         Material 3: tonal button (мягкая заливка оттенком акцента без рамки) и tonal container у выбранного пункта меню — текст при этом акцентный, а не белый. -->
    <SolidColorBrush x:Key="ButtonSoftBrush" Color="{StaticResource TagBgColor}"/>
    <SolidColorBrush x:Key="ButtonSoftTextBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ButtonSoftBorderBrush" Color="{StaticResource BorderColor}"/>
    <Thickness x:Key="ButtonSoftBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource TagBgColor}"/>
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="{StaticResource AccentColor}"/>
</ResourceDictionary>
