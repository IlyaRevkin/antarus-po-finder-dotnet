<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Mocha-based dark palette. Изначально бралась «как есть» из оригинального PySide6-
         приложения (accent #89b4fa, border #45475a, muted #6c7086) — это исходные Catppuccin-цвета
         "Blue"/"Surface2"/"Overlay0". Живой прогон тёмной темы показал, что часть из них даёт
         недостаточный контраст на реальных экранах приложения (см. правки ниже, у каждой — расчёт
         контраста по формуле относительной светлоты WCAG). "Overlay0" (#6C7086), например, в
         Catppuccin предназначен для некстовых элементов (иконки, обводки), а не для текста — здесь
         он использовался как текст (TextMutedColor) и проваливал контраст. -->

    <Color x:Key="BgColor">#1E1E2E</Color>
    <Color x:Key="BgSidebarColor">#181825</Color>
    <Color x:Key="BgCardColor">#2A2A3A</Color>
    <Color x:Key="BgInputColor">#313244</Color>
    <!-- Было #45475A (Catppuccin "Surface2") — контраст обводки полей ввода/карточек к фону всего
         ~1.8:1 к BgColor и ~1.4:1 к BgInputColor (WCAG-порог для непрозрачных границ UI — 3:1),
         рамки полей практически терялись на тёмном фоне. Заменено на Catppuccin "Overlay1" (#7F849C)
         — тот же приглушённо-серый характер, но контраст ~4.4:1 к BgColor / ~3.4:1 к BgInputColor /
         ~3.8:1 к BgCardColor — везде выше порога 3:1 для не-текстовых границ. -->
    <Color x:Key="BorderColor">#7F849C</Color>
    <!-- Было #89B4FA (Catppuccin "Blue") — светлый пастельный акцент. Сам по себе с тёмным текстом
         поверх (старый TextOnAccentColor) давал хороший числовой контраст (~7.8:1), но выглядел
         "кислотно"-светлым для тёмной темы и визуально сливался с окружающими светлыми элементами
         (жалоба: активный пункт сайдбара трудно читается). Заменено на насыщенный тёмный синий —
         тот же приём, что уже применён в Light.xaml для AccentColor (#1E66F5, тёмный синий + белый
         текст), адаптированный под тёмную тему. Новый AccentColor#2A66D9: контраст с белым текстом
         (новый TextOnAccentColor) ~5.25:1 (порог WCAG для обычного текста — 4.5:1), контраст самой
         акцентной заливки к BgColor ~3.13:1 (порог для не-текстовых элементов/области — 3:1). -->
    <Color x:Key="AccentColor">#2A66D9</Color>
    <!-- Было #74A6F8 (светлее, чем старый AccentColor — ховер "высветлял" пастельный акцент). При
         тёмном насыщенном AccentColor этот приём ломает контраст: у ховера меняется только фон,
         Foreground остаётся TextOnAccentBrush (белый), а более светлый ховер-оттенок увёл бы
         контраст белого текста ниже 4.5:1. Поэтому направление изменено на затемнение (как и было
         устроено раньше для старого светлого акцента, только зеркально) — новый AccentHoverColor
         #2252AE даёт контраст с белым текстом ~7.3:1, ещё выше базового акцента. -->
    <Color x:Key="AccentHoverColor">#2252AE</Color>
    <Color x:Key="TextColor">#CDD6F4</Color>
    <!-- Было #6C7086 (Catppuccin "Overlay0" — по назначению для не-текстовых элементов, не для
         текста). Контраст к фонам приложения: ~3.4:1 (BgColor) / ~2.9:1 (BgCardColor) / ~3.6:1
         (BgSidebarColor) / ~2.6:1 (BgInputColor) — везде ниже порога 4.5:1 для обычного текста,
         приглушённый текст местами сливался с фоном. Заменено на Catppuccin "Subtext0" (#A6ADC8) —
         цвет из той же палитры, официально предназначенный именно для второстепенного, но читаемого
         текста. Контраст: ~7.4:1 (BgColor) / ~6.3:1 (BgCardColor) / ~7.9:1 (BgSidebarColor) /
         ~5.7:1 (BgInputColor) — везде выше 4.5:1, при этом заметно тусклее основного TextColor. -->
    <Color x:Key="TextMutedColor">#A6ADC8</Color>
    <!-- Было #1E1E2E (= BgColor, тёмный текст поверх акцента). Числовой контраст с прежним светлым
         AccentColor был неплох (~7.8:1), но вместе с "кислотным" светлым акцентом создавал ощущение
         низкого контраста (см. правку AccentColor выше). Теперь, когда AccentColor — насыщенный
         тёмный синий, белый текст поверх него — консистентная и предпочтительная пара (см. задание):
         контраст ~5.25:1 на базовом акценте, ~7.3:1 на ховер-оттенке — оба выше порога 4.5:1. -->
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#A6E3A1</Color>
    <!-- Было #40A02B (тёмно-зелёный, "позаимствован" из Light.xaml — там он читался на тогдашнем
         светлом Dark-акценте). Теперь, когда AccentColor в этой теме сам стал тёмным насыщенным
         синим (см. выше), тёмно-зелёный на тёмно-синем фоне сливается. Симметрично Light.xaml (где
         SuccessOnAccentColor = светло-зелёный #A6E3A1, потому что светлый AccentColor этой темы —
         тоже тёмный синий), здесь теперь используется тот же светлый зелёный — де-факто совпадает
         с собственным SuccessColor темы. Контраст на новом AccentColor ~3.5:1 — тот же порядок, что
         и у аналогичной пары в Light.xaml (~3.3:1 на #1E66F5); это кратковременная вспышка-индикатор
         поверх уже выделенной (акцентом) строки, а не постоянно читаемый текст — см.
         CopyableVersionText.Label_Click. -->
    <Color x:Key="SuccessOnAccentColor">#A6E3A1</Color>
    <Color x:Key="WarningColor">#FAB387</Color>
    <Color x:Key="ErrorColor">#F38BA8</Color>
    <Color x:Key="TagBgColor">#313244</Color>
    <!-- Было #B85C00 — контраст к BgColor всего ~3.6:1, к BgCardColor ~2.7:1 (порог для текста —
         4.5:1); HistoryDialog/SettingsView показывают этим цветом текст "откачена" в таблицах на
         тёмном фоне карточек. Приподнято до #E08425 (тот же оранжево-янтарный тон, светлее) —
         контраст ~5.9:1 (BgColor) / ~5.0:1 (BgCardColor). Light.xaml не трогаю — там тот же
         #B85C00 на светлом фоне даёт контраст с большим запасом. -->
    <Color x:Key="RolledBackColor">#E08425</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessOnAccentBrush" Color="{StaticResource SuccessOnAccentColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="TagBgBrush" Color="{StaticResource TagBgColor}"/>
    <SolidColorBrush x:Key="RolledBackBrush" Color="{StaticResource RolledBackColor}"/>

</ResourceDictionary>
