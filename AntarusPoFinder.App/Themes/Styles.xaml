<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AntarusPoFinder.App.Converters"
                    xmlns:views="clr-namespace:AntarusPoFinder.App.Views">

    <!-- Declared here (not App.xaml) because StaticResource lookups inside a merged dictionary
         can't see keys defined in the outer dictionary that merges it in — only DynamicResource
         can reach "outward" at runtime. Styles.xaml needs this at parse time, so it must own it. -->
    <conv:DisplayMemberPathConverter x:Key="DisplayMemberPathConverter"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Внешний вид подсказок. Скорость их появления задаётся НЕ здесь: ToolTipService.
         InitialShowDelay/ShowDuration — присоединённые свойства ЭЛЕМЕНТА-владельца (любого
         FrameworkElement), а не самого ToolTip, и неявным стилем их на всё приложение не выставить —
         пришлось бы перечислять каждый тип контрола, включая Border и RadioButton, у которых своего
         неявного стиля здесь нет. Поэтому они переопределены разом для FrameworkElement в
         App.OnStartup (см. ApplyToolTipTiming) — единственный способ накрыть всё приложение. -->
    <!-- Перенос текста подсказки по строкам. Задаётся ЯВНЫМ шаблоном, а не неявным стилем
         TextBlock: строку WPF рисует TextBlock'ом из собственного шаблона ContentPresenter, а
         внутри шаблона неявные стили ищутся в ресурсах самого шаблона и приложения — но не в
         окружающем дереве. Из-за этого стиль, положенный рядом с ContentPresenter (в ресурсы
         Border внутри шаблона ToolTip), до сгенерированного TextBlock не доезжал: две прошлые
         попытки «включить переносы всем подсказкам» ничего не меняли, длинная подсказка так и
         оставалась одной строкой и обрезалась по MaxWidth. Подробнее — в
         ToolTipTextTemplateSelector. -->
    <conv:ToolTipTextTemplateSelector x:Key="ToolTipTextTemplate">
        <conv:ToolTipTextTemplateSelector.TextTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=Foreground}"/>
            </DataTemplate>
        </conv:ToolTipTextTemplateSelector.TextTemplate>
    </conv:ToolTipTextTemplateSelector>

    <Style TargetType="{x:Type ToolTip}">
        <!-- Непрозрачная поверхность: подсказка — тоже всплывающее окно (см. PopupBgBrush). -->
        <Setter Property="Background" Value="{DynamicResource PopupBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <!-- Ширина, на которой подсказка переносится. 420 против прежних 480: подсказка не должна
             растягиваться через пол-экрана, а на самой узкой рабочей машине (1366 точек) обязана
             помещаться целиком вместе с отступами всплывающего окна. -->
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="ContentTemplateSelector" Value="{StaticResource ToolTipTextTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <!-- На случай составной подсказки из готовых контролов: её шаблон-селектор
                             пропускает как есть, и переносы ей задаёт этот неявный стиль. -->
                        <Border.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </Border.Resources>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator never had an app style, so every one of them rendered with the OS's default Aero
         bevel chrome (a light-on-top/dark-on-bottom 3D groove) — designed for a light theme, so
         against this app's dark sidebar/cards it read as an odd bright sliver instead of a plain
         divider line, most noticeable right under the role label at the top of the sidebar. A flat
         1px line in the theme's own border color reads consistently everywhere a Separator is used. -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- Primary accent button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- A bare Content="…" string gets wrapped by WPF in a TextBlock generated by
             ContentPresenter's own default template for string content — an implicit Style targeting
             TextBlock (even one scoped to Border.Resources right next to the ContentPresenter, which
             is what three earlier rounds tried) does not reliably win against the app-wide implicit
             TextBlock style (Foreground=TextBrush, dark in light theme): every plain-text primary
             button ("Сохранить", "Найти", "Загрузить прошивку", "Все загруженные", …) kept rendering
             dark text on the accent-blue background in light theme regardless. An explicit
             ContentTemplate sidesteps implicit-style resolution entirely — the TextBlock's Foreground
             is a direct Binding (a local value, which unconditionally outranks any Style setter),
             matching the pattern already proven to work for SearchModeSegment/NavButtonContentText
             below. Every default-styled Button in this app has plain string Content (verified via
             grep before adding this) — a composite icon+text button would need its own explicit
             Style, since this ContentTemplate assumes Content is text. -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>

    <!-- Secondary (outline) button -->
    <!-- Вид вторичной кнопки задаёт ТЕМА. У светлой и тёмной это обведённая кнопка, как было.
         У «Материала» — tonal button: мягкая заливка оттенком акцента без рамки, ровно как у
         Android (жалоба «материал всё ещё не как у андроид» — обведённые серые кнопки и были
         главным, что выдавало чужой стиль). У «Стекла» — почти прозрачная поверхность со светлой
         гранью, как кнопки в системах Apple. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonSoftTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ButtonSoftBorderThickness}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ButtonCorner}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Компактный вариант того же вида — для рядов кнопок под drag&amp;drop-зонами и под таблицами,
         где полная высота выглядит громоздко.

         Зачем отдельный стиль, а не Height="30" на самой кнопке: у SecondaryButton вертикальный
         Padding 8+8 плюс рамка 1+1, т.е. содержимому нужно ~35px. Жёстко заданная меньшая Height
         (30 у кнопок под HMI-зоной, 32 у кнопок «Параметров») не уменьшала padding, а обрезала
         ContentPresenter — ровно та самая жалоба «кнопки под drag&amp;drop-зоной обрезаны». Здесь
         padding уменьшен вместе с высотой, и это MinHeight, а не Height, — текст не может быть
         обрезан снова, даже если шрифт/тема станут крупнее. -->
    <Style x:Key="CompactSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="30"/>
    </Style>

    <!-- Danger button (delete actions) -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <!-- Sidebar nav button: reads as a real button at rest (subtle fill+border, like
         SecondaryButton) so it doesn't blend into the sidebar background next to bordered
         siblings such as "Сменить роль" — highlighted stronger when Tag="Active" -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource NavIdleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource NavBorderThickness}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="{DynamicResource NavItemPadding}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource NavCorner}" Padding="{TemplateBinding Padding}"
                            Margin="{DynamicResource NavItemMargin}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <!-- Активный пункт: у светлой и тёмной — сплошной акцент, как было. У
                             «Материала» — tonal container (мягкая заливка, текст акцентом): так
                             выглядит выбранный пункт в Material 3. У «Стекла» — полупрозрачный
                             акцент, как выделение в системах Apple. Цвета берёт тема. -->
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavActiveBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NavActiveTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text style for plain-string Button.Content on a NavButton/CompactNavButton whose Tag is
         toggled to "Active" from code-behind (e.g. SettingsView's tab bar) — a bare Content="…"
         string gets wrapped by WPF in an implicit-styled TextBlock (Foreground=TextBrush per the
         app-wide TextBlock style above), which has HIGHER precedence than the Foreground NavButton's
         own Tag="Active" trigger sets on the Button — so without this, active-tab text stayed dark
         on the accent-blue background in light theme. Same root cause/fix as the sidebar nav list's
         and SearchModeSegment's per-instance TextBlock+DataTrigger, extracted here since SettingsView
         repeats this exact button shape seven times. -->
    <Style x:Key="NavButtonContentText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Style.Triggers>
            <!-- Цвет активного пункта берётся у темы (NavActiveTextBrush), а не как «белое на
                 акценте»: у «Материала» выбранный пункт — tonal container, там заливка светлая, и
                 белый текст на ней не виден вовсе. Проверено снимком: при жёстком
                 TextOnAccentBrush подпись «Общие» пропадала. -->
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Active">
                <Setter Property="Foreground" Value="{DynamicResource NavActiveTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon-only square button -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Smaller variant of NavButton for the sidebar's secondary "ДОПОЛНИТЕЛЬНО" strip (Тикеты/
         Сетевые диски/Обучение) — same look/active-state behavior, just more compact since these
         are used far less often than the main page list above it. -->
    <Style x:Key="CompactNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

        <!-- Заголовок свёрнутой секции сайдбара: чеврон + подпись из Content. Один на обе секции —
         «ДЛЯ НАЛАДЧИКА» и «ДОПОЛНИТЕЛЬНО». Раньше их было два: у второй подпись была вшита прямо в
         шаблон, из-за чего рядом жили два одинаковых стиля, которые надо было править парой. Секции
         одинаковы по смыслу и обязаны выглядеть одинаково — значит и стиль у них один. -->
    <Style x:Key="SidebarSectionHeader" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Chevron" Text="&#8250;" FontSize="12" Width="14"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource MutedText}"
                                       FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="&#8964;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Свёрнутый по умолчанию блок необязательных полей на форме (напр. "ОПЦИИ ВЕРСИИ" в
         UploadView) — тот же чеврон-паттерн, что у SidebarSectionHeader выше и по той же причине
         (обычный WPF Expander со стандартным хромом смотрелся бы светлым инородным пятном на тёмной
         теме), но уже полноценный Expander с раскрывающимся Content, а не просто заголовок-кнопка.

         Собственный шеврон (Chevron ниже) скрыт (Visibility="Collapsed") — единственный потребитель
         этого стиля, ExtrasExpander в UploadView.xaml (проверено grep'ом — других мест, где
         SectionExpander применяется, в приложении нет), оборачивает Header в свою карточку с
         крупной стрелкой ▸/▾ и подсказкой "нажмите, чтобы развернуть/свернуть" (пользователь на
         живом прогоне не заметил мелкий 12px-шеврон и не понимал, что заголовок кликабелен). Без
         Collapsed обе стрелки рисовались одновременно — путаница "две стрелки разворачивания".
         Кликабельность заголовка (курсор-рука, переключение IsExpanded) не зависит от видимости
         самого текста шеврона — она даёт весь ToggleButton целиком, так что скрытие Chevron ничего
         не ломает. Если у SectionExpander появится другой потребитель без своей стрелки в Header —
         эту Visibility нужно будет пересмотреть (например, вынести в отдельный ключ стиля). -->
    <Style x:Key="SectionExpander" TargetType="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                      HorizontalContentAlignment="Left" Padding="0,4"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron" Text="&#8250;" FontSize="12" Width="14"
                                                       Visibility="Collapsed"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#8964;"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round "dock" icon button for the Быстрый доступ strip above the page content (see
         MainWindow.xaml) — a plain circle with the shortcut's own icon centered in it. -->
    <Style x:Key="QuickAppBubbleButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{DynamicResource BgInputBrush}" Stroke="{DynamicResource BorderBrush2}" StrokeThickness="1"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bg" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ПОЛЕ ВВОДА СО СВОИМ ШАБЛОНОМ. Раньше здесь стояли одни setter'ы, то есть поле рисовал
         стандартный шаблон WPF — а он про CornerRadius не знает вовсе, и скругление, заданное
         темой, на поля просто не действовало. В Материале и Стекле из-за этого кнопки и карточки
         были скруглёнными, а поля оставались строго прямоугольными: именно это несовпадение и
         выдавало «перекрашенную старую программу».

         Шаблон минимальный: рамка, внутри PART_ContentHost (его имя обязательно — через него
         TextBox рисует и редактирует текст). Плюс подсветка рамки акцентом при наведении и фокусе:
         так ведут себя поля и в Material, и в системных настройках, а раньше поле никак не
         показывало, что оно сейчас принимает ввод. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- ⚠️ ВЕРТИКАЛЬНОГО ОТСТУПА НЕТ, и это не недосмотр.
             Высота полей в программе задана числом (30, 32, 34, 38 — они стоят в ряд с кнопками и
             списками). Отступ 6 сверху и снизу плюс рамка съедали 14 пикселей из этой высоты: в
             поле 30 строка не помещалась ВООБЩЕ (жалоба «я нажал сформировать паспорт и текст в
             поле ввода вообще не видно»), в 32–34 обрезалась снизу, в 38 сидела у нижнего края
             («в поиске всё ещё текст уехавший вниз»). Это видно на пробе из ViewsRenderTests.
             Положение строки по высоте задаёт VerticalContentAlignment ниже, и для этого ей нужна
             вся высота поля. Многострочным полям отступ возвращается триггером в конце стиля:
             там текст начинается сверху, и прижимать его к самой рамке нельзя. -->
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <!-- ТЕКСТ ПО ЦЕНТРУ ПОЛЯ. У однострочных полей высота задана жёстко (34 почти везде), а
             содержимое по умолчанию прижимается к верху — со скруглением «Материала» это читалось
             как «текст не влезает» (дословная жалоба Ильи по 2.0.0.4). Многострочным полям центр
             противопоказан: там текст обязан начинаться сверху, поэтому ниже стоит триггер. -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- ⚠️ ОТСТУП — У РАМКИ, выравнивание содержимого НЕ ТРОГАЕМ.
                         Так устроен штатный шаблон WPF, и отступать от него здесь нельзя. В первой
                         версии этого шаблона отступ был задан полем (Margin) у ScrollViewer плюс
                         VerticalAlignment по VerticalContentAlignment — и текст в полях уезжал вниз
                         или пропадал из виду вовсе (жалобы Ильи по бете: «я нажал сформировать
                         паспорт и текст в поле ввода вообще не видно», «в поиске всё ещё текст
                         уехавший вниз»). Вертикальное положение текста TextBox считает сам, по
                         своему VerticalContentAlignment, и ему для этого нужен ScrollViewer,
                         растянутый на всю рамку. -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="8,6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Без вертикального отступа — по той же причине, что у TextBox выше. -->
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <!-- Отступ у рамки, выравнивание содержимого не трогаем — см. комментарий
                         у TextBox выше: иначе текст уезжает вниз или пропадает. -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem for the dropdown popup list — WPF's default draws these with system
         chrome (near-white background regardless of app theme), so it needs a full template
         like the buttons above, not just property setters. -->
    <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <!-- Полоса-индикатор слева (BorderThickness 3,0,0,0) отмечает выбранную строку.
                         Ховер/выделение окрашивают ТОЛЬКО фон нейтральным тоном (BgSidebarBrush),
                         который читается с обычным цветом текста в ОБЕИХ темах. Раньше подсветка красила
                         фон в синий AccentBrush и рассчитывала на светлый Foreground через implicit-стиль
                         TextBlock в Border.Resources — но у DisplayMemberPath/ItemTemplate-контента этот
                         стиль до сгенерированного шаблоном текста НЕ доходит (implicit-стиль из .Resources
                         элемента шаблона не попадает в область поиска для контента ContentPresenter),
                         поэтому app-wide тёмный TextBrush выигрывал → «чёрный текст на синем» в светлой
                         теме (в тёмной TextBrush и так светлый, оттого жалоба только про светлую). Также
                         прежний IsSelected=BgInputBrush в светлой теме = #FFFFFF, т.е. невидим на белом
                         фоне выпадающего списка. Нейтральный фон + акцентная полоса убирают саму
                         зависимость от прокраски текста. -->
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Неявный (без ключа) стиль ComboBoxItem = ThemedComboBoxItem, чтобы КАЖДЫЙ выпадающий список
         в приложении получал темизированные пункты автоматически, а не только те ComboBox, к которым
         явно применён ItemContainerStyle через implicit-стиль ComboBox ниже. Реальный баг, найденный
         живым прогоном: комбобокс роли в окне «Смена роли» (RoleSwitchDialog, отдельное Window) не
         подхватывал ItemContainerStyle и рисовал выбранный пункт СИСТЕМНЫМ синим фоном с тёмным
         текстом — «чёрное на синем» в светлой теме, ровно как жаловался пользователь. Implicit-стиль
         покрывает все окна и диалоги разом. -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemedComboBoxItem}"/>

    <!-- ComboBox — same reasoning as ComboBoxItem above: the default template's "closed" display
         area ignores our Background/Foreground setters (renders near-white regardless of theme),
         so it needs a full custom template rather than property setters alone. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCorner}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource DisplayMemberPathConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="SelectedItem"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="DisplayMemberPath"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Path Grid.Column="1" Data="M4,7 L10,13 L16,7" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <!-- Непрозрачная поверхность (PopupBgBrush), а не фон карточки: список
                                 висит НАД окном, и в «Стекле» сквозь полупрозрачную карточку был бы
                                 виден рабочий стол. -->
                            <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource ControlCorner}" Margin="0,4,0,0"
                                    Width="{TemplateBinding ActualWidth}" MaxHeight="320">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ListBoxItem — like ComboBoxItem, WPF's default draws these with system chrome (white
         background regardless of app theme), so it needs a full template. -->
    <Style TargetType="ListBoxItem">
        <!-- Контраст выделения (жалоба: тёмный текст на синем фоне в списках «Производители ПЧ/УПП» и
             «Разрешённые расширения» в Настройки → Иерархия — нечитаемо в светлой теме).
             Содержимое такой строки — простой текст (строка/DisplayMemberPath или Content у ListBoxItem-
             объектов, см. ExtList в SettingsView), для которого ContentPresenter создаёт TextBlock сам.
             Этот TextBlock берёт app-wide implicit-стиль TextBlock (Foreground=TextBrush) — ни локальный
             стиль ListBoxItem, ни его триггер, ни implicit-стили в Style.Resources/шаблоне до него НЕ
             достают (проверено вживую: попытка переключить Foreground на TextOnAccentBrush эффекта не
             давала). Поэтому текст выделенной строки всегда TextBrush — и фон выделения выбран так, чтобы
             ИМЕННО с TextBrush он читался в обеих темах: ListSelectedBgBrush (светло-синий в светлой,
             приглушённо-синий в тёмной). Ховер — BgSidebarBrush (виден в обеих темах и отличается от
             выделения). Foreground при выделении НЕ трогаем (остаётся TextBrush — то, что реально видно). -->
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ListSelectedBgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ListBox — the default panel/scrollviewer chrome is also system-white regardless of theme. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCorner}">
                        <ScrollViewer Padding="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGridColumnHeader — like ComboBox above, WPF's default header chrome is drawn by the
         system theme (near-white background) and ignores the DataGrid's own Background setter,
         so it needs its own full template. Must keep PART_LeftHeaderGripper/PART_RightHeaderGripper
         Thumbs (DataGridColumnHeader wires their drag events by name in OnApplyTemplate) — the
         plain Border+ContentPresenter template this replaced dropped them, which silently disabled
         column-resize-by-dragging everywhere in the app. Grippers get an explicit ControlTemplate
         (not just Background="Transparent") — a bare Thumb otherwise falls back to the system Thumb
         chrome, which paints a bright bevel that ignores WPF's Background property and showed up as
         stray white bars over the dark theme. Also shows a small arrow glyph: dim on every sortable
         column as a "click to sort" affordance, full-opacity and pointed the right way once the
         header's own SortDirection actually reflects a sorted column. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                <Path x:Name="SortArrow" Grid.Column="1" Width="8" Height="5" Stretch="Fill"
                                      Fill="{TemplateBinding Foreground}" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Opacity="0.4" Data="M0,5 L8,5 L4,0 Z"/>
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="4" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Opacity" Value="1"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M0,5 L8,5 L4,0 Z"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Opacity" Value="1"/>
                            <Setter TargetName="SortArrow" Property="Data" Value="M0,0 L8,0 L4,5 Z"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Заголовок столбца по центру — для колонок с центрированным содержимым (DataGridCellTextCentered):
         иначе содержимое ячеек по центру, а подпись столбца прижата влево (HorizontalContentAlignment="Left"
         в базовом стиле выше) — столбец читается «не по центру». Применяется точечно через HeaderStyle. -->
    <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Width" Value="0"/>
    </Style>

    <!-- DataGridRow — до этой правки отдельного стиля не было вовсе, поэтому строка выделения/
         наведения бралась из системной темы Windows (Aero2/Classic), а не из палитры приложения:
         системная подсветка красит фон под системный акцентный цвет (не обязательно совпадает с
         AccentBrush темы) и не трогает Foreground — обычно это "пряталось" за тем, что DataGridCell
         ниже сам красит Background/Foreground при выделении поверх строки, но для НЕ выделенных
         строк (обычное наведение мышью) фон строки был не наш — сквозь прозрачный (по умолчанию)
         фон DataGridCell была видна either системная, либо вовсе никакая подсветка, в зависимости от
         темы Windows у конкретного пользователя. Теперь строка держит свой вид полностью в рамках
         приложения и теми же двумя ресурсами, что и DataGridCell ниже (один источник истины для
         обоих состояний, а не два независимых): в покое — прозрачна (виден RowBackground/
         AlternatingRowBackground у самого DataGrid), при наведении — лёгкий тон BgSidebarBrush
         (текст не переключаем, обычный TextBrush на этом тоне достаточно контрастен в обеих темах),
         при выделении — AccentBrush/TextOnAccentBrush, совпадающие с тем, что делает DataGridCell. -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <!-- DataGridTextColumn generates a plain TextBlock as each cell's content — same
             implicit-style-precedence issue as PrimaryButton above: the app-wide TextBlock style
             (Foreground=TextBrush) beats whatever this cell's own Foreground is, so a selected
             row (Background=AccentBrush) still showed dark, unreadable text in light theme. Bound
             (not hardcoded) so it tracks whichever Foreground the trigger below currently applies. -->
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Foreground}"/>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Готовые ElementStyle для DataGridTextColumn — единый вид ячейки во всех таблицах приложения
         (см. HierarchyGrid/ControllersGrid/ModGrid/FwGrid/ReservationsGrid/UsersGrid в SettingsView):
         однострочный текст с многоточием вместо переноса (высота строки в RoomyDataGrid фиксирована,
         перенос всё равно обрежется по высоте) и вертикальное центрирование. Foreground намеренно НЕ
         задаётся здесь: явный ElementStyle (в отличие от обычного нестилизованного TextBlock выше)
         заменяет собой implicit-резолюцию стиля целиком, поэтому Foreground этого TextBlock просто
         наследуется (Foreground — inherited-свойство) от родительской DataGridCell — а она уже
         переключает Foreground на TextOnAccentBrush при выделении (см. стиль DataGridCell выше), и
         это наследование ничем не перекрывается, раз Setter на Foreground здесь отсутствует. -->
    <Style x:Key="DataGridCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <!-- Полный текст подсказкой — но только у ячейки, где он не поместился (см. CellTextTip:
             подсказку обязательно задать здесь, иначе WPF не станет её открывать и отменять будет
             нечего). Длинный адрес на хостинге или причина отказа читались раньше только после
             растягивания столбца. -->
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        <Setter Property="views:CellTextTip.OnlyWhenTrimmed" Value="True"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
    </Style>

    <!-- Тот же вид, но С ПЕРЕНОСОМ строк. Заведён по жалобе на таблицу параметров: «некоторый текст
         не влазит» — названия параметров и их описания в исходных файлах бывают в полторы строки, и
         обрезка многоточием превращала самую нужную колонку в загадку. Подсказка при наведении
         остаётся (наследуется), но подсказку надо ещё догадаться вызвать, а прочитать текст глазами
         человек хочет сразу.

         ⚠️ Сам по себе перенос ничего не даёт: у RoomyDataGrid высота строки задана числом, и
         вторая строка текста просто обрезается. Работает он только вместе с WrappingDataGrid ниже.
         VerticalAlignment=Top — иначе однострочные ячейки в высокой строке висят по центру, а
         многострочные начинаются выше них, и глазу не за что зацепиться. -->
    <Style x:Key="DataGridCellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,7,0,7"/>
    </Style>

    <!-- Тот же вид, но по центру — для коротких/числовых полей (короткие коды, даты, статусы),
         см. "числа/короткие поля по центру" в списке правок таблиц. HorizontalAlignment="Stretch"
         обязателен: без него TextBlock сжимается до ширины текста и TextAlignment="Center" внутри
         него самого же ничего не центрирует относительно всей ячейки. -->
    <Style x:Key="DataGridCellTextCentered" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellText}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="RowBackground" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <!-- Более просторный вариант обычного DataGrid — единый вид для ВСЕХ информационных таблиц
         Настроек (Иерархия/Прошивки/Резервация номеров/Пользователи/Модерация — раньше только
         Иерархия использовала этот стиль, у остальных были более тесные стандартные высоты строк/
         заголовков, из-за чего таблицы на разных вкладках выглядели по-разному). Не трогает базовый
         стиль DataGrid выше — тот остаётся общим на всё приложение (в т.ч. таблицы вне Настроек, не
         переведённые на этот стиль явно), RoomyDataGrid применяется точечно через Style="{StaticResource RoomyDataGrid}". -->
    <Style x:Key="RoomyDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="ColumnHeaderHeight" Value="38"/>
        <!-- Вертикальные разделители между колонками. Базовый стиль DataGrid рисует только
             горизонтальные линии; в таблице иерархии из-за этого «Тип шкафа» (короткие ПЖ/НГР слева)
             визуально сливался с соседним «Префикс типа» — жалоба «тип шкафа к левому краю съехал и
             слипся». Тем же тоном, что и горизонтальные линии (BorderBrush2), чтобы вид оставался
             единым, а не появлялась жирная сетка. -->
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush2}"/>
    </Style>

    <!-- Таблица, у которой строка растёт под содержимое. Нужна там, где в ячейке живёт не поле
         базы, а фраза человека: названия параметров ПЧ и их описания взяты из накопленных
         текстовых файлов и в одну строку не помещаются.

         Высота НЕ фиксируется, но и не отпускается совсем: MinRowHeight держит тот же ритм (34),
         что и у остальных таблиц программы, — иначе однострочные таблицы в этом стиле выглядели бы
         теснее соседних экранов.

         ⚠️ Виртуализация строк при этом работает хуже: WPF не может посчитать высоту заранее.
         Ставить этот стиль на таблицы в тысячи строк не надо — здесь их полсотни. -->
    <!-- ⚠️ Наследовать RoomyDataGrid здесь НЕЛЬЗЯ, хотя набор настроек тот же минус один. У
         RoomyDataGrid высота строки задана числом, а «отпустить» её значением «Auto» не выходит:
         DataGrid.RowHeight — это обычный double, и разбор XAML на строке «Auto» падает
         XamlParseException прямо при открытии окна (поймано живым прогоном). Свести к
         double.NaN через x:Static можно, но читается это хуже, чем два повторённых Setter'а. -->
    <Style x:Key="WrappingDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="MinRowHeight" Value="34"/>
        <Setter Property="ColumnHeaderHeight" Value="38"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush2}"/>
    </Style>

    <!-- Заголовок РАЗДЕЛА внутри таблицы: строка через всю ширину с линией под ней. Заведён по
         жалобе владельца: «визуально нет разделения разделов, как в том же txt у нас разделено
         визуально линией и удобно для чтения». В исходных файлах разделы отбиты строками
         «=========[Настройка ШУ]», и глазами это читается мгновенно; в таблице же группа была
         обычным значением первой колонки, повторявшимся из строки в строку.

         Линия — снизу и тем же тоном, что и сетка таблицы (BorderBrush2): это отбивка, а не рамка. -->
    <Style x:Key="DataGridGroupHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <!-- Полоса заголовка отличается от полотна таблицы поверхностью, а не цветом текста: в
             тёмной теме сайдбарный тон темнее карточки, в светлой — серее белого, и в обеих
             обычный TextBrush читается на ней с запасом. -->
        <Setter Property="Background" Value="{DynamicResource BgSidebarBrush}"/>
        <Setter Property="Padding" Value="10,5,10,4"/>
    </Style>

    <Style x:Key="DataGridGroupHeaderText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ПОДЗАГОЛОВОК БЛОКА внутри раздела — вторым уровнем под заголовком раздела: «Только для
         ПЧ №1», «Для 55 ГЦ». Заведён по третьему подряд замечанию владельца о нечитаемости
         таблицы параметров.

         В исходном txt применимость и условие записаны ИМЕННО ТАК — заголовком над куском строк
         («<<<<<[Только для ПЧ №1]», «[Для 55 ГЦ]» под строкой из чёрточек), прочитанным один
         раз на весь кусок.
         Разбор превратил их в поля строки (и правильно: по ним идёт отбор), а показ — в две
         колонки у правого края, которые на живом корпусе заполнены в 3 % и 0,2 % строк и при
         этом всегда занимают ширину. При размере окна по умолчанию «Когда нужно» не помещалась
         вовсе, и увидеть её можно было только горизонтальной прокруткой.

         Легче заголовка раздела намеренно: раздел — это «=========[Настройка ШУ]», а блок внутри
         него подчинён ему. Отсюда и заливки нет, и линия тоньше — иначе два уровня отбивки
         спорили бы друг с другом, а таблица снова стала бы рябой. -->
    <Style x:Key="DataGridBlockHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,3,10,2"/>
    </Style>

    <!-- ⚠️ Цвет — обычный TextBrush, а НЕ AccentBrush, хотя акцент напрашивался. В тёмной теме
         акцент (#2A66D9) на полотне карточки (#2A2A3A) даёт контраст 2,7:1 — подпись, ради
         которой всё и затевалось, читалась бы хуже строк под ней. Подчинённость показана
         курсивом и кеглем, а не приглушением: приглушённая подпись — это ровно та беда, от
         которой уходим. -->
    <Style x:Key="DataGridBlockHeaderText" TargetType="TextBlock">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Кнопка-иконка «i»: длинное объяснение открывается по клику, а не висит абзацем на форме.
         Заведена была локально в окне смены роли, теперь общая — по жалобе на окно входа: «куча
         лишнего текста, не спрятанного в подсказку на кнопку i». Три-четыре абзаца пояснений
         превращали форму из двух полей в простыню, которую всё равно не читают, а нужное — логин,
         пароль, кнопка — в ней терялось.

         ToggleButton, а не Button: рядом стоит Popup, привязанный к IsChecked в обе стороны. Popup
         сбрасывает своё IsOpen сам при клике мимо (StaysOpen=False), и только TwoWay-биндинг
         возвращает это состояние тумблеру — иначе после автозакрытия он остаётся «нажатым» и
         открыть подсказку снова получается лишь со второго клика.

         Подпись у кнопки задаётся на месте (ToolTip): «подробнее о входе по AD» и «подробнее об
         аварийном входе» — разные вещи. -->
    <Style x:Key="InfoIconButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="ToolTip" Value="Подробнее"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <TextBlock Text="i" FontStyle="Italic" FontWeight="Bold" FontSize="11"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пузырь с подробностями рядом с кнопкой «i». Ширина ограничена: длинный текст в одну строку
         уехал бы за край экрана. -->
    <Style x:Key="InfoPopupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Card container (search results, dialogs) -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <!-- Толщина рамки — у темы. В «Материале» карточку отделяет от фона тень и свой тон
             поверхности, а не линия: обведённая карточка там выглядит как таблица, а не как
             карточка. У светлой и тёмной рамка прежняя. -->
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
        <!-- Скругление, отступы и тень берутся У ТЕМЫ: материал узнают по крупным радиусам и мягкой
             тени, стекло — по ещё более крупным и по свету по краю. У светлой и тёмной значения те
             же, что были, — рабочая версия не меняется. -->
        <Setter Property="CornerRadius" Value="{DynamicResource CardCorner}"/>
        <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
        <!-- ⚠️ ТЕКСТ ВНУТРИ КАРТОЧКИ ОБЯЗАН ОСТАВАТЬСЯ ЧЁТКИМ.
             Любой Effect в WPF выключает субпиксельное сглаживание (ClearType) во ВСЁМ поддереве:
             буквы начинают рисоваться серым сглаживанием и выглядят мыльными. Жалоба Ильи по бете
             2.0.0.6: «в настройках во вкладке общее блок оформление будто бы размыт» — это ровно
             оно, и заметно стало тогда, когда тень у «Материала» сделали видимой.
             ClearTypeHint="Enabled" возвращает чёткость: фон карточки непрозрачный, значит
             субпиксельное сглаживание по нему считается корректно. -->
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="Effect">
            <Setter.Value>
                <!-- Тень мягкая и почти без смещения: карточка «приподнята», а не отбрасывает
                     театральную тень вбок. Прозрачность задаёт тема — у светлой и тёмной это ноль,
                     то есть тени нет вовсе и отрисовка не дорожает. -->
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Color="#000000"
                                  Opacity="{DynamicResource CardShadowOpacity}" RenderingBias="Performance"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashed drop-zone border, for drag&drop targets -->
    <Style x:Key="DropZoneBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Плитка-слот для необязательного вложения на UploadView (Карта ВВ / Карта modbus /
         Инструкция, см. FileSlotController) — компактная замена трём всегда-развёрнутым рядам
         "подпись + TextBox + три кнопки". Пустая приглушена (обычная рамка), заполненная выделяется
         акцентом успеха (SuccessBrush), чтобы «файл выбран» читалось с одного взгляда, ещё до чтения
         текста внутри. Второй визуальный режим переключается через Tag="Filled" — тот же приём, что
         и у NavButton (Tag="Active") выше: обычный DataTrigger по Tag, никакого хардкода цвета, обе
         темы подхватываются через DynamicResource как обычно. -->
    <Style x:Key="FileSlot" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Filled">
                <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tag bubble chip, used by TagBubbleEditor (bubble tag pickers/displays across the app) -->
    <Style x:Key="TagBubbleBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TagBgBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="TagRemoveButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "+ тег" bubble that opens the inline add-row in TagBubbleEditor -->
    <Style x:Key="TagAddButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- Theme switch: single pill slider whose thumb contains a sun icon (light) or a moon
         icon (dark) — the icon swaps in place via IsChecked triggers instead of sitting next
         to the slider as separate text/graphics. -->
    <!-- Кружок выбора цвета акцента. Кнопка без фона и рамки: фоном служит сам кружок, а любая
         рамка вокруг него спорила бы с цветом, который она обрамляет. При наведении — светлое
         кольцо, чтобы было видно, что это кнопка, а не просто точка. -->
    <Style x:Key="AccentSwatchButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Ring" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="52" Height="26">
                        <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
                        <Grid x:Name="Thumb" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="{DynamicResource TextOnAccentBrush}"/>
                            <Canvas x:Name="SunIcon" Width="20" Height="20">
                                <Ellipse Canvas.Left="6" Canvas.Top="6" Width="8" Height="8" Fill="{DynamicResource WarningBrush}"/>
                                <Line X1="10" Y1="1.5" X2="10" Y2="3.5" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="10" Y1="16.5" X2="10" Y2="18.5" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="1.5" Y1="10" X2="3.5" Y2="10" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="16.5" Y1="10" X2="18.5" Y2="10" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="4.2" Y1="4.2" X2="5.6" Y2="5.6" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="14.4" Y1="14.4" X2="15.8" Y2="15.8" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="15.8" Y1="4.2" X2="14.4" Y2="5.6" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                <Line X1="5.6" Y1="14.4" X2="4.2" Y2="15.8" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                            </Canvas>
                            <Path x:Name="MoonIcon" Visibility="Collapsed" Fill="{DynamicResource AccentBrush}">
                                <Path.Data>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <CombinedGeometry.Geometry1>
                                            <EllipseGeometry Center="10,10" RadiusX="6" RadiusY="6"/>
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <EllipseGeometry Center="13,7" RadiusX="5.2" RadiusY="5.2"/>
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </Path.Data>
                            </Path>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="SunIcon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MoonIcon" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                         To="26" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search mode switch: three segments — "Прошивки" / "Параметры" / "Схемы" — laid over a
         single sliding thumb (ModeThumb in SearchView.xaml, animated in SearchView.xaml.cs) that
         glides between them, so each segment itself is just a transparent hit-target whose text
         flips to the on-accent color once the thumb sits underneath it. -->
    <Style x:Key="SearchModeSegment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Content ("Прошивки" etc.) is a plain string, so WPF wraps it in an ordinary TextBlock —
             which, like every other TextBlock in the app, picks up the app-wide implicit TextBlock
             style (Foreground=TextBrush) with HIGHER precedence than an inherited/attached
             TextElement.Foreground value set on an ancestor (ContentPresenter, here). Setting
             TextElement.Foreground in the ControlTemplate trigger below therefore never actually
             reached the text in light theme — dark TextBrush text sat directly on the blue thumb.
             Same fix as the sidebar nav list/Настройки button: an explicit per-instance Style on the
             actual TextBlock, with its own trigger, which DOES take precedence. -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=IsChecked}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed ScrollBar — replaces the default system chrome (white track/arrows regardless of
         app theme, same issue as ComboBox/ListBox above) with a thin flat pill thumb that only
         darkens on hover/drag. Applies app-wide since Styles.xaml has no key here. One template
         covers both orientations via the Orientation trigger, matching the classic WPF pattern
         (Track auto-orients itself and its two RepeatButtons from the ScrollBar it's hosted in). -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource TextMutedBrush}" CornerRadius="4" Opacity="0.4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb" Style="{StaticResource ScrollBarThumb}" Margin="2,0"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="ScrollThumb" Property="Margin" Value="0,2"/>
                            <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ПОЛОСА ПОД ОБОРУДОВАНИЕ: что именно работает, видно по самой полосе.
         Просьба Ильи 21.10.2026: «можно просто вентиль и что вода льётся из гидранта, качается,
         будто качают как через ручной насос и тп, то есть разных загрузок можно» и отдельно «для
         пожарных можно чтобы в оранжево-красный открывалось и заливалось и типа тушило пожар».
         Что меняется — выбирает Tag, его ставит окно загрузки по мотиву шкафа (LoaderDialog):
           pump  — вентиль крутится, по трубе идёт вода (насосная станция);
           hand  — рычаг ручного насоса качает, вода идёт толчками (КНС);
           heat  — труба греется, тепло пульсирует (тепловой пункт);
           valve — вентиль медленно открывается (шкаф задвижки);
           fire  — за водой видно пламя, и вода его ГАСИТ слева направо (пожарный шкаф).
         Без Tag — ровная полоса с вентилем: так она выглядит в строке состояния и там, где шкаф не
         опознан. Анимации заводятся от IsVisible и живут в шаблоне: отдельного кода на запуск и
         остановку нет, значит нечему и остаться включённым после скрытия полосы. -->
    <Style x:Key="FlowProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ЗНАК СЛЕВА. Все фигуры нарисованы сразу, показывается одна: смена
                             мотива — это смена Tag, без пересборки шаблона. -->
                        <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path x:Name="Wheel" Stretch="Uniform" Margin="1"
                                  Data="M8,1 A7,7 0 1,1 7.9,1 Z M8,8 L8,2.5 M8,8 L12.8,10.8 M8,8 L3.2,10.8"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Grid x:Name="HandPump" Visibility="Collapsed">
                                <Path Data="M7,15 L7,6 M4,15 L10,15 M7,8 L12,10"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                      Stretch="Uniform" Margin="1"/>
                                <Path x:Name="Lever" Data="M2,5 L11,3"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      Stretch="Uniform" Margin="1,1,1,9" RenderTransformOrigin="0.9,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

                            <Path x:Name="Flame" Visibility="Collapsed" Stretch="Uniform" Margin="2"
                                  Data="M8,1 C10,4 13,6 13,9.5 A5,5 0 0,1 3,9.5 C3,7 5,6 5.5,4 C6.5,5.5 8,6 8,6 C8,4.5 7,3 8,1 Z"
                                  Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,1">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleY="1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <!-- ТРУБА. Снизу — пламя (только у пожарных), поверх него вода-заливка,
                             поверх неё косые струи. Порядок важен: вода обязана ЗАКРЫВАТЬ пламя —
                             именно так и читается «тушит». -->
                        <Border Grid.Column="1" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCorner}" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>

                                <Canvas x:Name="Fire" Visibility="Collapsed" IsHitTestVisible="False"
                                        Height="12" VerticalAlignment="Center" Opacity="0.85">
                                    <Path Fill="{DynamicResource FireBrush}"
                                          Data="M0,12 C2,8 4,7 3,3 C5,5 6,5 7,2 C8,6 10,7 9,12 Z
                                                M14,12 C16,8 18,7 17,3 C19,5 20,5 21,2 C22,6 24,7 23,12 Z
                                                M28,12 C30,8 32,7 31,3 C33,5 34,5 35,2 C36,6 38,7 37,12 Z
                                                M42,12 C44,8 46,7 45,3 C47,5 48,5 49,2 C50,6 52,7 51,12 Z
                                                M56,12 C58,8 60,7 59,3 C61,5 62,5 63,2 C64,6 66,7 65,12 Z
                                                M70,12 C72,8 74,7 73,3 C75,5 76,5 77,2 C78,6 80,7 79,12 Z
                                                M84,12 C86,8 88,7 87,3 C89,5 90,5 91,2 C92,6 94,7 93,12 Z
                                                M98,12 C100,8 102,7 101,3 C103,5 104,5 105,2 C106,6 108,7 107,12 Z
                                                M112,12 C114,8 116,7 115,3 C117,5 118,5 119,2 C120,6 122,7 121,12 Z
                                                M126,12 C128,8 130,7 129,3 C131,5 132,5 133,2 C134,6 136,7 135,12 Z
                                                M140,12 C142,8 144,7 143,3 C145,5 146,5 147,2 C148,6 150,7 149,12 Z
                                                M154,12 C156,8 158,7 157,3 C159,5 160,5 161,2 C162,6 164,7 163,12 Z
                                                M168,12 C170,8 172,7 171,3 C173,5 174,5 175,2 C176,6 178,7 177,12 Z
                                                M182,12 C184,8 186,7 185,3 C187,5 188,5 189,2 C190,6 192,7 191,12 Z
                                                M196,12 C198,8 200,7 199,3 C201,5 202,5 203,2 C204,6 206,7 205,12 Z
                                                M210,12 C212,8 214,7 213,3 C215,5 216,5 217,2 C218,6 220,7 219,12 Z
                                                M224,12 C226,8 228,7 227,3 C229,5 230,5 231,2 C232,6 234,7 233,12 Z
                                                M238,12 C240,8 242,7 241,3 C243,5 244,5 245,2 C246,6 248,7 247,12 Z
                                                M252,12 C254,8 256,7 255,3 C257,5 258,5 259,2 C260,6 262,7 261,12 Z
                                                M266,12 C268,8 270,7 269,3 C271,5 272,5 273,2 C274,6 276,7 275,12 Z"/>
                                </Canvas>

                                <!-- Вода: заливка цветом мотива с лёгким переходом сверху вниз.
                                     Плоский прямоугольник читался как полоска краски, а не как
                                     жидкость в трубе. Прозрачность градиента одинаковая по всей
                                     высоте — меняется только светлота. -->
                                <!-- Заливка НЕПРОЗРАЧНАЯ: сквозь неё не должно просвечивать пламя,
                                     лежащее ниже. Именно на непрозрачности и держится «вода гасит
                                     огонь»: впереди воды пламя видно, позади — нет. -->
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"/>
                                <Rectangle x:Name="Gloss" HorizontalAlignment="Left" IsHitTestVisible="False"
                                           Width="{Binding ActualWidth, ElementName=PART_Indicator}">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#38FFFFFF"/>
                                            <GradientStop Offset="0.45" Color="#00FFFFFF"/>
                                            <GradientStop Offset="1" Color="#22000000"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Canvas x:Name="Jets" IsHitTestVisible="False" ClipToBounds="True"
                                        Height="12" VerticalAlignment="Center">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Canvas.RenderTransform>
                                    <!-- БЕЛЫЕ, а не цветом мотива: цветом они совпадали с заливкой и были видны только
                                         на пустой части трубы — то есть поток показывался ровно там, где воды ещё нет.
                                         Белые читаются внутри воды и почти не видны на светлом пустом участке, что и
                                         правильно: течёт — там, где налито. -->
                                    <Path Stroke="#FFFFFF" StrokeThickness="1.8" Opacity="0.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M1,2 L5,6 L1,10 M17,2 L21,6 L17,10 M33,2 L37,6 L33,10 M49,2 L53,6 L49,10 M65,2 L69,6 L65,10 M81,2 L85,6 L81,10 M97,2 L101,6 L97,10 M113,2 L117,6 L113,10 M129,2 L133,6 L129,10 M145,2 L149,6 L145,10 M161,2 L165,6 L161,10 M177,2 L181,6 L177,10 M193,2 L197,6 L193,10 M209,2 L213,6 L209,10 M225,2 L229,6 L225,10 M241,2 L245,6 L241,10 M257,2 L261,6 L257,10 M273,2 L277,6 L273,10 M289,2 L293,6 L289,10 M305,2 L309,6 L305,10"/>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Движение по умолчанию: вентиль крутится, вода идёт ровно. -->
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FlowRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Wheel"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1.4"/>
                                        <!-- Шаг струй — 12 пикселей: ровно период рисунка, поэтому
                                             на стыке цикла вода не дёргается. -->
                                        <DoubleAnimation Storyboard.TargetName="Jets"
                                                         Storyboard.TargetProperty="RenderTransform.X"
                                                         From="-16" To="0" Duration="0:0:0.75"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FlowRun"/>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- КНС: ручной насос. Вода идёт ТОЛЧКАМИ — в такт рычагу, а не ровной
                             струёй: именно это отличает «качают» от «течёт само». -->
                        <Trigger Property="Tag" Value="hand">
                            <Setter TargetName="Wheel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="HandPump" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HandRun">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Lever"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="-18" To="18" Duration="0:0:0.75"/>
                                        <DoubleAnimation Storyboard.TargetName="Jets"
                                                         Storyboard.TargetProperty="RenderTransform.X"
                                                         From="-16" To="0" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="HandRun"/>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Тепловой пункт: ничего не бежит, труба греется. -->
                        <Trigger Property="Tag" Value="heat">
                            <Setter TargetName="Jets" Property="Opacity" Value="0"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="HeatRun">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.55" To="1" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="HeatRun"/>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Задвижка: вентиль открывают медленно, четвертями оборота — как руками. -->
                        <Trigger Property="Tag" Value="valve">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ValveRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Wheel"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="90" Duration="0:0:1.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ValveRun"/>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- ПОЖАРНЫЙ ШКАФ: за водой горит, вода гасит. Пламя лежит ПОД заливкой и
                             по мере роста процента скрывается ею слева направо — тушение видно
                             само, без отдельной анимации «гашения». -->
                        <Trigger Property="Tag" Value="fire">
                            <Setter TargetName="Fire" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Wheel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Flame" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FireRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Flame"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         From="0.82" To="1.1" Duration="0:0:0.45" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="Fire"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.65" To="1" Duration="0:0:0.35" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="Jets"
                                                         Storyboard.TargetProperty="RenderTransform.X"
                                                         From="-16" To="0" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FireRun"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
