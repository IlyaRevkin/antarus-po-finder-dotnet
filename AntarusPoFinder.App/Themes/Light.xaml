<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Latte-based light palette — the standard light counterpart to the dark
         Mocha palette, same semantic keys so swapping this dictionary in retheming the whole app. -->

    <Color x:Key="BgColor">#EFF1F5</Color>
    <Color x:Key="BgSidebarColor">#E6E9EF</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgInputColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#BCC0CC</Color>
    <Color x:Key="AccentColor">#1E66F5</Color>
    <Color x:Key="AccentHoverColor">#3B7CF7</Color>
    <Color x:Key="TextColor">#4C4F69</Color>
    <Color x:Key="TextMutedColor">#6C6F85</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#40A02B</Color>
    <!-- Same green family as SuccessColor, but light enough to still read on top of AccentColor
         (#1E66F5) — see CopyableVersionText.Label_Click, which flashes this instead of SuccessBrush
         specifically when the click happened on an already-selected (accent-highlighted) grid row/
         list item. Borrowed from Dark.xaml's own SuccessColor, which was tuned for exactly this kind
         of "green on a saturated blue" contrast already. -->
    <Color x:Key="SuccessOnAccentColor">#A6E3A1</Color>
    <Color x:Key="WarningColor">#FE640B</Color>
    <Color x:Key="ErrorColor">#D20F39</Color>
    <Color x:Key="TagBgColor">#CCD0DA</Color>
    <Color x:Key="RolledBackColor">#B85C00</Color>
    <!-- Фон выделенной строки ListBox (Производители ПЧ/УПП и списки расширений в Настройки →
         Иерархия). Намеренно НЕ сплошной AccentColor (#1E66F5): текст строки — TextBlock, который
         ContentPresenter создаёт сам, и он берёт app-wide Foreground=TextBrush (тёмный), до него не
         достаёт ни локальный стиль ListBoxItem, ни его триггер выделения — на сплошном синем это
         давало нечитаемый тёмный текст на синем (жалоба пользователя). Светло-синий оттенок читается
         с тем же тёмным TextBrush (контраст #4C4F69 на #C4D4F7 ~ 7:1) и при этом ясно отличается от
         фона карточки и от ховера. -->
    <Color x:Key="ListSelectedBgColor">#C4D4F7</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessOnAccentBrush" Color="{StaticResource SuccessOnAccentColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <!-- Жёлтый — ТРЕТИЙ уровень критичности бага в прошивке (красный / оранжевый / жёлтый).
         Отдельный цвет, а не поблёкший WarningBrush: шкала из трёх ступеней читается только тогда,
         когда ступени различимы боком к боку в одном списке. -->
    <Color x:Key="CautionColor">#DF8E1D</Color>
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
    <SolidColorBrush x:Key="TagBgBrush" Color="{StaticResource TagBgColor}"/>
    <SolidColorBrush x:Key="RolledBackBrush" Color="{StaticResource RolledBackColor}"/>
    <SolidColorBrush x:Key="ListSelectedBgBrush" Color="{StaticResource ListSelectedBgColor}"/>


    <!-- ФОРМА ТЕМЫ, а не только цвет. Замечания Ильи: «Стекло нихер не стекло», «Материал нихера не
         материал» — и он прав: материал и стекло узнают по скруглениям, воздуху и тени, а не по
         палитре. Поэтому форму задаёт сама тема, а стили её читают (см. CardBorder в Styles.xaml).
         У светлой и тёмной значения прежние: рабочая версия не должна измениться ни на пиксель. -->
    <CornerRadius x:Key="CardCorner">8</CornerRadius>
    <Thickness x:Key="CardPadding">14</Thickness>
    <system:Double x:Key="CardShadowOpacity" xmlns:system="clr-namespace:System;assembly=System.Runtime">0</system:Double>

    <!-- Форма кнопок и пунктов меню. У material и стекла пункты — скруглённые «таблетки» без
         рамок: рамка вокруг каждой строки меню читается как сетка таблицы и спорит с заливкой
         активного пункта. У светлой и тёмной всё как было. -->
    <CornerRadius x:Key="NavCorner">6</CornerRadius>
    <Thickness x:Key="NavBorderThickness">1</Thickness>
    <!-- Фон НЕВЫБРАННОГО пункта меню. У material и стекла он прозрачный: белая плашка под каждой
         строкой превращает меню в список карточек и спорит с заливкой активного пункта — именно это
         и выглядело «не материалом». У светлой и тёмной — прежний цвет поля ввода. -->
    <SolidColorBrush x:Key="NavIdleBrush" Color="{StaticResource BgInputColor}"/>

    <!-- ФОРМА КНОПОК И ПОЛЕЙ. Скругление — то, по чему мобильный интерфейс узнают раньше, чем
         прочитают хоть слово: «таблетка» кнопки и мягкое поле ввода и есть разница между
         «настольной программой из 2010-го» и тем, как сегодня выглядят Material и Liquid Glass.
         Карточки и меню уже умели это (CardCorner/NavCorner), а кнопки, поля и списки оставались с
         вшитым в стиль радиусом 6 — из-за этого Материал и Стекло и читались как «та же программа,
         перекрашенная».
         У светлой и тёмной — прежняя шестёрка: рабочая версия не должна измениться ни на пиксель. -->
    <CornerRadius x:Key="ButtonCorner">6</CornerRadius>
    <CornerRadius x:Key="ControlCorner">6</CornerRadius>

    <!-- ПЛОТНОСТЬ БОКОВОГО МЕНЮ. Илья про переделанные настройки: «вот настройки сделал хорошо прям
         организацию пространства, переработай и левую панель к такому дизайну». В настройках
         разделы стоят столбиком плотно (padding 12,6, зазор 1), а в главном меню пункты были
         заметно разреженнее (12,10 и зазор 3) — рядом это читалось как два разных приложения.
         Значения задаёт ТЕМА: у светлой и тёмной прежние, у «Материала» и «Стекла» — как в
         настройках. Так плотность меняется только там, где и сам дизайн новый. -->
    <Thickness x:Key="NavItemPadding">12,10</Thickness>
    <Thickness x:Key="NavItemMargin">0,0,0,3</Thickness>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}"/>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
</ResourceDictionary>
