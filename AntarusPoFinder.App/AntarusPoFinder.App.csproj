<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AntarusPoFinder.Core\AntarusPoFinder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (system tray icon — see MainWindow "Системный трей") is WinForms-only; WPF and
         WinForms coexist fine in the same net8.0-windows project. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Bump on every release published to the update share — drives Настройки → Общие → Обновление приложения. -->
    <Version>1.75.2.1</Version>
  </PropertyGroup>

  <!-- БЕТА — ОТДЕЛЬНОЕ ПРИЛОЖЕНИЕ, А НЕ РЕЖИМ.
       Собирается как `dotnet publish -c Beta`, ставится рядом со стабильным, со своей папкой,
       своим ярлыком и своим профилем в %LocalAppData% (Core/Domain/AppIdentity). Смысл ровно в
       этом: «если там что-то не то, то работники смогли бы пользоваться предыдущей версией без
       необходимости переустановки».
       Константа компиляции, а не настройка: настройка уехала бы на чужую машину с общим конфигом,
       и рабочая программа начала бы считать себя бетой. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
    <Version>2.0.0.5</Version>
    <!-- ⚠️ AssemblyName НЕ меняем. Разметка ссылается на ресурсы pack-URI с именем сборки
         («/AntarusPoFinder.App;component/Themes/…» в ThemeManager, значки окон в диалогах), и
         переименование сборки ломает их загрузку: бета падала при построении главного окна с
         FileNotFoundException на собственной сборке. Отличают бету имя продукта, папка установки,
         ярлык, UpgradeCode и профиль — всё это задаётся установщиком (installer/build.ps1), а имя
         файла exe переименовывается при сборке. Внутреннее имя сборки для этого не нужно вовсе. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms=true (above) auto-adds implicit "global using"s for System.Windows.Forms AND
         System.Drawing alongside WPF's own implicit "global using System.Windows;" (ImplicitUsings=
         enable) — a lot of WinForms/GDI+ type names collide with WPF ones (Application, Button,
         TextBox, CheckBox, UserControl, KeyEventArgs, DragEventArgs, Brush(es), Point...), which
         broke compilation in every WPF view file with CS0104 ambiguous-reference errors, even ones
         that never mention WinForms/GDI+. Only MainWindow.xaml.cs actually needs System.Windows.Forms
         (for the NotifyIcon tray icon), and it already fully-qualifies every type it uses from there
         — so neither global using is needed anywhere and both are removed here. Existing
         System.Drawing.* usages elsewhere (WiaScanner etc.) already have their own explicit
         "using System.Drawing;" in-file, unaffected by removing the *global* one. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

