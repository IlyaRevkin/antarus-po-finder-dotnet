# Скопировать в tools/inbox/.env и заполнить. Настоящий .env в гит не попадает.

NC_URL=https://cloud.rev-il.ru
NC_ROOT=Antarus

# Способ 1 (основной): личный доступ по паролю приложения. Даёт агенту и чтение, и запись.
# Пароль берётся в Nextcloud: аватар -> Личные настройки -> Безопасность ->
# «Устройства и сеансы» -> Имя приложения: antarus-agent -> «Создать новый пароль приложения».
# Показывается один раз, копировать сразу. Отзывается там же одной кнопкой.
NC_USER=
NC_PASS=

# Способ 2 (если не хочется давать доступ ко всему облаку): публичная ссылка на одну папку.
# В Nextcloud: правой кнопкой по папке -> «Поделиться» -> «Ссылка для доступа»,
# разрешить «Разрешить редактирование», если нужно, чтобы агент мог писать в ответ.
# Токен — это хвост ссылки после /s/ : https://cloud.rev-il.ru/s/XXXXXXXXXXXX
# Если заполнено, используется вместо NC_USER/NC_PASS.
NC_SHARE=
NC_SHARE_PASS=
